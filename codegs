function getPatientStatistics(
  token
) {

  requireSession_(token);


  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  const result = {

    total: 0,

    aktif: 0,

    nonaktif: 0,

    perempuan: 0,

    lakiLaki: 0,

    baruBulanIni: 0

  };


  if (values.length < 2) {
    return result;
  }


  const map =
    getHeaderMap_(sheet);


  const now =
    new Date();


  const currentMonth =
    Utilities.formatDate(
      now,
      PMB_CONFIG.TIMEZONE ||
        'Asia/Jakarta',
      'yyyy-MM'
    );


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    result.total++;


    const status =
      String(
        values[i][
          map.STATUS
        ] || ''
      ).toUpperCase();


    if (
      status === 'AKTIF'
    ) {

      result.aktif++;

    }


    if (
      status === 'NONAKTIF'
    ) {

      result.nonaktif++;

    }


    const gender =
      String(
        values[i][
          map.JENIS_KELAMIN
        ] || ''
      ).toUpperCase();


    if (
      gender === 'PEREMPUAN' ||
      gender === 'P'
    ) {

      result.perempuan++;

    }


    if (
      gender === 'LAKI-LAKI' ||
      gender === 'LAKI LAKI' ||
      gender === 'L'
    ) {

      result.lakiLaki++;

    }


    const created =
      formatDate_(
        values[i][
          map.CREATED_AT
        ]
      );


    if (
      created &&
      created.substring(0, 7) ===
        currentMonth
    ) {

      result.baruBulanIni++;

    }

  }


  return result;

}


