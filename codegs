        pasienMap.NAMA_LENGKAP !== undefined
          ? String(
              row[
                pasienMap.NAMA_LENGKAP
              ] || ''
            ).trim()
          : '';


      const pasienData = {

        pasienId:
          pasienId,

        noRM:
          noRM,

        nama:
          nama

      };


      if (
        pasienId
      ) {

        pasienById[
          pasienId
        ] =
          pasienData;

      }


      if (
        noRM
      ) {

        pasienByRM[
          noRM
        ] =
          pasienData;

      }

    }

  }


  /* ===================================================
     MAP KUNJUNGAN BERDASARKAN KUNJUNGAN_ID
     =================================================== */

  const kunjunganById =
    {};


  if (
    kunjunganValues.length > 1
  ) {

    for (
      let i = 1;
      i < kunjunganValues.length;
      i++
    ) {

      const row =
        kunjunganValues[i];


      if (
        kunjunganMap.KUNJUNGAN_ID === undefined
      ) {

        continue;

      }


      const kunjunganId =
        String(
          row[
            kunjunganMap.KUNJUNGAN_ID
          ] || ''
        ).trim();


      if (
        !kunjunganId
      ) {

        continue;

      }


      kunjunganById[
        kunjunganId
      ] =
        row;

    }

  }


  /* ===================================================
     HASIL
     =================================================== */

  const result =
    [];


  /* ===================================================
     LOOP ANTRIAN
     =================================================== */

  for (
    let i = 1;
    i < antrianValues.length;
    i++
  ) {

    const row =
      antrianValues[i];


    /* -----------------------------------------------
       STATUS
       ----------------------------------------------- */

    const status =
      antrianMap.STATUS !== undefined
        ? String(
            row[
              antrianMap.STATUS
            ] || ''
          )
            .trim()
            .toUpperCase()
        : '';


    /*
     * HANYA PASIEN YANG SEDANG DILAYANI
     */

    if (
      status !== 'DILAYANI'
    ) {

      continue;

    }


    /* -----------------------------------------------
       ANTRIAN ID
       ----------------------------------------------- */

    const antrianId =
      antrianMap.ANTRIAN_ID !== undefined
        ? String(
            row[
              antrianMap.ANTRIAN_ID
            ] || ''
          ).trim()
        : '';


    /* -----------------------------------------------
       NOMOR ANTRIAN
       ----------------------------------------------- */

    const nomorAntrian =
      antrianMap.NOMOR_ANTRIAN !== undefined
        ? String(
            row[
              antrianMap.NOMOR_ANTRIAN
            ] || ''
          ).trim()
        : '';


    /* -----------------------------------------------
       KUNJUNGAN ID
       ----------------------------------------------- */

    const kunjunganId =
      antrianMap.KUNJUNGAN_ID !== undefined
        ? String(
            row[
              antrianMap.KUNJUNGAN_ID
            ] || ''
          ).trim()
        : '';


    /* -----------------------------------------------
       NO RM
       ----------------------------------------------- */

    const noRM =
      antrianMap.NO_RM !== undefined
        ? String(
            row[
              antrianMap.NO_RM
            ] || ''
          ).trim()
        : '';


    /* -----------------------------------------------
       PASIEN ID
       ----------------------------------------------- */

    const pasienId =
      antrianMap.PASIEN_ID !== undefined
        ? String(
            row[
              antrianMap.PASIEN_ID
            ] || ''
          ).trim()
        : '';


    /* =================================================
       CARI PASIEN
       ================================================= */

    let pasien =
      null;


    /*
     * PRIORITAS 1:
     * Cari menggunakan PASIEN_ID
     */

    if (
      pasienId &&
      pasienById[
        pasienId
      ]
    ) {

      pasien =
        pasienById[
          pasienId
        ];

    }


    /*
     * PRIORITAS 2:
     * Cari menggunakan NO_RM
     */

    if (
      !pasien &&
      noRM &&
      pasienByRM[
        noRM
      ]
    ) {

      pasien =
        pasienByRM[
          noRM
        ];

    }


    /* =================================================
       NAMA PASIEN
       ================================================= */

    let namaPasien =
      pasien
        ? pasien.nama
        : '';


    /*
     * FALLBACK:
     * jika ANTRIAN ternyata memiliki
     * NAMA_PASIEN
     */

    if (
      !namaPasien &&
      antrianMap.NAMA_PASIEN !== undefined
    ) {

      namaPasien =
        String(
          row[
            antrianMap.NAMA_PASIEN
          ] || ''
        ).trim();

    }


    /* =================================================
       CARI KUNJUNGAN
       ================================================= */

    const kunjungan =
      kunjunganById[
        kunjunganId
      ] || null;


    /* =================================================
       JENIS PELAYANAN
       ================================================= */

    let jenisPelayanan =
      '';


    if (
      kunjungan
    ) {

      /*
       * PRIORITAS:
       * JENIS_PELAYANAN
       */

      if (
        kunjunganMap.JENIS_PELAYANAN !== undefined
      ) {

        jenisPelayanan =
          String(
            kunjungan[
              kunjunganMap.JENIS_PELAYANAN
            ] || ''
          ).trim();

      }


      /*
       * FALLBACK:
       * JENIS_LAYANAN
       */

      if (
        !jenisPelayanan &&
        kunjunganMap.JENIS_LAYANAN !== undefined
      ) {

        jenisPelayanan =
          String(
            kunjungan[
              kunjunganMap.JENIS_LAYANAN
            ] || ''
          ).trim();

      }

    }


    /*
     * FALLBACK DARI ANTRIAN
     */

    if (
      !jenisPelayanan &&
      antrianMap.JENIS_PELAYANAN !== undefined
    ) {

      jenisPelayanan =
        String(
          row[
            antrianMap.JENIS_PELAYANAN
          ] || ''
        ).trim();

    }


    /*
     * FALLBACK JENIS_LAYANAN
     */

    if (
      !jenisPelayanan &&
      antrianMap.JENIS_LAYANAN !== undefined
    ) {

      jenisPelayanan =
        String(
          row[
            antrianMap.JENIS_LAYANAN
          ] || ''
        ).trim();

    }


    /* =================================================
       MASUKKAN KE HASIL
       ================================================= */

    result.push({

      antrianId:
        antrianId,


      nomorAntrian:
        nomorAntrian,


      kunjunganId:
        kunjunganId,


      noRM:
        noRM,


      pasienId:
        pasienId,


      /*
       * NAMA PASIEN
       */
      namaPasien:
