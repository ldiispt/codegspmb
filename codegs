/**
 * =====================================================
 * GET DAFTAR RESEP FARMASI
 *
 * Default:
 * hanya resep MENUNGGU dan DIPROSES.
 *
 * Jika status dikirim:
 * gunakan status tersebut.
 * =====================================================
 */
function getPharmacyPrescriptions(
  token,
  search,
  status
) {

  requireSession_(token);

  search =
    String(search || '')
      .trim()
      .toLowerCase();

  status =
    String(status || '')
      .trim()
      .toUpperCase();


  const resepSheet =
    getSheetByConfig('RESEP');

  const detailSheet =
    getSheetByConfig('RESEP_DETAIL');

  const pasienSheet =
    getSheetByConfig('PASIEN');


  const resepValues =
    resepSheet
      .getDataRange()
      .getValues();

  const detailValues =
    detailSheet
      .getDataRange()
      .getValues();

  const pasienValues =
    pasienSheet
      .getDataRange()
      .getValues();


  if (
    resepValues.length < 2
  ) {

    return {
      total: 0,
      data: []
    };

  }


  const resepMap =
    getHeaderMap_(resepSheet);

  const detailMap =
    getHeaderMap_(detailSheet);

  const pasienMap =
    getHeaderMap_(pasienSheet);


  /*
   * ---------------------------------------------------
   * INDEX PASIEN
   * ---------------------------------------------------
   */

  const patientByRM = {};


  for (
    let i = 1;
    i < pasienValues.length;
    i++
  ) {

    const row =
      pasienValues[i];

    const noRM =
      pasienMap.NO_RM !== undefined
        ? String(
            row[
              pasienMap.NO_RM
            ] || ''
          ).trim()
        : '';

    if (!noRM) {
      continue;
    }


    patientByRM[noRM] = {

      pasienId:
        pasienMap.PASIEN_ID !== undefined
          ? String(
              row[
                pasienMap.PASIEN_ID
              ] || ''
            ).trim()
          : '',

      noRM:
        noRM,

      nama:
        pasienMap.NAMA_LENGKAP !== undefined
          ? String(
              row[
                pasienMap.NAMA_LENGKAP
              ] || ''
            ).trim()
          : ''

    };

  }


  /*
   * ---------------------------------------------------
   * HITUNG DETAIL OBAT
   * ---------------------------------------------------
   */

  const detailsByResep = {};


  for (
    let i = 1;
    i < detailValues.length;
    i++
  ) {

    const row =
      detailValues[i];

    const resepId =
      detailMap.RESEP_ID !== undefined
        ? String(
            row[
              detailMap.RESEP_ID
            ] || ''
          ).trim()
        : '';

    if (!resepId) {
      continue;
    }


    if (
      !detailsByResep[
        resepId
      ]
    ) {

      detailsByResep[
        resepId
      ] = [];

    }


    detailsByResep[
      resepId
    ].push({

      obatId:
        detailMap.OBAT_ID !== undefined
          ? String(
              row[
                detailMap.OBAT_ID
              ] || ''
            ).trim()
          : '',

      namaObat:
        detailMap.NAMA_OBAT !== undefined
          ? String(
              row[
                detailMap.NAMA_OBAT
              ] || ''
            ).trim()
          : '',

      jumlah:
        detailMap.JUMLAH !== undefined
          ? Number(
              row[
                detailMap.JUMLAH
              ] || 0
            )
          : 0,

      satuan:
        detailMap.SATUAN !== undefined
          ? String(
              row[
                detailMap.SATUAN
              ] || ''
            ).trim()
          : ''

    });

  }


  const result = [];


  /*
   * ---------------------------------------------------
   * RESEP
   * ---------------------------------------------------
   */

  for (
    let i = 1;
    i < resepValues.length;
    i++
  ) {

    const row =
      resepValues[i];

    const resepId =
      String(
        row[
          resepMap.RESEP_ID
        ] || ''
      ).trim();

    if (!resepId) {
      continue;
    }


    const resepStatus =
      String(
        row[
          resepMap.STATUS
        ] || 'MENUNGGU'
      )
        .trim()
        .toUpperCase();


    /*
     * Default Farmasi:
     * MENUNGGU + DIPROSES
     */

    if (
      !status &&
      [
        'MENUNGGU',
        'DIPROSES'
      ].indexOf(
        resepStatus
      ) === -1
    ) {

      continue;

    }


    if (
      status &&
      resepStatus !== status
    ) {

      continue;

    }


    const noRM =
      String(
        row[
          resepMap.NO_RM
        ] || ''
      ).trim();


    const kunjunganId =
      String(
        row[
          resepMap.KUNJUNGAN_ID
        ] || ''
      ).trim();


    const pasien =
      patientByRM[
        noRM
      ] || null;


    const namaPasien =
      pasien
        ? pasien.nama
        : '';


    const dokterBidan =
      String(
        row[
          resepMap.DOKTER_BIDAN
        ] || ''
      ).trim();


    const searchableText = [

      resepId,
      kunjunganId,
      noRM,
      namaPasien,
      dokterBidan

    ]
      .join(' ')
      .toLowerCase();


    if (
      search &&
      searchableText.indexOf(
        search
      ) === -1
    ) {

      continue;

    }


    const details =
      detailsByResep[
        resepId
      ] || [];


    let totalItem = 0;


    details.forEach(
      function(item) {

        totalItem +=
          Number(
            item.jumlah || 0
          );

      }
    );


    result.push({

      resepId:
        resepId,

      kunjunganId:
        kunjunganId,

      pasienId:
        pasien
          ? pasien.pasienId
          : '',

      noRM:
        noRM,

      namaPasien:
        namaPasien,

      tanggal:
        formatDate_(
          row[
            resepMap.TANGGAL
          ]
        ),

      dokterBidan:
        dokterBidan,

      status:
        resepStatus,

      jumlahJenisObat:
        details.length,

      totalItem:
        totalItem

    });

  }


  result.reverse();


  return {

    total:
      result.length,

    data:
      result

  };

}


/**
 * =====================================================
 * GET DETAIL RESEP UNTUK FARMASI
 *
 * Sekaligus mengambil stok TERKINI.
 * =====================================================
 */
function getPharmacyPrescriptionDetail(
  token,
  resepId
) {

  requireSession_(token);

  resepId =
    String(
      resepId || ''
    ).trim();


  if (!resepId) {

    throw new Error(
      'ID resep tidak ditemukan.'
    );

  }


  const resep =
    getPrescription(
      token,
      resepId
    );


  const obatSheet =
    getSheetByConfig('OBAT');


  const obatValues =
    obatSheet
      .getDataRange()
      .getValues();


  const obatMap =
    getHeaderMap_(obatSheet);


  const obatById = {};


  for (
    let i = 1;
    i < obatValues.length;
    i++
  ) {

    const row =
      obatValues[i];

    const obatId =
      String(
        row[
          obatMap.OBAT_ID
        ] || ''
      ).trim();


    if (!obatId) {
      continue;
    }


    obatById[
      obatId
    ] = {

      obatId:
        obatId,

      kodeObat:
        String(
          row[
            obatMap.KODE_OBAT
          ] || ''
        ).trim(),

      namaObat:
        String(
          row[
            obatMap.NAMA_OBAT
          ] || ''
        ).trim(),

      satuan:
        String(
          row[
            obatMap.SATUAN
          ] || ''
        ).trim(),

      stok:
        Number(
          row[
            obatMap.STOK
          ] || 0
        ),

      harga:
        Number(
          row[
            obatMap.HARGA_JUAL
          ] || 0
        ),

      status:
        String(
          row[
            obatMap.STATUS
          ] || ''
        )
          .trim()
          .toUpperCase(),

      rowNumber:
        i + 1

    };

  }


  const items = [];


  let semuaStokCukup =
    true;


  resep.detail.forEach(
    function(detail) {

      const obat =
        obatById[
          String(
            detail.obatId
          ).trim()
        ];


      if (!obat) {

        semuaStokCukup =
          false;


        items.push({

          obatId:
            detail.obatId,

          kodeObat:
            detail.kodeObat,

          namaObat:
            detail.namaObat,

          jumlah:
            Number(
              detail.jumlah || 0
            ),

          satuan:
            detail.satuan,

          stok:
            0,

          stokCukup:
            false,

          status:
            'TIDAK_DITEMUKAN'

        });

        return;

      }


      const jumlah =
        Number(
          detail.jumlah || 0
        );


      const stokCukup =
        obat.status ===
          'AKTIF' &&
        obat.stok >= jumlah;


      if (!stokCukup) {

        semuaStokCukup =
          false;

      }


      items.push({

        obatId:
          obat.obatId,

        kodeObat:
          obat.kodeObat,

        namaObat:
          obat.namaObat,

        jumlah:
          jumlah,

        satuan:
          obat.satuan,

        dosis:
          detail.dosis || '',

        aturanPakai:
          detail.aturanPakai || '',

        catatan:
          detail.catatan || '',

        harga:
          detail.harga || 0,

        subtotal:
          detail.subtotal || 0,

        stok:
          obat.stok,

        stokCukup:
          stokCukup,

        status:
          obat.status

      });

    }
  );


  return {

    resepId:
      resep.resepId,

    kunjunganId:
      resep.kunjunganId,

    noRM:
      resep.noRM,

    namaPasien:
      resep.namaPasien,

    tanggal:
      resep.tanggal,

    dokterBidan:
      resep.dokterBidan,

    status:
      resep.status,

    catatan:
      resep.catatan,

    semuaStokCukup:
      semuaStokCukup,

    items:
      items

  };

}


/**
 * =====================================================
 * PROSES RESEP FARMASI
 *
 * ATURAN:
 *
 * 1. Hanya MENUNGGU / DIPROSES
 * 2. LockService
 * 3. Baca stok TERBARU
 * 4. Validasi SEMUA obat
 * 5. Jika satu saja kurang:
 *       TIDAK ADA stok yang dikurangi
 * 6. Jika semua cukup:
 *       kurangi semua stok
 * 7. Status resep = SELESAI
 *
 * Tidak boleh ada stok negatif.
 * =====================================================
 */
function processPrescription(
  token,
  resepId
) {

  const session =
    requireSession_(token);


  resepId =
    String(
      resepId || ''
    ).trim();


  if (!resepId) {

    throw new Error(
      'ID resep tidak ditemukan.'
    );

  }


  const lock =
    LockService.getScriptLock();


  lock.waitLock(30000);


  try {

    /*
     * -------------------------------------------------
     * BACA RESEP
     * -------------------------------------------------
     */

    const resepSheet =
      getSheetByConfig('RESEP');

    const detailSheet =
      getSheetByConfig('RESEP_DETAIL');

    const obatSheet =
      getSheetByConfig('OBAT');


    const resepValues =
      resepSheet
        .getDataRange()
        .getValues();

    const detailValues =
      detailSheet
        .getDataRange()
        .getValues();

    const obatValues =
      obatSheet
        .getDataRange()
        .getValues();


    const resepMap =
      getHeaderMap_(resepSheet);

    const detailMap =
      getHeaderMap_(detailSheet);

    const obatMap =
      getHeaderMap_(obatSheet);


    /*
     * -------------------------------------------------
     * CARI RESEP
     * -------------------------------------------------
     */

    let resepRowNumber =
      -1;

    let resepRow =
      null;


    for (
      let i = 1;
      i < resepValues.length;
      i++
    ) {

      const id =
        String(
          resepValues[i][
            resepMap.RESEP_ID
          ] || ''
        ).trim();


      if (
        id === resepId
      ) {

        resepRowNumber =
          i + 1;

        resepRow =
          resepValues[i];

        break;

      }

    }


    if (
      resepRowNumber === -1
    ) {

      throw new Error(
        'Resep tidak ditemukan.'
      );

    }


    const currentStatus =
      String(
        resepRow[
          resepMap.STATUS
        ] || ''
      )
        .trim()
        .toUpperCase();


    /*
     * Resep yang sudah selesai
     * tidak boleh diproses ulang.
     */

    if (
      currentStatus ===
      'SELESAI'
    ) {

      throw new Error(
        'Resep sudah selesai diproses.'
      );

    }


    if (
      currentStatus ===
      'BATAL'
    ) {

      throw new Error(
        'Resep sudah dibatalkan.'
      );

    }


    if (
      [
        'MENUNGGU',
        'DIPROSES'
      ].indexOf(
        currentStatus
      ) === -1
    ) {

      throw new Error(
        'Status resep tidak dapat diproses: ' +
        currentStatus
      );

    }


    /*
     * -------------------------------------------------
     * AMBIL DETAIL
     * -------------------------------------------------
     */

    const details = [];


    for (
      let i = 1;
      i < detailValues.length;
      i++
    ) {

      const row =
        detailValues[i];


      const id =
        String(
          row[
            detailMap.RESEP_ID
          ] || ''
        ).trim();


      if (
        id !== resepId
      ) {

        continue;

      }


      const obatId =
        String(
          row[
            detailMap.OBAT_ID
          ] || ''
        ).trim();


      const jumlah =
        Number(
          row[
            detailMap.JUMLAH
          ] || 0
        );


      if (!obatId) {

        throw new Error(
          'Ada detail resep tanpa OBAT_ID.'
        );

      }


      if (
        !isFinite(jumlah) ||
        jumlah <= 0
      ) {

        throw new Error(
          'Jumlah obat pada resep tidak valid.'
        );

      }


      details.push({

        obatId:
          obatId,

        jumlah:
          jumlah,

        namaObat:
          String(
            row[
              detailMap.NAMA_OBAT
            ] || ''
          ).trim()

      });

    }


    if (
      details.length === 0
    ) {

      throw new Error(
        'Resep tidak memiliki detail obat.'
      );

    }


    /*
     * -------------------------------------------------
     * INDEX STOK TERBARU
     * -------------------------------------------------
     */

    const obatById = {};


    for (
      let i = 1;
      i < obatValues.length;
      i++
    ) {

      const row =
        obatValues[i];


      const obatId =
        String(
          row[
            obatMap.OBAT_ID
          ] || ''
        ).trim();


      if (!obatId) {
        continue;
      }


      obatById[
        obatId
      ] = {

        obatId:
          obatId,

        namaObat:
          String(
            row[
              obatMap.NAMA_OBAT
            ] || ''
          ).trim(),

        stok:
          Number(
            row[
              obatMap.STOK
            ] || 0
          ),

        status:
          String(
            row[
              obatMap.STATUS
            ] || ''
          )
            .trim()
            .toUpperCase(),

        rowNumber:
          i + 1

      };

    }


    /*
     * -------------------------------------------------
     * VALIDASI SEMUA STOK
     *
     * BELUM ADA PERUBAHAN STOK
     * -------------------------------------------------
     */

    const stockChanges = [];


    details.forEach(
      function(detail) {

        const obat =
          obatById[
            detail.obatId
          ];


        if (!obat) {

          throw new Error(
            'Obat "' +
            detail.obatId +
            '" tidak ditemukan.'
          );

        }


        if (
          obat.status !==
          'AKTIF'
        ) {

          throw new Error(
            'Obat "' +
            obat.namaObat +
            '" sudah tidak aktif.'
          );

        }


        if (
          obat.stok < 0
        ) {

          throw new Error(
            'Stok "' +
            obat.namaObat +
            '" sudah tidak valid.'
          );

        }


        const jumlah =
          Number(
            detail.jumlah
          );


        if (
          obat.stok <
          jumlah
        ) {

          throw new Error(
            'Stok ' +
            obat.namaObat +
            ' tidak mencukupi. ' +
            'Stok tersedia: ' +
            obat.stok +
            ', diperlukan: ' +
            jumlah
          );

        }


        stockChanges.push({

          obatId:
            obat.obatId,

          namaObat:
            obat.namaObat,

          rowNumber:
            obat.rowNumber,

          stokSebelum:
            obat.stok,

          jumlah:
            jumlah,

          stokSesudah:
            obat.stok -
            jumlah

        });

      }
    );


    /*
     * -------------------------------------------------
     * SEMUA STOK VALID
     *
     * SEKARANG BARU KURANGI STOK
     * -------------------------------------------------
     */

    stockChanges.forEach(
      function(change) {

        obatSheet
          .getRange(
            change.rowNumber,
            obatMap.STOK + 1
          )
          .setValue(
            change.stokSesudah
          );


        if (
          obatMap.UPDATED_AT !==
          undefined
        ) {

          obatSheet
            .getRange(
              change.rowNumber,
              obatMap.UPDATED_AT + 1
            )
            .setValue(
              new Date()
            );

        }

      }
    );


    /*
     * -------------------------------------------------
     * STATUS RESEP
     * -------------------------------------------------
     */

    resepSheet
      .getRange(
        resepRowNumber,
        resepMap.STATUS + 1
      )
      .setValue(
        'SELESAI'
      );


    if (
      resepMap.UPDATED_AT !==
      undefined
    ) {

      resepSheet
        .getRange(
          resepRowNumber,
          resepMap.UPDATED_AT + 1
        )
        .setValue(
          new Date()
        );

    }


    /*
     * -------------------------------------------------
     * AUDIT RESEP
     * -------------------------------------------------
     */

    writeAuditLog_(
      session.userId,
      session.username,
      'PROSES_RESEP',
      'RESEP',
      resepId,
      'Resep selesai diproses. ' +
      'Jumlah jenis obat: ' +
      stockChanges.length
    );


    /*
     * -------------------------------------------------
     * AUDIT STOK
     * -------------------------------------------------
     *
     * Jika sistem belum mempunyai
     * sheet STOK_LOG, bagian ini
     * cukup menggunakan AUDIT_LOG.
     * -------------------------------------------------
     */

    stockChanges.forEach(
      function(change) {

        writeAuditLog_(
          session.userId,
          session.username,
          'STOK_KELUAR',
          'OBAT',
          change.obatId,
          'Resep ' +
          resepId +
          ': ' +
          change.namaObat +
          ' ' +
          change.stokSebelum +
          ' -> ' +
          change.stokSesudah +
          ' (keluar ' +
          change.jumlah +
          ')'
        );

      }
    );


    return {

      success:
        true,

      resepId:
        resepId,

      status:
        'SELESAI',

      changes:
        stockChanges

    };


  } finally {

    lock.releaseLock();

  }

}
