/* =====================================================
   GET ANTRIAN HARI INI
   ===================================================== */

function getTodayQueue(token) {

  requireSession_(token);

  const antrianSheet = getSheetByConfig('ANTRIAN');
  const pasienSheet = getSheetByConfig('PASIEN');

  const antrianValues =
    antrianSheet.getDataRange().getValues();

  const pasienValues =
    pasienSheet.getDataRange().getValues();

  if (antrianValues.length < 2) {
    return [];
  }

  const antrianMap =
    getHeaderMap_(antrianSheet);

  const pasienMap =
    getHeaderMap_(pasienSheet);

  const today = getTodayString_();

  /* INDEX PASIEN BERDASARKAN NO RM */
  const pasienByRM = {};

  for (let i = 1; i < pasienValues.length; i++) {

    const noRM = String(
      pasienValues[i][pasienMap.NO_RM] || ''
    ).trim();

    if (!noRM) continue;

    pasienByRM[noRM] = {
      pasienId:
        pasienMap.PASIEN_ID !== undefined
          ? String(
              pasienValues[i][pasienMap.PASIEN_ID] || ''
            )
          : '',

      nama:
        pasienMap.NAMA_LENGKAP !== undefined
          ? String(
              pasienValues[i][pasienMap.NAMA_LENGKAP] || ''
            )
          : ''
    };
  }

  const result = [];

  for (let i = 1; i < antrianValues.length; i++) {

    const dateValue = formatDate_(
      antrianValues[i][antrianMap.TANGGAL]
    );

    if (
      !dateValue ||
      dateValue.substring(0, 10) !== today
    ) {
      continue;
    }

    const noRM = String(
      antrianValues[i][antrianMap.NO_RM] || ''
    ).trim();

    const pasien = pasienByRM[noRM] || {};

    result.push({

      antrianId:
        antrianValues[i][antrianMap.ANTRIAN_ID] || '',

      nomorAntrian:
        antrianValues[i][antrianMap.NOMOR_ANTRIAN] || '',

      kunjunganId:
        antrianValues[i][antrianMap.KUNJUNGAN_ID] || '',

      noRM: noRM,

      pasienId:
        pasien.pasienId || '',

      nama:
        pasien.nama || '',

      jenisPelayanan:
        antrianValues[i][antrianMap.JENIS_LAYANAN] || '',

      status:
        antrianValues[i][antrianMap.STATUS] || '',

      waktuPanggil:
        antrianMap.WAKTU_PANGGIL !== undefined
          ? formatDateTime_(
              antrianValues[i][antrianMap.WAKTU_PANGGIL]
            )
          : '',

      waktuSelesai:
        antrianMap.WAKTU_SELESAI !== undefined
          ? formatDateTime_(
              antrianValues[i][antrianMap.WAKTU_SELESAI]
            )
          : '',

      _rowNumber: i + 1
    });
  }

  return result;
}

/* =====================================================
   FORMAT DATETIME
   ===================================================== */

function formatDateTime_(
  value
) {

  if (!value) {
    return '';
  }


  if (
    Object.prototype.toString.call(value) ===
      '[object Date]'
  ) {

    return Utilities.formatDate(
      value,
      PMB_CONFIG.TIMEZONE ||
        'Asia/Jakarta',
      'dd/MM/yyyy HH:mm:ss'
    );

  }


  return String(value);

}


/* =====================================================
   UPDATE STATUS ANTRIAN
   ===================================================== */

function updateQueueStatus(
  token,
  antrianId,
  status
) {

  const session =
    requireSession_(token);


  antrianId =
    String(
      antrianId || ''
    ).trim();


  status =
    String(
      status || ''
    )
      .trim()
      .toUpperCase();


  const allowed = [

    'MENUNGGU',

    'DIPANGGIL',

    'DILAYANI',

    'SELESAI',

    'BATAL'

  ];


  if (
    allowed.indexOf(status) === -1
  ) {

    throw new Error(
      'Status antrian tidak valid.'
    );

  }


  const sheet =
    getSheetByConfig(
      'ANTRIAN'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {

    throw new Error(
      'Data antrian belum tersedia.'
    );

  }


  const map =
    getHeaderMap_(sheet);


  let rowNumber = -1;

  let queue = null;


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.ANTRIAN_ID
        ] || ''
      ) ===
      antrianId
    ) {

      rowNumber =
        i + 1;


      queue = {

        nomorAntrian:
          values[i][
            map.NOMOR_ANTRIAN
          ] || '',

        noRM:
          values[i][
            map.NO_RM
          ] || '',

        nama:
          values[i][
            map.NAMA_PASIEN
          ] || '',

        status:
          values[i][
            map.STATUS
          ] || ''

      };


      break;

    }

  }


  if (rowNumber === -1) {

    throw new Error(
      'Data antrian tidak ditemukan.'
    );

  }


  const currentStatus =
    String(
      queue.status || ''
    ).toUpperCase();


  if (
    status === 'DILAYANI' &&
    currentStatus !== 'DIPANGGIL'
  ) {

    throw new Error(
      'Pasien harus dipanggil terlebih dahulu.'
    );

  }


  if (
    status === 'SELESAI' &&
    currentStatus !== 'DILAYANI'
  ) {

    throw new Error(
      'Pasien harus berstatus DILAYANI.'
    );

  }


  if (
    status === 'BATAL' &&
    (
      currentStatus ===
        'SELESAI' ||
      currentStatus ===
        'BATAL'
    )
  ) {

    throw new Error(
      'Antrian sudah selesai atau dibatalkan.'
    );

  }


  sheet
    .getRange(
      rowNumber,
      map.STATUS + 1
    )
    .setValue(status);


  if (
    status === 'DIPANGGIL' &&
    map.WAKTU_PANGGIL !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.WAKTU_PANGGIL + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    status === 'SELESAI' &&
    map.WAKTU_SELESAI !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.WAKTU_SELESAI + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    map.UPDATED_AT !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.UPDATED_AT + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    map.UPDATED_BY !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.UPDATED_BY + 1
      )
      .setValue(
        session.username
      );

  }


  updateVisitStatusByQueue_(
    values[
      rowNumber - 1
    ][
      map.KUNJUNGAN_ID
    ],
    status
  );


  writeAuditLog_(
    session.userId,
    session.username,
    'UBAH_STATUS',
    'ANTRIAN',
    antrianId,
    'Antrian ' +
      queue.nomorAntrian +
      ' pasien ' +
      queue.nama +
      ' diubah menjadi ' +
      status
  );


  return {

    success: true,

    status:
      status

  };

}


/* =====================================================
   UPDATE STATUS KUNJUNGAN
   ===================================================== */

function updateVisitStatusByQueue_(
  kunjunganId,
  queueStatus
) {

  if (!kunjunganId) {
    return;
  }


  const sheet =
    getSheetByConfig(
      'KUNJUNGAN'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return;
  }


  const map =
    getHeaderMap_(sheet);


  let status = '';


  switch (queueStatus) {

    case 'MENUNGGU':

      status =
        'TERDAFTAR';

      break;


    case 'DIPANGGIL':

      status =
        'DIPANGGIL';

      break;


    case 'DILAYANI':

      status =
        'DILAYANI';

      break;


    case 'SELESAI':

      status =
        'SELESAI';

      break;


    case 'BATAL':

      status =
        'BATAL';

      break;

  }


  if (!status) {
    return;
  }


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.KUNJUNGAN_ID
        ] || ''
      ) ===
      String(kunjunganId)
    ) {

      sheet
        .getRange(
          i + 1,
          map.STATUS + 1
        )
        .setValue(status);

      return;

    }

  }

}


/* =====================================================
   PANGGIL PASIEN BERIKUTNYA
   ===================================================== */

function callNextQueue(
  token
) {

  requireSession_(token);


  const queue =
    getTodayQueue(token);


  const next =
    queue.find(
      function(item) {

        return (
          String(
            item.status
          ).toUpperCase() ===
            'MENUNGGU'
        );

      }
    );


  if (!next) {

    return {

      success:
        false,

      message:
        'Tidak ada pasien yang menunggu.'

    };

  }


  updateQueueStatus(
    token,
    next.antrianId,
    'DIPANGGIL'
  );


  return {

    success:
      true,

    nomorAntrian:
      next.nomorAntrian,

    nama:
      next.nama,

    noRM:
      next.noRM,

    status:
      'DIPANGGIL'

  };

}


/* =====================================================
   GET ANTRIAN AKTIF
   ===================================================== */

function getActiveQueue(
  token
) {

  const queue =
    getTodayQueue(token);


  return queue.filter(
    function(item) {

      return [

        'MENUNGGU',

        'DIPANGGIL',

        'DILAYANI'

      ].indexOf(
        String(
          item.status
        ).toUpperCase()
      ) !== -1;

    }
  );

}

/* =====================================================
   GET PASIEN UNTUK PEMERIKSAAN
   HANYA STATUS DILAYANI
   ===================================================== */

function getPatientsForExamination(
  token
) {

  requireSession_(token);


  const antrianSheet =
    getSheetByConfig(
      'ANTRIAN'
    );

  const kunjunganSheet =
    getSheetByConfig(
      'KUNJUNGAN'
    );

  const pasienSheet =
    getSheetByConfig(
      'PASIEN'
    );


  const antrianValues =
    antrianSheet
      .getDataRange()
      .getValues();

  const kunjunganValues =
    kunjunganSheet
      .getDataRange()
      .getValues();

  const pasienValues =
    pasienSheet
      .getDataRange()
      .getValues();


  if (
    antrianValues.length <= 1
  ) {

    return [];

  }


  const antrianMap =
    getHeaderMap_(
      antrianSheet
    );

  const kunjunganMap =
    getHeaderMap_(
      kunjunganSheet
    );

  const pasienMap =
    getHeaderMap_(
      pasienSheet
    );


  const today =
    getTodayString_();


  /* =================================================
     INDEX KUNJUNGAN
     ================================================= */

  const kunjunganById = {};


  for (
    let i = 1;
    i < kunjunganValues.length;
    i++
  ) {

    const row =
      kunjunganValues[i];


    const id =
      String(
        row[
          kunjunganMap.KUNJUNGAN_ID
        ] || ''
      ).trim();


    if (!id) {
      continue;
    }


    kunjunganById[id] =
      row;

  }


  /* =================================================
     INDEX PASIEN
     ================================================= */

  const pasienById = {};

  const pasienByRM = {};


  for (
    let i = 1;
    i < pasienValues.length;
    i++
  ) {

    const row =
      pasienValues[i];


    const pasienId =
      pasienMap.PASIEN_ID !== undefined
        ? String(
            row[
              pasienMap.PASIEN_ID
            ] || ''
          ).trim()
        : '';


    const noRM =
      pasienMap.NO_RM !== undefined
        ? String(
            row[
              pasienMap.NO_RM
            ] || ''
          ).trim()
        : '';


    const nama =
      pasienMap.NAMA_LENGKAP !== undefined
        ? String(
            row[
              pasienMap.NAMA_LENGKAP
            ] || ''
          ).trim()
        : '';


    if (pasienId) {

      pasienById[
        pasienId
      ] = {
        pasienId:
          pasienId,

        noRM:
          noRM,

        nama:
          nama
      };

    }


    if (noRM) {

      pasienByRM[
        noRM
      ] = {
        pasienId:
          pasienId,

        noRM:
          noRM,

        nama:
          nama
      };

    }

  }


  /* =================================================
     CARI ANTRIAN DILAYANI HARI INI
     ================================================= */

  const result = [];


  for (
    let i = 1;
    i < antrianValues.length;
    i++
  ) {

    const row =
      antrianValues[i];


    const tanggal =
      antrianMap.TANGGAL !== undefined
        ? formatDate_(
            row[
              antrianMap.TANGGAL
            ]
          )
        : '';


    if (
      !tanggal ||
      tanggal.substring(0, 10) !== today
    ) {

      continue;

    }


    const status =
      String(
        row[
          antrianMap.STATUS
        ] || ''
      )
        .trim()
        .toUpperCase();


    /* HANYA DILAYANI */

    if (
      status !== 'DILAYANI'
    ) {

      continue;

    }


    const antrianId =
      String(
        row[
          antrianMap.ANTRIAN_ID
        ] || ''
      ).trim();


    const kunjunganId =
      String(
        row[
          antrianMap.KUNJUNGAN_ID
        ] || ''
      ).trim();


    const noRM =
      String(
        row[
          antrianMap.NO_RM
        ] || ''
      ).trim();


    /* =================================================
       CARI KUNJUNGAN
       ================================================= */

    const kunjungan =
      kunjunganById[
        kunjunganId
      ] || null;


    let pasienId =
      '';


    let namaPasien =
      '';


    let jenisPelayanan =
      '';


    if (kunjungan) {

      if (
        kunjunganMap.PASIEN_ID !==
        undefined
      ) {

        pasienId =
          String(
            kunjungan[
              kunjunganMap.PASIEN_ID
            ] || ''
          ).trim();

      }


      if (
        kunjunganMap.NAMA_PASIEN !==
        undefined
      ) {

        namaPasien =
          String(
            kunjungan[
              kunjunganMap.NAMA_PASIEN
            ] || ''
          ).trim();

      }


      if (
        kunjunganMap.JENIS_PELAYANAN !==
        undefined
      ) {

        jenisPelayanan =
          String(
            kunjungan[
              kunjunganMap.JENIS_PELAYANAN
            ] || ''
          ).trim();

      }

    }


    /* =================================================
       CARI PASIEN
       PASIEN_ID → NO_RM
       ================================================= */

    let pasien =
      null;


    if (
      pasienId &&
      pasienById[
        pasienId
      ]
    ) {

      pasien =
        pasienById[
          pasienId
        ];

    }


    if (
      !pasien &&
      noRM &&
      pasienByRM[
        noRM
      ]
    ) {

      pasien =
        pasienByRM[
          noRM
        ];

    }


    if (pasien) {

      if (!pasienId) {

        pasienId =
          pasien.pasienId || '';

      }


      if (!namaPasien) {

        namaPasien =
          pasien.nama || '';

      }

    }


    /* =================================================
       FALLBACK DARI ANTRIAN
       ================================================= */

    if (
      !namaPasien &&
      antrianMap.NAMA_PASIEN !==
        undefined
    ) {

      namaPasien =
        String(
          row[
            antrianMap.NAMA_PASIEN
          ] || ''
        ).trim();

    }


    if (
      !jenisPelayanan &&
      antrianMap.JENIS_LAYANAN !==
        undefined
    ) {

      jenisPelayanan =
        String(
          row[
            antrianMap.JENIS_LAYANAN
          ] || ''
        ).trim();

    }


    /* =================================================
       HASIL
       ================================================= */

    result.push({

      antrianId:
        antrianId,

      nomorAntrian:
        String(
          row[
            antrianMap.NOMOR_ANTRIAN
          ] || ''
        ),

      kunjunganId:
        kunjunganId,

      pasienId:
        pasienId,

      noRM:
        noRM,

      namaPasien:
        namaPasien,

      jenisPelayanan:
        jenisPelayanan,

      status:
        'DILAYANI'

    });

  }


  return result;

}

