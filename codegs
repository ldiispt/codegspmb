/* =====================================================
   DASHBOARD DATA
   ===================================================== */

function getDashboardData(token) {

  const session = requireSession_(token);

  const patientSheet =
    getSheetByConfig('PASIEN');

  const visitSheet =
    getSheetByConfig('KUNJUNGAN');

  const queueSheet =
    getSheetByConfig('ANTRIAN');

  const transactionSheet =
    getSheetByConfig('TRANSAKSI');


  /* =====================================================
     DATA PASIEN
     ===================================================== */

  const patientData =
    patientSheet
      .getDataRange()
      .getValues();

  const patientMap =
    getHeaderMap_(patientData[0]);

  const patientById = {};
  const patientByRM = {};

  let totalPatients = 0;
  let newPatientsToday = 0;

  const today =
    getTodayString_();


  if (patientData.length > 1) {

    totalPatients =
      patientData.length - 1;


    for (
      let i = 1;
      i < patientData.length;
      i++
    ) {

      const row =
        patientData[i];


      /* PASIEN_ID */

      if (
        patientMap.PASIEN_ID !== undefined
      ) {

        const pasienId =
          String(
            row[
              patientMap.PASIEN_ID
            ] || ''
          ).trim();


        if (pasienId) {

          patientById[
            pasienId
          ] = row;

        }

      }


      /* NO_RM */

      if (
        patientMap.NO_RM !== undefined
      ) {

        const noRM =
          String(
            row[
              patientMap.NO_RM
            ] || ''
          ).trim();


        if (noRM) {

          patientByRM[
            noRM
          ] = row;

        }

      }


      /* PASIEN BARU HARI INI */

      if (
        patientMap.CREATED_AT !== undefined
      ) {

        const created =
          formatDate_(
            row[
              patientMap.CREATED_AT
            ]
          );


        if (
          created &&
          created.substring(0, 10) ===
            today
        ) {

          newPatientsToday++;

        }

      }

    }

  }


  /* =====================================================
     DATA KUNJUNGAN
     ===================================================== */

  const visitData =
    visitSheet
      .getDataRange()
      .getValues();

  const visitMap =
    getHeaderMap_(visitData[0]);

  const visitById = {};
  const visitByRM = {};

  let todayVisits = 0;


  if (visitData.length > 1) {

    for (
      let i = 1;
      i < visitData.length;
      i++
    ) {

      const row =
        visitData[i];


      /* KUNJUNGAN_ID */

      if (
        visitMap.KUNJUNGAN_ID !== undefined
      ) {

        const kunjunganId =
          String(
            row[
              visitMap.KUNJUNGAN_ID
            ] || ''
          ).trim();


        if (kunjunganId) {

          visitById[
            kunjunganId
          ] = row;

        }

      }


      /* NO_RM */

      if (
        visitMap.NO_RM !== undefined
      ) {

        const noRM =
          String(
            row[
              visitMap.NO_RM
            ] || ''
          ).trim();


        if (noRM) {

          visitByRM[
            noRM
          ] = row;

        }

      }


      /* KUNJUNGAN HARI INI */

      if (
        visitMap.TANGGAL !== undefined
      ) {

        const tanggal =
          formatDate_(
            row[
              visitMap.TANGGAL
            ]
          );


        if (
          tanggal &&
          tanggal.substring(0, 10) ===
            today
        ) {

          todayVisits++;

        }

      }

    }

  }


  /* =====================================================
     DATA ANTRIAN
     ===================================================== */

  const queueData =
    queueSheet
      .getDataRange()
      .getValues();

  const queueMap =
    getHeaderMap_(queueData[0]);

  const queueList = [];

  let todayQueue = 0;


  if (queueData.length > 1) {

    for (
      let i = 1;
      i < queueData.length;
      i++
    ) {

      const row =
        queueData[i];


      /* ---------------------------------------------
         FILTER TANGGAL
         --------------------------------------------- */

      let tanggalAntrian = '';


      if (
        queueMap.TANGGAL !== undefined
      ) {

        tanggalAntrian =
          formatDate_(
            row[
              queueMap.TANGGAL
            ]
          );

      }


      if (
        !tanggalAntrian ||
        tanggalAntrian.substring(0, 10) !==
          today
      ) {

        continue;

      }


      todayQueue++;


      /* ---------------------------------------------
         DATA ANTRIAN
         --------------------------------------------- */

      const nomor =
        queueMap.NOMOR_ANTRIAN !== undefined
          ? String(
              row[
                queueMap.NOMOR_ANTRIAN
              ] || ''
            ).trim()
          : '';


      const noRM =
        queueMap.NO_RM !== undefined
          ? String(
              row[
                queueMap.NO_RM
              ] || ''
            ).trim()
          : '';


      const pasienId =
        queueMap.PASIEN_ID !== undefined
          ? String(
              row[
                queueMap.PASIEN_ID
              ] || ''
            ).trim()
          : '';


      const kunjunganId =
        queueMap.KUNJUNGAN_ID !== undefined
          ? String(
              row[
                queueMap.KUNJUNGAN_ID
              ] || ''
            ).trim()
          : '';


      /* ---------------------------------------------
         CARI PASIEN
         --------------------------------------------- */

      let pasien = null;


      /*
       * Prioritas:
       * 1. PASIEN_ID
       * 2. NO_RM
       */

      if (
        pasienId &&
        patientById[
          pasienId
        ]
      ) {

        pasien =
          patientById[
            pasienId
          ];

      }


      if (
        !pasien &&
        noRM &&
        patientByRM[
          noRM
        ]
      ) {

        pasien =
          patientByRM[
            noRM
          ];

      }


      /* ---------------------------------------------
         NAMA PASIEN
         --------------------------------------------- */

      let nama = '';


      if (pasien) {

        if (
          patientMap.NAMA_LENGKAP !== undefined
        ) {

          nama =
            String(
              pasien[
                patientMap.NAMA_LENGKAP
              ] || ''
            ).trim();

        }


        if (
          !nama &&
          patientMap.NAMA !== undefined
        ) {

          nama =
            String(
              pasien[
                patientMap.NAMA
              ] || ''
            ).trim();

        }

      }


      /*
       * Fallback terakhir:
       * ANTRIAN.NAMA_PASIEN
       */

      if (
        !nama &&
        queueMap.NAMA_PASIEN !== undefined
      ) {

        nama =
          String(
            row[
              queueMap.NAMA_PASIEN
            ] || ''
          ).trim();

      }


      /* ---------------------------------------------
         STATUS
         --------------------------------------------- */

      const status =
        queueMap.STATUS !== undefined
          ? String(
              row[
                queueMap.STATUS
              ] || ''
            ).trim()
          : '';


      /* ---------------------------------------------
         MASUKKAN KE LIST
         --------------------------------------------- */

      queueList.push({

        nomor:
          nomor,

        noRM:
          noRM,

        nama:
          nama,

        status:
          status,

        pasienId:
          pasienId,

        kunjunganId:
          kunjunganId

      });

    }

  }


  /* =====================================================
     TRANSAKSI / PENDAPATAN
     ===================================================== */

  let revenueToday = 0;


  const transactionData =
    transactionSheet
      .getDataRange()
      .getValues();


  if (
    transactionData.length > 1
  ) {

    const transactionMap =
      getHeaderMap_(
        transactionData[0]
      );


    for (
      let i = 1;
      i < transactionData.length;
      i++
    ) {

      const row =
        transactionData[i];


      if (
        transactionMap.TANGGAL === undefined
      ) {

        continue;

      }


      const tanggal =
        formatDate_(
          row[
            transactionMap.TANGGAL
          ]
        );


      if (
        !tanggal ||
        tanggal.substring(0, 10) !==
          today
      ) {

        continue;

      }


      if (
        transactionMap.TOTAL !== undefined
      ) {

        revenueToday +=
          Number(
            row[
              transactionMap.TOTAL
            ] || 0
          );

      }

    }

  }


  /* =====================================================
     PASIEN TERBARU
     ===================================================== */

  const latestPatients =
    getLatestPatients_(5);


  /* =====================================================
     RETURN
     ===================================================== */

  return {

    user: {

      id:
        session.userId,

      username:
        session.username,

      name:
        session.name,

      role:
        session.role

    },

    stats: {

      totalPatients:
        totalPatients,

      newPatientsToday:
        newPatientsToday,

      todayVisits:
        todayVisits,

      todayQueue:
        todayQueue,

      revenueToday:
        revenueToday

    },

    queue:
      queueList.slice(
        0,
        10
      ),

    latestPatients:
      latestPatients

  };

}


/* =====================================================
   PASIEN
   ===================================================== */

function getLatestPatients_(limit) {

  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return [];
  }


  const map =
    getHeaderMap_(sheet);

  const result = [];


  for (
    let i = values.length - 1;
    i >= 1 &&
    result.length < limit;
    i--
  ) {

    result.push(
      patientRowToObject_(
        values[i],
        map
      )
    );

  }


  return result;

}


/* =====================================================
   PATIENT ROW TO OBJECT
   ===================================================== */

function patientRowToObject_(
  row,
  map
) {

  return {

    pasienId:
      row[map.PASIEN_ID] || '',

    noRM:
      row[map.NO_RM] || '',

    nik:
      row[map.NIK] || '',

    nama:
      row[map.NAMA_LENGKAP] || '',

    tempatLahir:
      row[map.TEMPAT_LAHIR] || '',

    tanggalLahir:
      formatDate_(
        row[map.TANGGAL_LAHIR]
      ),

    jenisKelamin:
      row[map.JENIS_KELAMIN] || '',

    alamat:
      row[map.ALAMAT] || '',

    noHP:
      row[map.NO_HP] || '',

    namaSuami:
      row[map.NAMA_SUAMI] || '',

    golonganDarah:
      row[map.GOLONGAN_DARAH] || '',

    status:
      row[map.STATUS] || '',

    catatan:
      row[map.CATATAN] || '',

    createdAt:
      formatDate_(
        row[map.CREATED_AT]
      ),

    updatedAt:
      formatDate_(
        row[map.UPDATED_AT]
      )

  };

}


/* =====================================================
   GET DATA PASIEN
   ===================================================== */

function getPatients(
  token,
  search,
  status
) {

  requireSession_(token);

  search =
    String(search || '')
      .trim()
      .toLowerCase();

  status =
    String(status || '')
      .trim()
      .toUpperCase();


  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {

    return {

      total: 0,

      data: []

    };

  }


  const map =
    getHeaderMap_(sheet);

  const result = [];


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const patient =
      patientRowToObject_(
        values[i],
        map
      );


    const searchable = [

      patient.noRM,

      patient.nik,

      patient.nama,

      patient.noHP

    ]
      .join(' ')
      .toLowerCase();


    if (
      search &&
      searchable.indexOf(search) === -1
    ) {

      continue;

    }


    if (
      status &&
      String(
        patient.status || ''
      ).toUpperCase() !==
        status
    ) {

      continue;

    }


    patient._rowNumber =
      i + 1;

    result.push(patient);

  }


  result.reverse();


  return {

    total:
      result.length,

    data:
      result

  };

}


/* =====================================================
   DETAIL PASIEN
   ===================================================== */

function getPatientDetail(
  token,
  pasienId
) {

  requireSession_(token);

  pasienId =
