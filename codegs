            kunjunganMap.KELUHAN
          ] || ''
        ),

      status:
        String(
          kunjungan[
            kunjunganMap.STATUS
          ] || ''
        )

    },


    pasien: {

      pasienId:
        String(
          pasien[
            pasienMap.PASIEN_ID
          ] || ''
        ),

      noRM:
        String(
          pasien[
            pasienMap.NO_RM
          ] || ''
        ),

