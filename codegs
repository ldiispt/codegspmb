/* =====================================================
   PENDAFTARAN KUNJUNGAN
   ===================================================== */

function registerVisit(token, data) {

  const session = requireSession_(token);

  if (!data) {
    throw new Error('Data pendaftaran tidak ditemukan.');
  }

  const pasienId = String(data.pasienId || '').trim();
  const jenisPelayanan = String(data.jenisPelayanan || '').trim();
  const keluhan = String(data.keluhan || '').trim();

  if (!pasienId) {
    throw new Error('Pasien belum dipilih.');
  }

  if (!jenisPelayanan) {
    throw new Error('Jenis pelayanan wajib dipilih.');
  }

  const patient = findPatientById_(pasienId);

  if (!patient) {
    throw new Error('Data pasien tidak ditemukan.');
  }

  if (String(patient.status).toUpperCase() !== 'AKTIF') {
    throw new Error('Pasien tidak aktif.');
  }

  const existing = findTodayVisitByPatient_(patient.noRM);

  if (existing) {
    throw new Error(
      'Pasien ini sudah memiliki kunjungan hari ini dengan nomor antrian ' +
      existing.nomorAntrian + '.'
    );
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {

    const kunjunganSheet = getSheetByConfig('KUNJUNGAN');
    const antrianSheet = getSheetByConfig('ANTRIAN');

    const kunjunganMap = getHeaderMap_(kunjunganSheet);
    const antrianMap = getHeaderMap_(antrianSheet);

    const kunjunganId = generateKunjunganId_();
    const nomorAntrian = generateQueueNumber_();
    const now = new Date();
    const tanggal = getTodayString_();

    /* ============================
       KUNJUNGAN
       ============================ */

    const kunjunganRow =
      new Array(kunjunganSheet.getLastColumn()).fill('');

    setCell_(
      kunjunganRow,
      kunjunganMap.KUNJUNGAN_ID,
      kunjunganId
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.NO_RM,
      patient.noRM
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.PASIEN_ID,
      patient.pasienId
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.TANGGAL_KUNJUNGAN,
      tanggal
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.JENIS_KUNJUNGAN,
      jenisPelayanan
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.KELUHAN_UTAMA,
      keluhan
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.STATUS_KUNJUNGAN,
      'TERDAFTAR'
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.NO_ANTRIAN,
      nomorAntrian
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.CREATED_AT,
      now
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.CREATED_BY,
      session.username
    );

    kunjunganSheet.appendRow(kunjunganRow);

    /* ============================
       ANTRIAN
       ============================ */

    const antrianRow =
      new Array(antrianSheet.getLastColumn()).fill('');

    setCell_(
      antrianRow,
      antrianMap.ANTRIAN_ID,
      'AN-' +
      Utilities.getUuid()
        .substring(0, 8)
        .toUpperCase()
    );

    setCell_(
      antrianRow,
      antrianMap.KUNJUNGAN_ID,
      kunjunganId
    );

    setCell_(
      antrianRow,
      antrianMap.NO_RM,
      patient.noRM
    );

    setCell_(
      antrianRow,
      antrianMap.NOMOR_ANTRIAN,
      nomorAntrian
    );

    setCell_(
      antrianRow,
      antrianMap.TANGGAL,
      tanggal
    );

    setCell_(
      antrianRow,
      antrianMap.JENIS_LAYANAN,
      jenisPelayanan
    );

    setCell_(
      antrianRow,
      antrianMap.STATUS,
      'MENUNGGU'
    );

    setCell_(
      antrianRow,
      antrianMap.WAKTU_DAFTAR,
      now
    );

    antrianSheet.appendRow(antrianRow);

    writeAuditLog_(
      session.userId,
      session.username,
      'PENDAFTARAN',
      'KUNJUNGAN',
      kunjunganId,
      'Pendaftaran pasien ' +
      patient.noRM +
      ' - ' +
      patient.nama +
      ' - Antrian ' +
      nomorAntrian
    );

    return {
      success: true,
      kunjunganId: kunjunganId,
      nomorAntrian: nomorAntrian,
      noRM: patient.noRM,
      nama: patient.nama,
      jenisPelayanan: jenisPelayanan,
      tanggal: tanggal,
      message: 'Pendaftaran berhasil.'
    };

  } finally {
    lock.releaseLock();
  }
}


/* =====================================================
   CEK KUNJUNGAN HARI INI
   ===================================================== */

function findTodayVisitByPatient_(noRM) {

  const sheet = getSheetByConfig('KUNJUNGAN');

  const values = sheet.getDataRange().getValues();

  if (values.length < 2) {
    return null;
  }

  const map = getHeaderMap_(sheet);
  const today = getTodayString_();

  for (let i = 1; i < values.length; i++) {

    const dateValue = formatDate_(
      values[i][map.TANGGAL_KUNJUNGAN]
    );

    const patientRM = String(
      values[i][map.NO_RM] || ''
    ).trim();

    const status = String(
      values[i][map.STATUS_KUNJUNGAN] || ''
    ).toUpperCase();

    if (
      dateValue &&
      dateValue.substring(0, 10) === today &&
      patientRM === String(noRM).trim() &&
      status !== 'BATAL'
    ) {

      const kunjunganId =
        values[i][map.KUNJUNGAN_ID] || '';

      return {
        kunjunganId: kunjunganId,
        nomorAntrian:
          getQueueNumberByVisitId_(kunjunganId)
      };
    }
  }

  return null;
}


