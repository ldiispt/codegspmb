   ===================================================== */

function registerVisit(token, data) {

  const session = requireSession_(token);

  if (!data) {
    throw new Error('Data pendaftaran tidak ditemukan.');
  }

  const pasienId = String(data.pasienId || '').trim();
  const jenisPelayanan = String(data.jenisPelayanan || '').trim();
  const keluhan = String(data.keluhan || '').trim();

  if (!pasienId) {
    throw new Error('Pasien belum dipilih.');
  }

  if (!jenisPelayanan) {
    throw new Error('Jenis pelayanan wajib dipilih.');
  }

  const patient = findPatientById_(pasienId);

  if (!patient) {
    throw new Error('Data pasien tidak ditemukan.');
  }

  if (String(patient.status).toUpperCase() !== 'AKTIF') {
    throw new Error('Pasien tidak aktif.');
  }

  const existing = findTodayVisitByPatient_(patient.noRM);

  if (existing) {
    throw new Error(
      'Pasien ini sudah memiliki kunjungan hari ini dengan nomor antrian ' +
      existing.nomorAntrian + '.'
    );
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {

    const kunjunganSheet = getSheetByConfig('KUNJUNGAN');
    const antrianSheet = getSheetByConfig('ANTRIAN');

    const kunjunganMap = getHeaderMap_(kunjunganSheet);
    const antrianMap = getHeaderMap_(antrianSheet);

    const kunjunganId = generateKunjunganId_();
    const nomorAntrian = generateQueueNumber_();
    const now = new Date();
    const tanggal = getTodayString_();

    /* ============================
       KUNJUNGAN
       ============================ */

    const kunjunganRow =
      new Array(kunjunganSheet.getLastColumn()).fill('');

    setCell_(
      kunjunganRow,
      kunjunganMap.KUNJUNGAN_ID,
      kunjunganId
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.NO_RM,
      patient.noRM
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.PASIEN_ID,
      patient.pasienId
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.TANGGAL_KUNJUNGAN,
      tanggal
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.JENIS_KUNJUNGAN,
      jenisPelayanan
    );

    setCell_(
      kunjunganRow,
      kunjunganMap.KELUHAN_UTAMA,
      keluhan
    );

    setCell_(
      kunjunganRow,
