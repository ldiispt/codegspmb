  data =
    data || {};

  const sheet =
    getSheetByConfig('OBAT');

  const map =
    getHeaderMap_(sheet);

  const obatId =
    String(
      data.obatId || ''
    ).trim();

  const kodeObat =
    String(
      data.kodeObat || ''
    ).trim();

  const namaObat =
    String(
      data.namaObat || ''
    ).trim();

  const kandungan =
    String(
      data.kandungan || ''
    ).trim();

  const satuan =
    String(
      data.satuan || ''
    ).trim();

  const hargaBeli =
    Number(
      data.hargaBeli || 0
    );

  const hargaJual =
    Number(
      data.hargaJual || 0
    );

  const stok =
    Number(
      data.stok || 0
    );

  const stokMinimum =
    Number(
      data.stokMinimum || 0
    );

  const lokasi =
    String(
      data.lokasi || ''
    ).trim();

  const status =
    String(
      data.status || 'AKTIF'
    )
      .trim()
      .toUpperCase();

  const keterangan =
    String(
      data.keterangan || ''
    ).trim();


  if (!namaObat) {

    throw new Error(
      'Nama obat wajib diisi.'
    );

  }

  if (!satuan) {

    throw new Error(
      'Satuan obat wajib diisi.'
    );

  }

  if (
    isNaN(hargaBeli) ||
    hargaBeli < 0
  ) {

    throw new Error(
      'Harga beli tidak valid.'
    );

  }

  if (
    isNaN(hargaJual) ||
    hargaJual < 0
  ) {

    throw new Error(
      'Harga jual tidak valid.'
    );

  }

  if (
    isNaN(stok) ||
    stok < 0
  ) {

    throw new Error(
      'Stok tidak valid.'
    );

  }

  if (
    isNaN(stokMinimum) ||
    stokMinimum < 0
  ) {

    throw new Error(
      'Stok minimum tidak valid.'
    );

  }


  const allValues =
    sheet
      .getDataRange()
      .getValues();


  /* ===================================================
     EDIT DATA
     =================================================== */
  if (obatId) {

    let foundRow =
      -1;

    for (
      let i = 1;
      i < allValues.length;
      i++
    ) {

      const currentId =
        String(
          allValues[i][map.OBAT_ID] || ''
        ).trim();

      if (
        currentId === obatId
      ) {

        foundRow =
          i + 1;

        break;

      }

    }

    if (
      foundRow === -1
    ) {

      throw new Error(
        'Data obat yang akan diedit tidak ditemukan.'
      );

    }


    /* Cek kode obat */
    if (kodeObat) {

      for (
        let i = 1;
        i < allValues.length;
        i++
      ) {

        const rowId =
          String(
            allValues[i][map.OBAT_ID] || ''
          ).trim();

        const rowCode =
          String(
            allValues[i][map.KODE_OBAT] || ''
          ).trim()
            .toLowerCase();

        if (
          rowId !== obatId &&
          rowCode &&
          rowCode ===
            kodeObat.toLowerCase()
        ) {

          throw new Error(
            'Kode obat sudah digunakan.'
          );

        }

      }

    }


    const row =
      sheet
        .getRange(
          foundRow,
          1,
          1,
          sheet.getLastColumn()
        )
        .getValues()[0];

    row[map.KODE_OBAT] =
      kodeObat ||
      row[map.KODE_OBAT] ||
      generateMedicineCode_();

    row[map.NAMA_OBAT] =
      namaObat;

    row[map.KANDUNGAN] =
      kandungan;

    row[map.SATUAN] =
      satuan;

    row[map.HARGA_BELI] =
      hargaBeli;

    row[map.HARGA_JUAL] =
      hargaJual;

    row[map.STOK] =
      stok;

    row[map.STOK_MINIMUM] =
      stokMinimum;

    row[map.LOKASI] =
      lokasi;

    row[map.STATUS] =
      status;

    row[map.KETERANGAN] =
      keterangan;

    row[map.UPDATED_AT] =
      new Date();

    sheet
      .getRange(
        foundRow,
        1,
        1,
        row.length
      )
      .setValues([row]);


    writeAuditLog_(
      session.userId,
      session.username,
      'EDIT',
      'OBAT',
      obatId,
      'Data obat diperbarui: ' +
        namaObat
    );

    return {

      success: true,

      message:
        'Data obat berhasil diperbarui.'

    };

  }


  /* ===================================================
     TAMBAH DATA BARU
     =================================================== */

  const newObatId =
    'OBT-' +
    Utilities.getUuid()
      .substring(0, 8)
      .toUpperCase();

  let finalKode =
    kodeObat;

  if (!finalKode) {

    finalKode =
      generateMedicineCode_();

  }


  /* Cek kode obat */
  for (
    let i = 1;
    i < allValues.length;
    i++
  ) {

    const rowCode =
      String(
        allValues[i][map.KODE_OBAT] || ''
      ).trim()
        .toLowerCase();

    if (
      rowCode &&
      rowCode ===
        finalKode.toLowerCase()
    ) {

      throw new Error(
        'Kode obat sudah digunakan.'
      );

    }

  }


  const newRow =
    new Array(
      sheet.getLastColumn()
    ).fill('');

  newRow[map.OBAT_ID] =
    newObatId;

  newRow[map.KODE_OBAT] =
    finalKode;

  newRow[map.NAMA_OBAT] =
    namaObat;

  newRow[map.KANDUNGAN] =
    kandungan;

  newRow[map.SATUAN] =
    satuan;

  newRow[map.HARGA_BELI] =
    hargaBeli;

  newRow[map.HARGA_JUAL] =
    hargaJual;

  newRow[map.STOK] =
    stok;

  newRow[map.STOK_MINIMUM] =
    stokMinimum;

  newRow[map.LOKASI] =
    lokasi;

  newRow[map.STATUS] =
    status;

  newRow[map.KETERANGAN] =
    keterangan;

  newRow[map.CREATED_AT] =
    new Date();

  newRow[map.UPDATED_AT] =
    new Date();


  sheet.appendRow(
    newRow
  );


  writeAuditLog_(
    session.userId,
    session.username,
    'TAMBAH',
    'OBAT',
    newObatId,
    'Menambahkan obat: ' +
      namaObat
  );


  return {

    success: true,

    obatId:
      newObatId,

    kodeObat:
      finalKode,

    message:
      'Data obat berhasil ditambahkan.'

  };

}


/**
 * =====================================================
 * UBAH STATUS OBAT
 * =====================================================
 */
function updateMedicineStatus(
  token,
  obatId,
  status
) {

  const session =
    requireSession_(token);

  obatId =
    String(
      obatId || ''
    ).trim();

  status =
    String(
      status || ''
    ).trim()
      .toUpperCase();

  if (!obatId) {

    throw new Error(
      'ID obat tidak ditemukan.'
    );

  }

  if (
    status !== 'AKTIF' &&
    status !== 'NONAKTIF'
  ) {

    throw new Error(
      'Status obat tidak valid.'
    );

  }

  const sheet =
    getSheetByConfig('OBAT');

  const map =
    getHeaderMap_(sheet);

  const values =
    sheet
      .getDataRange()
      .getValues();

  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const currentId =
      String(
        values[i][map.OBAT_ID] || ''
      ).trim();

    if (
      currentId !== obatId
    ) {
      continue;
    }

    const rowNumber =
      i + 1;

    sheet
      .getRange(
        rowNumber,
        map.STATUS + 1
      )
      .setValue(status);

    sheet
      .getRange(
        rowNumber,
        map.UPDATED_AT + 1
