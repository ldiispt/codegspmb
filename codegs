/* =====================================================
   GENERATE ID REKAM MEDIS
   ===================================================== */

function generateRekamMedisId_() {

  const sheet =
    getSheetByConfig(
      'REKAM_MEDIS'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length <= 1) {

    return 'RMED-000001';

  }


  const headers =
    values[0];


  const map =
    getHeaderMap_(
      headers
    );


  let max = 0;


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const value =
      String(
        map.REKAM_MEDIS_ID !==
        undefined
          ? values[i][
              map.REKAM_MEDIS_ID
            ]
          : ''
      ).trim();


    if (!value) {
      continue;
    }


    const match =
      value.match(
        /(\d+)$/
      );


    if (match) {

      const number =
        parseInt(
          match[1],
          10
        );


      if (
        !isNaN(number) &&
        number > max
      ) {

        max =
          number;

      }

    }

  }


  return (
    'RMED-' +
    String(
      max + 1
    ).padStart(
      6,
      '0'
    )
  );

}


 





