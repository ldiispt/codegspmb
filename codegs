/* =====================================================
   AUDIT LOG
   ===================================================== */

function writeAuditLog_(
  userId,
  username,
  aksi,
  modul,
  referensiId,
  keterangan
) {

  try {

    const sheet =
      getSheetByConfig('AUDIT_LOG');

    const logId =
      'LOG-' +
      Utilities.getUuid()
        .substring(0, 8)
        .toUpperCase();

    sheet.appendRow([

      logId,

      new Date(),

      userId || '',

      username || '',

      aksi || '',

      modul || '',

      referensiId || '',

      keterangan || '',

      ''

    ]);

  } catch (error) {

    console.error(
      'Audit Log Error: ' +
      error.message
    );

  }

}


/* =====================================================
   HEADER MAP
   ===================================================== */

function getHeaderMap_(source) {

  /*
   * Kompatibel dengan:
   *
   * 1. Google Sheet
   * 2. Array header
   */

  let headers = [];


  if (Array.isArray(source)) {

    headers =
      source;

  }


  else if (
    source &&
    typeof source.getLastColumn ===
      'function' &&
    typeof source.getRange ===
      'function'
  ) {

    const lastColumn =
      source.getLastColumn();

    if (lastColumn < 1) {
      return {};
    }

    headers =
      source
        .getRange(
          1,
          1,
          1,
          lastColumn
        )
        .getValues()[0];

  }


  else {

    throw new Error(
      'Sumber header tidak valid. ' +
      'getHeaderMap_ membutuhkan Google Sheet ' +
      'atau array header.'
    );

  }


  const map = {};

  headers.forEach(
    function(header, index) {

      const key =
        String(
          header || ''
        ).trim();

      if (key) {

        map[key] =
          index;

      }

    }
  );

  return map;

}


/* =====================================================
   GENERATE NO RM
   ===================================================== */

function generateNoRM_() {

  const sheet =
    getSheetByConfig('PASIEN');

  const map =
    getHeaderMap_(sheet);

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {

    return (
      String(
        PMB_CONFIG.RM_PREFIX ||
        'PMB-'
      ) +
      '000001'
    );

  }

  const rmColumn =
    map.NO_RM + 1;

  const values =
    sheet
      .getRange(
        2,
        rmColumn,
        lastRow - 1,
        1
      )
      .getValues();

  let maxNumber = 0;

  const prefix =
    String(
      PMB_CONFIG.RM_PREFIX ||
      'PMB-'
    );


  values.forEach(
    function(row) {

      const value =
        String(
          row[0] || ''
        ).trim();

      if (!value) return;

      const number =
        parseInt(
          value.replace(
            prefix,
            ''
          ),
          10
        );

      if (
        !isNaN(number) &&
        number > maxNumber
      ) {

        maxNumber =
          number;

      }

    }
  );


  return (
    prefix +
    String(
      maxNumber + 1
    ).padStart(
      6,
      '0'
    )
  );

}


/* =====================================================
   FORMAT TANGGAL
   ===================================================== */

function formatDate_(value) {

  if (!value) {
    return '';
  }


  if (
    Object.prototype.toString.call(value) ===
    '[object Date]'
  ) {

    return Utilities.formatDate(
      value,
      PMB_CONFIG.TIMEZONE ||
        'Asia/Jakarta',
      'yyyy-MM-dd'
    );

  }


  return String(value);

}


/* =====================================================
   VALIDASI NIK
   ===================================================== */

function validateNIK_(nik) {

  nik =
    String(nik || '')
      .replace(/\D/g, '');

  if (!nik) {
    return true;
  }

  return nik.length === 16;

}


