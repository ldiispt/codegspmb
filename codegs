/* =====================================================
   WEB APP
   ===================================================== */

function doGet() {

  return HtmlService
    .createTemplateFromFile('Index')
    .evaluate()
    .setTitle(
      PMB_CONFIG.APP_NAME ||
      'PMB SETIAWATI'
    )
    .setXFrameOptionsMode(
      HtmlService.XFrameOptionsMode.ALLOWALL
    );

}


/* =====================================================
   DATABASE
   ===================================================== */

function getDatabase() {

  const spreadsheetId =
    String(
      PMB_CONFIG.DATABASE_SPREADSHEET_ID || ''
    ).trim();

  if (
    spreadsheetId &&
    spreadsheetId !==
      'MASUKKAN_ID_SPREADSHEET_DI_SINI'
  ) {

    try {

      return SpreadsheetApp
        .openById(spreadsheetId);

    } catch (error) {

      throw new Error(
        'Google Spreadsheet database tidak dapat dibuka.\n\n' +
        'Pastikan DATABASE_SPREADSHEET_ID benar dan akun Apps Script memiliki akses.\n\n' +
        'Detail: ' +
        error.message
      );

    }

  }

  const active =
    SpreadsheetApp.getActiveSpreadsheet();

  if (active) {
    return active;
  }

  throw new Error(
    'Spreadsheet database belum ditentukan.\n\n' +
    'Silakan isi DATABASE_SPREADSHEET_ID di Config.gs.'
  );

}


function getSheet(sheetName) {

  const db =
    getDatabase();

  const sheet =
    db.getSheetByName(sheetName);

  if (!sheet) {

    throw new Error(
      'Sheet "' +
      sheetName +
      '" tidak ditemukan.'
    );

  }

  return sheet;

}


function getSheetByConfig(key) {

  const sheetName =
    PMB_CONFIG.SHEETS &&
    PMB_CONFIG.SHEETS[key]
      ? PMB_CONFIG.SHEETS[key]
      : key;

  return getSheet(sheetName);

}


