/**
 * =====================================================
 * GENERATE KODE OBAT
 * =====================================================
 */
function generateMedicineCode_() {

  const sheet =
    getSheetByConfig('OBAT');

  const map =
    getHeaderMap_(sheet);

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {
    return 'OBT-0001';
  }

  const values =
    sheet
      .getRange(
        2,
        map.KODE_OBAT + 1,
        lastRow - 1,
        1
      )
      .getValues();

  let maxNumber = 0;

  values.forEach(
    function(row) {

      const value =
        String(
          row[0] || ''
        ).trim();

      if (!value) return;

      const number =
        parseInt(
          value
            .replace(
              /^OBT-/i,
              ''
            ),
          10
        );

      if (
        !isNaN(number) &&
        number > maxNumber
      ) {

        maxNumber =
          number;

      }

    }
  );

  return (
    'OBT-' +
    String(
      maxNumber + 1
    ).padStart(
      4,
      '0'
    )
  );

}


/**
