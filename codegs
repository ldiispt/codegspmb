/* =====================================================
   AUDIT LOG
   ===================================================== */

function writeAuditLog_(
  userId,
  username,
  aksi,
  modul,
  referensiId,
  keterangan
) {

  try {

    const sheet =
      getSheetByConfig('AUDIT_LOG');

    const logId =
      'LOG-' +
      Utilities.getUuid()
        .substring(0, 8)
        .toUpperCase();

    sheet.appendRow([

      logId,

      new Date(),

      userId || '',

      username || '',

      aksi || '',

      modul || '',

      referensiId || '',

      keterangan || '',

      ''

    ]);

  } catch (error) {

    console.error(
      'Audit Log Error: ' +
      error.message
    );

  }

}


/* =====================================================
   HEADER MAP
   ===================================================== */

function getHeaderMap_(source) {

  /*
   * Kompatibel dengan:
   *
   * 1. Google Sheet
   * 2. Array header
   */

  let headers = [];


  if (Array.isArray(source)) {

    headers =
      source;

  }


  else if (
    source &&
    typeof source.getLastColumn ===
      'function' &&
    typeof source.getRange ===
      'function'
  ) {

    const lastColumn =
      source.getLastColumn();

    if (lastColumn < 1) {
      return {};
    }

    headers =
      source
        .getRange(
          1,
          1,
          1,
          lastColumn
        )
        .getValues()[0];

  }


  else {

    throw new Error(
      'Sumber header tidak valid. ' +
      'getHeaderMap_ membutuhkan Google Sheet ' +
      'atau array header.'
    );

  }


  const map = {};

  headers.forEach(
    function(header, index) {

      const key =
        String(
          header || ''
        ).trim();

      if (key) {

        map[key] =
          index;

      }

    }
  );

  return map;

}


/* =====================================================
   GENERATE NO RM
   ===================================================== */

function generateNoRM_() {

  const sheet =
    getSheetByConfig('PASIEN');

  const map =
    getHeaderMap_(sheet);

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {

    return (
      String(
        PMB_CONFIG.RM_PREFIX ||
        'PMB-'
      ) +
      '000001'
    );

  }

  const rmColumn =
    map.NO_RM + 1;

  const values =
    sheet
      .getRange(
        2,
        rmColumn,
        lastRow - 1,
        1
      )
      .getValues();

  let maxNumber = 0;

  const prefix =
    String(
      PMB_CONFIG.RM_PREFIX ||
      'PMB-'
    );


  values.forEach(
    function(row) {

      const value =
        String(
          row[0] || ''
        ).trim();

      if (!value) return;

      const number =
        parseInt(
          value.replace(
            prefix,
            ''
          ),
          10
        );

      if (
        !isNaN(number) &&
        number > maxNumber
      ) {

        maxNumber =
          number;

      }

    }
  );


  return (
    prefix +
    String(
      maxNumber + 1
    ).padStart(
      6,
      '0'
    )
  );

}


/* =====================================================
   FORMAT TANGGAL
   ===================================================== */

function formatDate_(value) {

  if (!value) {
    return '';
  }


  if (
    Object.prototype.toString.call(value) ===
    '[object Date]'
  ) {

    return Utilities.formatDate(
      value,
      PMB_CONFIG.TIMEZONE ||
        'Asia/Jakarta',
      'yyyy-MM-dd'
    );

  }


  return String(value);

}


/* =====================================================
   VALIDASI NIK
   ===================================================== */

function validateNIK_(nik) {

  nik =
    String(nik || '')
      .replace(/\D/g, '');

  if (!nik) {
    return true;
  }

  return nik.length === 16;

}


/* =====================================================
   GET DASHBOARD
   ===================================================== */

function getDashboardData(token) {

  const session =
    requireSession_(token);

  const patientSheet =
    getSheetByConfig('PASIEN');

  const visitSheet =
    getSheetByConfig('KUNJUNGAN');

  const queueSheet =
    getSheetByConfig('ANTRIAN');

  const transactionSheet =
    getSheetByConfig('TRANSAKSI');


  /* ---------------------------------------------
     PASIEN
     --------------------------------------------- */

  const patientData =
    patientSheet
      .getDataRange()
      .getValues();

  let totalPatients = 0;
  let newPatientsToday = 0;


  if (patientData.length > 1) {

    const map =
      getHeaderMap_(
        patientSheet
      );

    totalPatients =
      patientData.length - 1;

    const today =
      getTodayString_();


    for (
      let i = 1;
      i < patientData.length;
      i++
    ) {

      const created =
        formatDate_(
          patientData[i][
            map.CREATED_AT
          ]
        );

      if (
        created &&
        created.substring(0, 10) ===
          today
      ) {

        newPatientsToday++;

      }

    }

  }


  /* ---------------------------------------------
     KUNJUNGAN
     --------------------------------------------- */

  let todayVisits = 0;

  const visitData =
    visitSheet
      .getDataRange()
      .getValues();


  if (visitData.length > 1) {

    const map =
      getHeaderMap_(
        visitSheet
      );

    const today =
      getTodayString_();


    for (
      let i = 1;
      i < visitData.length;
      i++
    ) {

      const dateValue =
        formatDate_(
          visitData[i][
            map.TANGGAL
          ]
        );

      if (
        dateValue &&
        dateValue.substring(0, 10) ===
          today
      ) {

        todayVisits++;

      }

    }

  }


  /* ---------------------------------------------
     ANTRIAN
     --------------------------------------------- */

  let todayQueue = 0;

  const queueList = [];

  const queueData =
    queueSheet
      .getDataRange()
      .getValues();


  if (queueData.length > 1) {

    const map =
      getHeaderMap_(
        queueSheet
      );

    const today =
      getTodayString_();


    for (
      let i = 1;
      i < queueData.length;
      i++
    ) {

      const dateValue =
        formatDate_(
          queueData[i][
            map.TANGGAL
          ]
        );


      if (
        dateValue &&
        dateValue.substring(0, 10) ===
          today
      ) {

        todayQueue++;

        queueList.push({

          nomor:
            queueData[i][
              map.NOMOR_ANTRIAN
            ] || '',

          noRM:
            queueData[i][
              map.NO_RM
            ] || '',

          nama:
            queueData[i][
              map.NAMA_PASIEN
            ] || '',

          status:
            queueData[i][
              map.STATUS
            ] || ''

        });

      }

    }

  }


  /* ---------------------------------------------
     PENDAPATAN
     --------------------------------------------- */

  let revenueToday = 0;

  const transactionData =
    transactionSheet
      .getDataRange()
      .getValues();


  if (transactionData.length > 1) {

    const map =
      getHeaderMap_(
        transactionSheet
      );

    const today =
      getTodayString_();


    for (
      let i = 1;
      i < transactionData.length;
      i++
    ) {

      const dateValue =
        formatDate_(
          transactionData[i][
            map.TANGGAL
          ]
        );


      if (
        dateValue &&
        dateValue.substring(0, 10) ===
          today
      ) {

        revenueToday +=
          Number(
            transactionData[i][
              map.TOTAL
            ] || 0
          );

      }

    }

  }


  /* ---------------------------------------------
     PASIEN TERBARU
     --------------------------------------------- */

  const latestPatients =
    getLatestPatients_(5);


  return {

    user: {

      id:
        session.userId,

      username:
        session.username,

      name:
        session.name,

      role:
        session.role

    },

    stats: {

      totalPatients:
        totalPatients,

      newPatientsToday:
        newPatientsToday,

      todayVisits:
        todayVisits,

      todayQueue:
        todayQueue,

      revenueToday:
        revenueToday

    },

    queue:
      queueList.slice(
        0,
        10
      ),

    latestPatients:
      latestPatients

  };

}


/* =====================================================
   PASIEN
   ===================================================== */

function getLatestPatients_(limit) {

  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return [];
  }


  const map =
    getHeaderMap_(sheet);

  const result = [];


  for (
    let i = values.length - 1;
    i >= 1 &&
    result.length < limit;
    i--
  ) {

    result.push(
      patientRowToObject_(
        values[i],
        map
      )
    );

  }


  return result;

}


/* =====================================================
   PATIENT ROW TO OBJECT
   ===================================================== */

function patientRowToObject_(
  row,
  map
) {

  return {

    pasienId:
      row[map.PASIEN_ID] || '',

    noRM:
      row[map.NO_RM] || '',

    nik:
      row[map.NIK] || '',

    nama:
      row[map.NAMA_LENGKAP] || '',

    tempatLahir:
      row[map.TEMPAT_LAHIR] || '',

    tanggalLahir:
      formatDate_(
        row[map.TANGGAL_LAHIR]
      ),

    jenisKelamin:
      row[map.JENIS_KELAMIN] || '',

    alamat:
      row[map.ALAMAT] || '',

    noHP:
      row[map.NO_HP] || '',

    namaSuami:
      row[map.NAMA_SUAMI] || '',

    golonganDarah:
      row[map.GOLONGAN_DARAH] || '',

    status:
      row[map.STATUS] || '',

    catatan:
      row[map.CATATAN] || '',

    createdAt:
      formatDate_(
        row[map.CREATED_AT]
      ),

    updatedAt:
      formatDate_(
        row[map.UPDATED_AT]
      )

  };

}


/* =====================================================
   GET DATA PASIEN
   ===================================================== */

function getPatients(
  token,
  search,
  status
) {

  requireSession_(token);

  search =
    String(search || '')
      .trim()
      .toLowerCase();

  status =
    String(status || '')
      .trim()
      .toUpperCase();


  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {

    return {

      total: 0,

      data: []

    };

  }


  const map =
    getHeaderMap_(sheet);

  const result = [];


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const patient =
      patientRowToObject_(
        values[i],
        map
      );


    const searchable = [

      patient.noRM,

      patient.nik,

      patient.nama,

      patient.noHP

    ]
      .join(' ')
      .toLowerCase();


    if (
      search &&
      searchable.indexOf(search) === -1
    ) {

      continue;

    }


    if (
      status &&
      String(
        patient.status || ''
      ).toUpperCase() !==
        status
    ) {

      continue;

    }


    patient._rowNumber =
      i + 1;

    result.push(patient);

  }


  result.reverse();


  return {

    total:
      result.length,

    data:
      result

  };

}


/* =====================================================
   DETAIL PASIEN
   ===================================================== */

function getPatientDetail(
  token,
  pasienId
) {

  requireSession_(token);

  pasienId =
    String(
      pasienId || ''
    ).trim();


  if (!pasienId) {

    throw new Error(
      'ID pasien tidak ditemukan.'
    );

  }


  const patient =
    findPatientById_(
      pasienId
    );


  if (!patient) {

    throw new Error(
      'Data pasien tidak ditemukan.'
    );

  }


  const visits =
    getPatientVisits_(
      patient.noRM
    );


  return {

    patient:
      patient,

    visits:
      visits

  };

}


/* =====================================================
   FIND PATIENT BY ID
   ===================================================== */

function findPatientById_(
  pasienId
) {

  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return null;
  }


  const map =
    getHeaderMap_(sheet);


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.PASIEN_ID
        ] || ''
      ) === pasienId
    ) {

      const patient =
        patientRowToObject_(
          values[i],
          map
        );

      patient._rowNumber =
        i + 1;

      return patient;

    }

  }


  return null;

}


/* =====================================================
   RIWAYAT KUNJUNGAN
   ===================================================== */

function getPatientVisits_(
  noRM
) {

  const sheet =
    getSheetByConfig('KUNJUNGAN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return [];
  }


  const map =
    getHeaderMap_(sheet);

  const result = [];


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.NO_RM
        ] || ''
      ) !==
      String(noRM || '')
    ) {

      continue;

    }


    result.push({

      kunjunganId:
        values[i][
          map.KUNJUNGAN_ID
        ] || '',

      tanggal:
        formatDate_(
          values[i][
            map.TANGGAL
          ]
        ),

      jenisPelayanan:
        values[i][
          map.JENIS_PELAYANAN
        ] || '',

      keluhan:
        values[i][
          map.KELUHAN
        ] || '',

      status:
        values[i][
          map.STATUS
        ] || ''

    });

  }


  result.reverse();

  return result;

}


/* =====================================================
   TAMBAH PASIEN
   ===================================================== */

function addPatient(
  token,
  data
) {

  const session =
    requireSession_(token);


  if (!data) {

    throw new Error(
      'Data pasien tidak ditemukan.'
    );

  }


  const nama =
    String(
      data.nama || ''
    ).trim();


  const nik =
    String(
      data.nik || ''
    ).replace(
      /\D/g,
      ''
    );


  if (!nama) {

    throw new Error(
      'Nama lengkap wajib diisi.'
    );

  }


  if (
    nik &&
    !validateNIK_(nik)
  ) {

    throw new Error(
      'NIK harus terdiri dari 16 digit.'
    );

  }


  const sheet =
    getSheetByConfig('PASIEN');

  const map =
    getHeaderMap_(sheet);


  if (nik) {

    const values =
      sheet
        .getDataRange()
        .getValues();


    for (
      let i = 1;
      i < values.length;
      i++
    ) {

      const existingNik =
        String(
          values[i][
            map.NIK
          ] || ''
        ).replace(
          /\D/g,
          ''
        );


      if (
        existingNik &&
        existingNik === nik
      ) {

        throw new Error(
          'NIK tersebut sudah terdaftar sebagai pasien.'
        );

      }

    }

  }


  const pasienId =
    'PSN-' +
    Utilities.getUuid()
      .substring(
        0,
        8
      )
      .toUpperCase();


