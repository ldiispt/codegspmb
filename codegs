      satuan:
        row[map.SATUAN] || '',

      hargaBeli:
        Number(
          row[map.HARGA_BELI] || 0
        ),

      hargaJual:
        Number(
          row[map.HARGA_JUAL] || 0
        ),

      stok:
        Number(
          row[map.STOK] || 0
        ),

      stokMinimum:
        Number(
          row[map.STOK_MINIMUM] || 0
        ),

      lokasi:
        row[map.LOKASI] || '',

      status:
        row[map.STATUS] || 'AKTIF',

      keterangan:
        row[map.KETERANGAN] || '',

      createdAt:
        formatDate_(
          row[map.CREATED_AT]
        ),

      updatedAt:
        formatDate_(
          row[map.UPDATED_AT]
        )

    };

    const searchable = [
      obat.kodeObat,
      obat.namaObat,
      obat.kandungan,
      obat.satuan,
      obat.lokasi
    ]
      .join(' ')
      .toLowerCase();

    if (
      search &&
      searchable.indexOf(search) === -1
