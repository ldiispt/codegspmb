/* =====================================================
   SIMPAN REKAM MEDIS
   ===================================================== */

function saveMedicalRecord(
  token,
  data
) {

  const session =
    requireSession_(token);


  data =
    data || {};


  const kunjunganId =
    String(
      data.kunjunganId || ''
    ).trim();


  if (!kunjunganId) {

    throw new Error(
      'Kunjungan belum dipilih.'
    );

  }


  const anamnesis =
    String(
      data.anamnesis || ''
    ).trim();


  const tekananDarah =
    String(
      data.tekananDarah || ''
    ).trim();


  const nadi =
    String(
      data.nadi || ''
    ).trim();


  const suhu =
    String(
      data.suhu || ''
    ).trim();


  const respirasi =
    String(
      data.respirasi || ''
    ).trim();


  const beratBadan =
    String(
      data.beratBadan || ''
    ).trim();


  const tinggiBadan =
    String(
      data.tinggiBadan || ''
    ).trim();


  const pemeriksaanFisik =
    String(
      data.pemeriksaanFisik || ''
    ).trim();


  const diagnosis =
    String(
      data.diagnosis || ''
    ).trim();


  const tindakan =
    String(
      data.tindakan || ''
    ).trim();


  const catatanBidan =
    String(
      data.catatanBidan || ''
    ).trim();


  if (!anamnesis) {

    throw new Error(
      'Anamnesis wajib diisi.'
    );

  }


  if (!diagnosis) {

    throw new Error(
      'Diagnosis wajib diisi.'
    );

  }


  const lock =
    LockService.getScriptLock();


  lock.waitLock(30000);


  try {

    /* ---------------------------------------------
       CEK DUPLIKAT REKAM MEDIS
       --------------------------------------------- */

    const existing =
      findMedicalRecordByVisit_(
        kunjunganId
      );


    if (existing) {

      throw new Error(
        'Rekam medis untuk kunjungan ini sudah tersimpan.'
      );

    }


    /* ---------------------------------------------
       AMBIL DATA PEMERIKSAAN
       --------------------------------------------- */

    const dataPemeriksaan =
      getExaminationData(
        token,
        kunjunganId
      );


    if (
      !dataPemeriksaan.kunjungan
    ) {

      throw new Error(
        'Kunjungan tidak ditemukan.'
      );

    }


    /* =================================================
       PERBAIKAN V1 TAHAP 6
       SINKRONISASI STATUS KUNJUNGAN + ANTRIAN
       ================================================= */

    let statusKunjungan =
      String(
        dataPemeriksaan
          .kunjungan
          .status || ''
      )
        .trim()
        .toUpperCase();


    let statusAntrian =
      getQueueStatusByVisitId_(
        kunjunganId
      );


    /*
     * Kondisi normal:
     *
     * ANTRIAN   = DILAYANI
     * KUNJUNGAN = DILAYANI
     *
     * Tetapi jika ANTRIAN sudah DILAYANI
     * sedangkan KUNJUNGAN belum DILAYANI,
     * sistem akan memperbaiki status KUNJUNGAN.
     */

    if (
      statusAntrian === 'DILAYANI' &&
      statusKunjungan !== 'DILAYANI'
    ) {

      updateVisitStatusDirect_(
        kunjunganId,
        'DILAYANI',
        session.username || ''
      );


      statusKunjungan =
        'DILAYANI';

    }


    /*
     * Setelah sinkronisasi, pemeriksaan
     * tetap wajib berasal dari kunjungan
     * yang benar-benar DILAYANI.
     */

    if (
      statusKunjungan !==
      'DILAYANI'
    ) {

      throw new Error(
        'Pemeriksaan hanya dapat disimpan untuk kunjungan dengan status DILAYANI. ' +
        'Silakan pastikan pasien sudah berstatus DILAYANI pada menu Antrian.'
      );

    }


    /*
     * Jika status ANTRIAN tidak DILAYANI,
     * jangan memaksa penyimpanan.
     *
     * Ini menjaga alur:
     * MENUNGGU -> DIPANGGIL -> DILAYANI
     */

    if (
      statusAntrian !==
      'DILAYANI'
    ) {

      throw new Error(
        'Pasien belum berstatus DILAYANI pada Antrian. ' +
        'Silakan ubah status pasien menjadi DILAYANI terlebih dahulu.'
      );

    }


    /* ---------------------------------------------
       SHEET REKAM MEDIS
       --------------------------------------------- */

    const sheet =
      getSheetByConfig(
        'REKAM_MEDIS'
      );


    const headers =
      sheet
        .getRange(
          1,
          1,
          1,
          sheet.getLastColumn()
        )
        .getValues()[0];


    const map =
      getHeaderMap_(
        headers
      );


    const row =
      new Array(
        headers.length
      ).fill('');


    const now =
      new Date();


    const set =
      function(
        header,
        value
      ) {

        if (
          map[header] !==
          undefined
        ) {

          row[
            map[header]
          ] = value;

        }

      };


    const rekamMedisId =
      generateRekamMedisId_();


    /* ---------------------------------------------
       IDENTITAS
       --------------------------------------------- */

    set(
      'REKAM_MEDIS_ID',
      rekamMedisId
    );


    set(
      'KUNJUNGAN_ID',
      kunjunganId
    );


    set(
      'TANGGAL',
      now
    );


    set(
      'NO_RM',
      dataPemeriksaan
        .pasien
        .noRM
    );


    set(
      'PASIEN_ID',
      dataPemeriksaan
        .pasien
        .pasienId
    );


    set(
      'NAMA_PASIEN',
      dataPemeriksaan
        .pasien
        .nama
    );


    /* ---------------------------------------------
       DATA PEMERIKSAAN
       --------------------------------------------- */

    set(
      'ANAMNESIS',
      anamnesis
    );


    set(
      'TEKANAN_DARAH',
      tekananDarah
    );


    set(
      'NADI',
      nadi
    );


    set(
      'SUHU',
      suhu
    );


    set(
      'RESPIRASI',
      respirasi
    );


    set(
      'BERAT_BADAN',
      beratBadan
    );


    set(
      'TINGGI_BADAN',
      tinggiBadan
    );


    set(
      'PEMERIKSAAN_FISIK',
      pemeriksaanFisik
    );


    set(
      'DIAGNOSIS',
      diagnosis
    );


    set(
      'TINDAKAN',
      tindakan
    );


    set(
      'CATATAN_BIDAN',
      catatanBidan
    );


    /* ---------------------------------------------
       AUDIT DATA
       --------------------------------------------- */

    set(
      'CREATED_AT',
      now
    );


    set(
      'CREATED_BY',
      session.username || ''
    );


    set(
      'UPDATED_AT',
      now
    );


    set(
      'UPDATED_BY',
      session.username || ''
    );


    /* ---------------------------------------------
       SIMPAN REKAM MEDIS
       --------------------------------------------- */

    sheet.appendRow(
      row
    );


    /* =================================================
       SETELAH REKAM MEDIS BERHASIL DISIMPAN
       ================================================= */

    updateQueueStatusByVisitId_(
      kunjunganId,
      'SELESAI',
      session.username || ''
    );


    updateVisitStatusDirect_(
      kunjunganId,
      'SELESAI',
      session.username || ''
    );


    /* ---------------------------------------------
       AUDIT LOG
       --------------------------------------------- */

    writeAuditLog_(
      session.userId,
      session.username || '',
      'TAMBAH_REKAM_MEDIS',
      'REKAM_MEDIS',
      rekamMedisId,
      'Rekam medis disimpan untuk kunjungan ' +
        kunjunganId
    );


    return {

      success:
        true,

      message:
        'Rekam medis berhasil disimpan.',

      rekamMedisId:
        rekamMedisId,

      kunjunganId:
        kunjunganId,

      noRM:
        dataPemeriksaan
          .pasien
          .noRM,

      namaPasien:
        dataPemeriksaan
          .pasien
          .nama

    };


  } finally {

    lock.releaseLock();

  }

}


/* =====================================================
   UPDATE STATUS ANTRIAN BERDASARKAN KUNJUNGAN
   ===================================================== */

function updateQueueStatusByVisitId_(
  kunjunganId,
  status,
  username
) {

  const sheet =
    getSheetByConfig(
      'ANTRIAN'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length <= 1) {
    return;
  }


  const map =
    getHeaderMap_(
      values[0]
    );


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    if (
      String(
        row[
          map.KUNJUNGAN_ID
        ] || ''
      ) ===
      String(kunjunganId)
    ) {

      const rowNumber =
        i + 1;


      if (
        map.STATUS !==
        undefined
      ) {

        sheet
          .getRange(
            rowNumber,
            map.STATUS + 1
          )
          .setValue(
            status
          );

      }


      if (
        map.WAKTU_SELESAI !==
          undefined &&
        status ===
          'SELESAI'
      ) {

        sheet
          .getRange(
            rowNumber,
            map.WAKTU_SELESAI + 1
          )
          .setValue(
            new Date()
          );

      }


      if (
        map.UPDATED_AT !==
          undefined
      ) {

        sheet
          .getRange(
            rowNumber,
            map.UPDATED_AT + 1
          )
          .setValue(
            new Date()
          );

      }


      if (
        map.UPDATED_BY !==
          undefined
      ) {

        sheet
          .getRange(
            rowNumber,
            map.UPDATED_BY + 1
          )
          .setValue(
            username || ''
          );

      }


      return;

    }

  }

}


