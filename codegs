      nomorAntrian:
        antrianValues[i][antrianMap.NOMOR_ANTRIAN] || '',

      kunjunganId:
        antrianValues[i][antrianMap.KUNJUNGAN_ID] || '',

      noRM: noRM,

      pasienId:
        pasien.pasienId || '',

      nama:
        pasien.nama || '',

      jenisPelayanan:
        antrianValues[i][antrianMap.JENIS_LAYANAN] || '',

      status:
        antrianValues[i][antrianMap.STATUS] || '',

      waktuPanggil:
        antrianMap.WAKTU_PANGGIL !== undefined
          ? formatDateTime_(
              antrianValues[i][antrianMap.WAKTU_PANGGIL]
            )
          : '',

      waktuSelesai:
        antrianMap.WAKTU_SELESAI !== undefined
          ? formatDateTime_(
              antrianValues[i][antrianMap.WAKTU_SELESAI]
            )
          : '',

      _rowNumber: i + 1
    });
  }

  return result;
}

/* =====================================================
   FORMAT DATETIME
   ===================================================== */

function formatDateTime_(
  value
) {

  if (!value) {
    return '';
  }


  if (
    Object.prototype.toString.call(value) ===
      '[object Date]'
  ) {

    return Utilities.formatDate(
      value,
      PMB_CONFIG.TIMEZONE ||
        'Asia/Jakarta',
      'dd/MM/yyyy HH:mm:ss'
    );

  }


  return String(value);

}


/* =====================================================
   UPDATE STATUS ANTRIAN
   ===================================================== */

function updateQueueStatus(
  token,
  antrianId,
  status
) {

  const session =
    requireSession_(token);


  antrianId =
    String(
      antrianId || ''
    ).trim();


  status =
    String(
      status || ''
    )
      .trim()
      .toUpperCase();


  const allowed = [

    'MENUNGGU',

    'DIPANGGIL',

    'DILAYANI',

    'SELESAI',

    'BATAL'

  ];


  if (
    allowed.indexOf(status) === -1
  ) {

    throw new Error(
      'Status antrian tidak valid.'
    );

  }


  const sheet =
    getSheetByConfig(
      'ANTRIAN'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {

    throw new Error(
      'Data antrian belum tersedia.'
    );

  }


  const map =
    getHeaderMap_(sheet);


  let rowNumber = -1;

  let queue = null;


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.ANTRIAN_ID
        ] || ''
      ) ===
      antrianId
    ) {

      rowNumber =
        i + 1;


      queue = {

        nomorAntrian:
          values[i][
            map.NOMOR_ANTRIAN
          ] || '',

        noRM:
          values[i][
            map.NO_RM
          ] || '',

        nama:
          values[i][
            map.NAMA_PASIEN
          ] || '',

        status:
          values[i][
            map.STATUS
          ] || ''

      };


      break;

    }

  }


  if (rowNumber === -1) {

    throw new Error(
      'Data antrian tidak ditemukan.'
    );

  }


  const currentStatus =
    String(
      queue.status || ''
    ).toUpperCase();


  if (
    status === 'DILAYANI' &&
    currentStatus !== 'DIPANGGIL'
  ) {

    throw new Error(
      'Pasien harus dipanggil terlebih dahulu.'
    );

  }


  if (
    status === 'SELESAI' &&
    currentStatus !== 'DILAYANI'
  ) {

    throw new Error(
      'Pasien harus berstatus DILAYANI.'
    );

  }


  if (
    status === 'BATAL' &&
    (
      currentStatus ===
        'SELESAI' ||
      currentStatus ===
        'BATAL'
    )
  ) {

    throw new Error(
      'Antrian sudah selesai atau dibatalkan.'
    );

  }


  sheet
    .getRange(
      rowNumber,
      map.STATUS + 1
    )
    .setValue(status);


  if (
    status === 'DIPANGGIL' &&
    map.WAKTU_PANGGIL !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.WAKTU_PANGGIL + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    status === 'SELESAI' &&
    map.WAKTU_SELESAI !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.WAKTU_SELESAI + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    map.UPDATED_AT !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.UPDATED_AT + 1
      )
      .setValue(
        new Date()
      );

  }


  if (
    map.UPDATED_BY !==
      undefined
  ) {

    sheet
      .getRange(
        rowNumber,
        map.UPDATED_BY + 1
      )
      .setValue(
        session.username
      );

  }


  updateVisitStatusByQueue_(
    values[
      rowNumber - 1
    ][
      map.KUNJUNGAN_ID
    ],
    status
  );


  writeAuditLog_(
    session.userId,
    session.username,
    'UBAH_STATUS',
    'ANTRIAN',
    antrianId,
    'Antrian ' +
      queue.nomorAntrian +
      ' pasien ' +
      queue.nama +
      ' diubah menjadi ' +
      status
  );


  return {

    success: true,

    status:
      status

  };

}


/* =====================================================
   UPDATE STATUS KUNJUNGAN
   ===================================================== */

function updateVisitStatusByQueue_(
  kunjunganId,
  queueStatus
) {

  if (!kunjunganId) {
    return;
  }


  const sheet =
    getSheetByConfig(
      'KUNJUNGAN'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return;
  }


  const map =
    getHeaderMap_(sheet);


  let status = '';


  switch (queueStatus) {

    case 'MENUNGGU':

      status =
        'TERDAFTAR';

      break;


    case 'DIPANGGIL':

      status =
        'DIPANGGIL';

      break;


    case 'DILAYANI':

      status =
        'DILAYANI';

      break;


    case 'SELESAI':

      status =
        'SELESAI';

      break;


    case 'BATAL':

      status =
        'BATAL';

      break;

  }


  if (!status) {
    return;
  }


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.KUNJUNGAN_ID
        ] || ''
      ) ===
      String(kunjunganId)
    ) {

      sheet
        .getRange(
          i + 1,
          map.STATUS + 1
        )
        .setValue(status);

      return;

    }

  }

}


/* =====================================================
   PANGGIL PASIEN BERIKUTNYA
   ===================================================== */

function callNextQueue(
  token
) {

  requireSession_(token);


  const queue =
    getTodayQueue(token);


  const next =
    queue.find(
      function(item) {

        return (
          String(
            item.status
          ).toUpperCase() ===
            'MENUNGGU'
        );

      }
    );


  if (!next) {

    return {

      success:
        false,

      message:
        'Tidak ada pasien yang menunggu.'

    };

  }


  updateQueueStatus(
    token,
    next.antrianId,
    'DIPANGGIL'
  );


  return {

    success:
      true,

    nomorAntrian:
      next.nomorAntrian,

    nama:
      next.nama,

    noRM:
      next.noRM,

    status:
      'DIPANGGIL'

  };

}


/* =====================================================
   GET ANTRIAN AKTIF
   ===================================================== */

function getActiveQueue(
  token
) {

  const queue =
    getTodayQueue(token);


  return queue.filter(
    function(item) {

      return [

        'MENUNGGU',

        'DIPANGGIL',

        'DILAYANI'

      ].indexOf(
        String(
          item.status
        ).toUpperCase()
      ) !== -1;

    }
  );

}


