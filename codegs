/* =====================================================
   SET CELL
   ===================================================== */

function setCell_(
  row,
  index,
  value
) {

  if (
    index === undefined ||
    index === null ||
    index < 0
  ) {

    return;

  }


  row[index] =
    value === undefined ||
    value === null
      ? ''
      : value;

}


/* =====================================================
   EDIT PASIEN
   ===================================================== */

function updatePatient(
  token,
  pasienId,
  data
) {

  const session =
    requireSession_(token);


  pasienId =
    String(
      pasienId || ''
    ).trim();


  if (!pasienId) {

    throw new Error(
      'ID pasien tidak ditemukan.'
    );

  }


  const sheet =
    getSheetByConfig('PASIEN');

  const map =
    getHeaderMap_(sheet);


  const patient =
    findPatientById_(
      pasienId
    );


  if (!patient) {

    throw new Error(
      'Data pasien tidak ditemukan.'
    );

  }


  const nama =
    String(
      data.nama || ''
    ).trim();


  const nik =
    String(
      data.nik || ''
    ).replace(
      /\D/g,
      ''
    );


  if (!nama) {

    throw new Error(
      'Nama lengkap wajib diisi.'
    );

  }


  if (
    nik &&
    !validateNIK_(nik)
  ) {

    throw new Error(
      'NIK harus terdiri dari 16 digit.'
    );

  }


  if (nik) {

    const values =
      sheet
        .getDataRange()
        .getValues();


    for (
      let i = 1;
      i < values.length;
      i++
    ) {

      const rowPatientId =
        String(
          values[i][
            map.PASIEN_ID
          ] || ''
        );


      if (
        rowPatientId === pasienId
      ) {

        continue;

      }


      const existingNik =
        String(
          values[i][
            map.NIK
          ] || ''
        ).replace(
          /\D/g,
          ''
        );


      if (
        existingNik &&
        existingNik === nik
      ) {

        throw new Error(
          'NIK tersebut sudah digunakan pasien lain.'
        );

      }

    }

  }


  const rowNumber =
    patient._rowNumber;


  const range =
    sheet.getRange(
      rowNumber,
      1,
      1,
      sheet.getLastColumn()
    );


  const row =
    range.getValues()[0];


  setCell_(
    row,
    map.NIK,
    nik
  );

  setCell_(
    row,
    map.NAMA_LENGKAP,
    nama
  );

  setCell_(
    row,
    map.TEMPAT_LAHIR,
    data.tempatLahir
  );

  setCell_(
    row,
    map.TANGGAL_LAHIR,
    data.tanggalLahir
  );

  setCell_(
    row,
    map.JENIS_KELAMIN,
    data.jenisKelamin
  );

  setCell_(
    row,
    map.ALAMAT,
    data.alamat
  );

  setCell_(
    row,
    map.NO_HP,
    data.noHP
  );

  setCell_(
    row,
    map.NAMA_SUAMI,
    data.namaSuami
  );

  setCell_(
    row,
    map.GOLONGAN_DARAH,
    data.golonganDarah
  );

  setCell_(
    row,
    map.CATATAN,
    data.catatan
  );

  setCell_(
    row,
    map.UPDATED_AT,
    new Date()
  );

  setCell_(
    row,
    map.UPDATED_BY,
    session.username
  );


  range.setValues([row]);


  writeAuditLog_(
    session.userId,
    session.username,
    'EDIT',
    'PASIEN',
    pasienId,
    'Mengubah data pasien ' +
      patient.noRM
  );


  return {

    success: true,

    message:
      'Data pasien berhasil diperbarui.'

  };

}


