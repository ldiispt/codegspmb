/* =====================================================
   SESSION
   ===================================================== */

const SESSION_DURATION_SECONDS = 21600;


/* =====================================================
   CREATE SESSION
   ===================================================== */

function createSession_(user) {

  const token =
    Utilities.getUuid();

  const session = {

    token: token,

    userId:
      user.USER_ID,

    username:
      user.USERNAME,

    name:
      user.NAMA,

    role:
      user.ROLE,

    createdAt:
      new Date().toISOString()

  };

  CacheService
    .getScriptCache()
    .put(
      'PMB_SESSION_' + token,
      JSON.stringify(session),
      SESSION_DURATION_SECONDS
    );

  return token;

}


/* =====================================================
   GET SESSION
   ===================================================== */

function getSession_(token) {

  if (!token) {

    throw new Error(
      'Session tidak ditemukan.'
    );

  }

  const cache =
    CacheService.getScriptCache();

  const data =
    cache.get(
      'PMB_SESSION_' + token
    );

  if (!data) {

    throw new Error(
      'Session telah berakhir. Silakan login kembali.'
    );

  }

  return JSON.parse(data);

}


/* =====================================================
   REQUIRE SESSION
   ===================================================== */

function requireSession_(token) {

  return getSession_(token);

}


/* =====================================================
   DESTROY SESSION
   ===================================================== */

function destroySession_(token) {

  if (!token) return;

  CacheService
    .getScriptCache()
    .remove(
      'PMB_SESSION_' + token
    );

}


/* =====================================================
   HASH PASSWORD
   ===================================================== */

function hashPassword_(password) {

  const digest =
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256,
      String(password),
      Utilities.Charset.UTF_8
    );

  return digest
    .map(function(byte) {

      const value =
        byte < 0
          ? byte + 256
          : byte;

      return (
        '0' +
        value.toString(16)
      ).slice(-2);

    })
    .join('');

}


/* =====================================================
   LOGIN
   ===================================================== */

function login(
  username,
  password
) {

  username =
    String(username || '')
      .trim();

  password =
    String(password || '');

  if (
    !username ||
    !password
  ) {

    throw new Error(
      'Username dan password wajib diisi.'
    );

  }

  const sheet =
    getSheetByConfig('USERS');

  const values =
    sheet
      .getDataRange()
      .getValues();

  if (values.length < 2) {

    throw new Error(
      'Data pengguna belum tersedia.'
    );

  }

  const headers =
    values[0];

  const map = {};

  headers.forEach(
    function(header, index) {

      map[
        String(header).trim()
      ] = index;

    }
  );

  let foundUser =
    null;

  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];

    const rowUsername =
      String(
        row[map.USERNAME] || ''
      ).trim();

    if (
      rowUsername.toLowerCase() ===
      username.toLowerCase()
    ) {

      foundUser = {

        rowNumber:
          i + 1,

        USER_ID:
          row[map.USER_ID],

        USERNAME:
          row[map.USERNAME],

        PASSWORD_HASH:
          row[map.PASSWORD_HASH],

        NAMA:
          row[map.NAMA],

        ROLE:
          row[map.ROLE],

        STATUS:
          row[map.STATUS]

      };

      break;

    }

  }


  if (!foundUser) {

    writeAuditLog_(
      null,
      username,
      'LOGIN_GAGAL',
      'AUTH',
      '',
      'Username tidak ditemukan'
    );

    throw new Error(
      'Username atau password salah.'
    );

  }


  if (
    String(
      foundUser.STATUS || ''
    ).toUpperCase() !==
    'AKTIF'
  ) {

    throw new Error(
      'Akun pengguna tidak aktif.'
    );

  }


  const passwordHash =
    hashPassword_(password);

  if (
    passwordHash !==
    String(
      foundUser.PASSWORD_HASH || ''
    )
  ) {

    writeAuditLog_(
      foundUser.USER_ID,
      foundUser.USERNAME,
      'LOGIN_GAGAL',
      'AUTH',
      '',
      'Password salah'
    );

    throw new Error(
      'Username atau password salah.'
    );

  }


  const token =
    createSession_(foundUser);


  writeAuditLog_(
    foundUser.USER_ID,
    foundUser.USERNAME,
    'LOGIN',
    'AUTH',
    foundUser.USER_ID,
    'Login berhasil'
  );


  return {

    success: true,

    token: token,

    user: {

      id:
        foundUser.USER_ID,

      username:
        foundUser.USERNAME,

      name:
        foundUser.NAMA,

      role:
        foundUser.ROLE

    }

  };

}


/* =====================================================
   LOGOUT
   ===================================================== */

function logout(token) {

  let session =
    null;

  try {

    session =
      getSession_(token);

  } catch (e) {

    destroySession_(token);

    return {
      success: true
    };

  }


  writeAuditLog_(
    session.userId,
    session.username,
    'LOGOUT',
    'AUTH',
    session.userId,
    'Logout berhasil'
  );


  destroySession_(token);


  return {
    success: true
  };

}


