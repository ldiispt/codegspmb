/* =====================================================
   RIWAYAT REKAM MEDIS PASIEN
   KOMPATIBEL DENGAN STRUKTUR REKAM_MEDIS LAMA / BARU
   ===================================================== */

function getPatientMedicalHistory(
  token,
  pasienId
) {

  requireSession_(token);


  pasienId =
    String(
      pasienId || ''
    ).trim();


  if (!pasienId) {

    return [];

  }


  /* =====================================================
     AMBIL DATA PASIEN
     ===================================================== */

  const pasienSheet =
    getSheetByConfig(
      'PASIEN'
    );


  const pasienValues =
    pasienSheet
      .getDataRange()
      .getValues();


  if (
    pasienValues.length <= 1
  ) {

    return [];

  }


  const pasienMap =
    getHeaderMap_(
      pasienValues[0]
    );


  let targetNoRM =
    '';


  let targetPasienId =
    pasienId;


  /*
   * Cari pasien berdasarkan PASIEN_ID.
   * Jika struktur PASIEN tidak menggunakan PASIEN_ID,
   * gunakan NO_RM sebagai identitas.
   */

  for (
    let i = 1;
    i < pasienValues.length;
    i++
  ) {

    const row =
      pasienValues[i];


    const rowPasienId =
      pasienMap.PASIEN_ID !== undefined
        ? String(
            row[
              pasienMap.PASIEN_ID
            ] || ''
          ).trim()
        : '';


    if (
      rowPasienId &&
      rowPasienId === pasienId
    ) {

      if (
        pasienMap.NO_RM !==
        undefined
      ) {

        targetNoRM =
          String(
            row[
              pasienMap.NO_RM
            ] || ''
          ).trim();

      }

      break;

    }

  }


  /*
   * Jika tidak menemukan PASIEN_ID,
   * kemungkinan parameter yang diterima adalah NO_RM.
   */

  if (!targetNoRM) {

    if (
      pasienMap.NO_RM !==
      undefined
    ) {

      for (
        let i = 1;
        i < pasienValues.length;
        i++
      ) {

        const row =
          pasienValues[i];


        const noRM =
          String(
            row[
              pasienMap.NO_RM
            ] || ''
          ).trim();


        if (
          noRM === pasienId
        ) {

          targetNoRM =
            noRM;


          if (
            pasienMap.PASIEN_ID !==
            undefined
          ) {

            targetPasienId =
              String(
                row[
                  pasienMap.PASIEN_ID
                ] || ''
              ).trim();

          }


          break;

        }

      }

    }

  }


  /* =====================================================
     BACA REKAM MEDIS
     ===================================================== */

  const sheet =
    getSheetByConfig(
      'REKAM_MEDIS'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (
    values.length <= 1
  ) {

    return [];

  }


  const map =
    getHeaderMap_(
      values[0]
    );


  const result = [];


  /* =====================================================
     HELPER AMBIL NILAI KOLOM
     ===================================================== */

  function getValue(
    row,
    names
  ) {

    for (
      let i = 0;
      i < names.length;
      i++
    ) {

      const name =
        names[i];


      if (
        map[name] !==
        undefined
      ) {

        return row[
          map[name]
        ];

      }

    }


    return '';

  }


  /* =====================================================
     LOOP REKAM MEDIS
     ===================================================== */

  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    const rowPasienId =
      getValue(
        row,
        [
          'PASIEN_ID'
