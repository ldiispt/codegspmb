/* =====================================================
   FIND PATIENT BY ID
   ===================================================== */

function findPatientById_(
  pasienId
) {

  const sheet =
    getSheetByConfig('PASIEN');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (values.length < 2) {
    return null;
  }


  const map =
    getHeaderMap_(sheet);


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][
          map.PASIEN_ID
        ] || ''
      ) === pasienId
    ) {

      const patient =
        patientRowToObject_(
          values[i],
          map
        );

      patient._rowNumber =
        i + 1;

      return patient;

    }

  }


  return null;

}


/* =====================================================
   RIWAYAT KUNJUNGAN PASIEN
   Kompatibel dengan struktur KUNJUNGAN V1
   ===================================================== */

function getPatientVisits_(
  noRM
) {

  const sheet =
    getSheetByConfig(
      'KUNJUNGAN'
    );


  const values =
    sheet
      .getDataRange()
      .getValues();


  if (
    values.length < 2
  ) {

    return [];

  }


  const map =
    getHeaderMap_(
      sheet
    );


  const result = [];


  const targetRM =
    String(
      noRM || ''
    ).trim();


  if (!targetRM) {

    return [];

  }


  /* =====================================================
     HELPER
     Mendukung nama kolom lama dan struktur V1 sekarang
     ===================================================== */

  function getColumnValue(
    row,
    names
  ) {

    for (
      let i = 0;
      i < names.length;
      i++
    ) {

      const name =
        names[i];


      if (
        map[name] !== undefined
      ) {

        return row[
          map[name]
        ];

      }

    }


    return '';

  }


  /* =====================================================
     LOOP DATA KUNJUNGAN
     ===================================================== */

  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    const rowRM =
      String(
        getColumnValue(
          row,
          [
            'NO_RM'
          ]
        ) || ''
      ).trim();


    /*
     * Cocokkan berdasarkan NO_RM
     */

    if (
      rowRM !== targetRM
    ) {

      continue;

    }


    /* =================================================
       AMBIL DATA
       ================================================= */

    const kunjunganId =
      getColumnValue(
        row,
        [
          'KUNJUNGAN_ID'
        ]
      );


    const tanggal =
      getColumnValue(
        row,
        [
          'TANGGAL_KUNJUNGAN',
          'TANGGAL'
        ]
      );


    const jenisPelayanan =
      getColumnValue(
        row,
        [
          'JENIS_PELAYANAN',
          'JENIS_KUNJUNGAN'
        ]
      );


    const keluhan =
      getColumnValue(
        row,
        [
          'KELUHAN',
          'KELUHAN_UTAMA'
        ]
      );


    const status =
      getColumnValue(
        row,
        [
          'STATUS',
          'STATUS_KUNJUNGAN'
        ]
      );


    /* =================================================
       MASUKKAN HASIL
       ================================================= */

    result.push({

      kunjunganId:
        String(
          kunjunganId || ''
        ),


      tanggal:
        tanggal
          ? formatDate_(
              tanggal
            )
          : '',


      jenisPelayanan:
        String(
          jenisPelayanan || ''
        ),


      keluhan:
        String(
          keluhan || ''
        ),


      status:
        String(
          status || ''
        )

    });

  }


  /* =====================================================
     TERBARU DI ATAS
     ===================================================== */

  result.reverse();


  return result;

}


