/* =====================================================
   SET CELL
   ===================================================== */

function setCell_(
  row,
  index,
  value
) {

  if (
    index === undefined ||
    index === null ||
    index < 0
  ) {

    return;

  }


  row[index] =
    value === undefined ||
    value === null
      ? ''
      : value;

}


