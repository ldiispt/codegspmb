      /*
       * PELAYANAN
       */
      jenisPelayanan:
        jenisPelayanan,


      /*
       * ALIAS
       */
      pelayanan:
        jenisPelayanan,


      status:
        status

    });

  }


  /* ===================================================
     URUTKAN NOMOR ANTRIAN
     =================================================== */

  result.sort(
    function(a, b) {

      return String(
        a.nomorAntrian || ''
      ).localeCompare(
        String(
          b.nomorAntrian || ''
        ),
        undefined,
        {
          numeric: true
        }
      );

    }
  );


  return result;

}


