        .toUpperCase();


    if (
      status &&
      resepStatus !== status
    ) {

      continue;

    }


    const details =
      detailsByResep[resepId] || [];


    const searchableText = [

      resepId,

      kunjunganId,

      noRM,

      namaPasien,

      row[resepMap.DOKTER_BIDAN] || '',

      row[resepMap.CATATAN] || ''

    ]
      .join(' ')
      .toLowerCase();


    if (
      search &&
      searchableText.indexOf(search) === -1
    ) {

      continue;

    }


    let totalItem = 0;

    details.forEach(
      function(detail) {

        totalItem +=
          Number(
            detail.jumlah || 0
          );

      }
    );


    result.push({

      resepId:
        resepId,

      kunjunganId:
        kunjunganId,

      pasienId:
        pasien
          ? pasien.pasienId
          : '',

      noRM:
        noRM,

      namaPasien:
        namaPasien,

      tanggal:
        formatDate_(
          row[resepMap.TANGGAL]
        ),

      dokterBidan:
        row[
          resepMap.DOKTER_BIDAN
        ] || '',

      status:
        resepStatus,

      catatan:
        row[
          resepMap.CATATAN
        ] || '',

      jumlahJenisObat:
        details.length,

      totalItem:
        totalItem,

      detail:
        details

    });

  }


  /*
   * Terbaru di atas
   */

  result.reverse();


  return {

    total:
      result.length,

    data:
      result

  };

}


/**
 * =====================================================
 * GET DETAIL RESEP
 * =====================================================
 */
function getPrescription(
  token,
  resepId
) {

  requireSession_(token);

  resepId =
    String(
      resepId || ''
    ).trim();


  if (!resepId) {

    throw new Error(
      'ID resep tidak ditemukan.'
    );

  }


  const result =
    getPrescriptions(
      token,
      '',
      ''
    );


  for (
    let i = 0;
    i < result.data.length;
    i++
  ) {

    if (
      result.data[i].resepId ===
      resepId
    ) {

      return result.data[i];

    }

  }


  throw new Error(
    'Data resep tidak ditemukan.'
  );

}


/**
 * =====================================================
 * GET PASIEN UNTUK RESEP
 *
 * Digunakan saat membuat resep dari Pemeriksaan.
 * Hanya kunjungan yang sudah DILAYANI yang ditampilkan.
 * =====================================================
 */
function getPatientsForPrescription(
  token
) {

  requireSession_(token);


  const kunjunganSheet =
    getSheetByConfig('KUNJUNGAN');

  const antrianSheet =
    getSheetByConfig('ANTRIAN');

  const pasienSheet =
    getSheetByConfig('PASIEN');


  const kunjunganValues =
    kunjunganSheet
      .getDataRange()
      .getValues();

  const antrianValues =
    antrianSheet
      .getDataRange()
      .getValues();

  const pasienValues =
    pasienSheet
      .getDataRange()
      .getValues();


  const kunjunganMap =
    getHeaderMap_(kunjunganSheet);

  const antrianMap =
    getHeaderMap_(antrianSheet);

  const pasienMap =
    getHeaderMap_(pasienSheet);


  /*
   * ---------------------------------------------------
   * PASIEN
   * ---------------------------------------------------
   */

  const patientByRM = {};
  const patientById = {};


  for (
    let i = 1;
    i < pasienValues.length;
    i++
  ) {

    const row =
      pasienValues[i];


    const pasienId =
      pasienMap.PASIEN_ID !== undefined
        ? String(
            row[
              pasienMap.PASIEN_ID
            ] || ''
          ).trim()
        : '';


    const noRM =
      pasienMap.NO_RM !== undefined
        ? String(
            row[
              pasienMap.NO_RM
            ] || ''
          ).trim()
        : '';


    const nama =
      pasienMap.NAMA_LENGKAP !== undefined
        ? String(
            row[
              pasienMap.NAMA_LENGKAP
            ] || ''
          ).trim()
        : '';


    if (noRM) {

      patientByRM[noRM] = {

        pasienId:
          pasienId,

        noRM:
          noRM,

        nama:
          nama

      };

    }


    if (pasienId) {

      patientById[pasienId] = {

        pasienId:
          pasienId,

        noRM:
          noRM,

        nama:
          nama

      };

    }

  }


  /*
   * ---------------------------------------------------
   * STATUS ANTRIAN
   * ---------------------------------------------------
   */

  const servedByKunjungan = {};


  for (
    let i = 1;
    i < antrianValues.length;
    i++
  ) {

    const row =
      antrianValues[i];


    const kunjunganId =
      antrianMap.KUNJUNGAN_ID !== undefined
        ? String(
            row[
              antrianMap.KUNJUNGAN_ID
            ] || ''
          ).trim()
        : '';


    const status =
      antrianMap.STATUS !== undefined
        ? String(
            row[
              antrianMap.STATUS
            ] || ''
          ).trim().toUpperCase()
        : '';


    if (
      kunjunganId &&
      status === 'DILAYANI'
    ) {

      servedByKunjungan[
        kunjunganId
      ] = true;

    }

  }


  const result = [];


  /*
   * ---------------------------------------------------
   * KUNJUNGAN
   * ---------------------------------------------------
   */

  for (
    let i = 1;
    i < kunjunganValues.length;
    i++
  ) {

    const row =
      kunjunganValues[i];


    const kunjunganId =
      String(
        row[
          kunjunganMap.KUNJUNGAN_ID
        ] || ''
      ).trim();


    if (!kunjunganId) {
      continue;
    }


    /*
     * Prioritas:
     *
     * 1. ANTRIAN DILAYANI
     * 2. Jika belum ada ANTRIAN,
     *    STATUS_KUNJUNGAN DILAYANI
     */

    const kunjunganStatus =
      String(
        row[
          kunjunganMap.STATUS_KUNJUNGAN
        ] || ''
      )
        .trim()
        .toUpperCase();


    if (
      !servedByKunjungan[
        kunjunganId
      ] &&
      kunjunganStatus !== 'DILAYANI'
    ) {

      continue;

    }


    const noRM =
      String(
        row[
          kunjunganMap.NO_RM
        ] || ''
      ).trim();


    const pasienId =
      String(
        row[
          kunjunganMap.PASIEN_ID
        ] || ''
      ).trim();


    const patient =
      patientById[pasienId] ||
      patientByRM[noRM] ||
      null;


    if (!patient) {
      continue;
    }


    result.push({

      kunjunganId:
        kunjunganId,

      pasienId:
        patient.pasienId ||
        pasienId,

      noRM:
        patient.noRM ||
        noRM,

      namaPasien:
        patient.nama ||
        '',

      tanggal:
        formatDate_(
          row[
            kunjunganMap.TANGGAL_KUNJUNGAN
          ]
        ),

      jenisKunjungan:
        row[
          kunjunganMap.JENIS_KUNJUNGAN
        ] || '',

      poli:
        row[
          kunjunganMap.POLI
        ] || '',

      dokterBidan:
        row[
          kunjunganMap.DOKTER_BIDAN
        ] || '',

      keluhan:
        row[
          kunjunganMap.KELUHAN_UTAMA
        ] || '',

      status:
        'DILAYANI'

    });

  }


  result.reverse();


  return {

    total:
      result.length,

    data:
      result

  };

}


/**
 * =====================================================
 * GET DATA OBAT UNTUK RESEP
 *
 * Hanya obat AKTIF dan stok > 0.
 * =====================================================
 */
function getMedicinesForPrescription(
  token,
  search
) {

  requireSession_(token);


  search =
    String(search || '')
      .trim()
      .toLowerCase();


  const sheet =
    getSheetByConfig('OBAT');

  const values =
    sheet
      .getDataRange()
      .getValues();


  if (
    values.length < 2
  ) {

    return {

      total: 0,

      data: []

    };

  }


  const map =
    getHeaderMap_(sheet);

  const result = [];


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    const status =
      String(
        row[
          map.STATUS
        ] || ''
      )
        .trim()
        .toUpperCase();


    const stok =
      Number(
        row[
          map.STOK
        ] || 0
      );


    if (
      status !== 'AKTIF' ||
      stok <= 0
    ) {

      continue;

    }


    const kodeObat =
      String(
        row[
          map.KODE_OBAT
        ] || ''
      ).trim();


    const namaObat =
      String(
        row[
          map.NAMA_OBAT
        ] || ''
      ).trim();


    const kandungan =
      String(
        row[
          map.KANDUNGAN
        ] || ''
      ).trim();


    const searchableText = [

      kodeObat,
      namaObat,
      kandungan

    ]
      .join(' ')
      .toLowerCase();


    if (
      search &&
      searchableText.indexOf(search) === -1
    ) {

      continue;

    }


    result.push({

      obatId:
        row[
          map.OBAT_ID
        ] || '',

      kodeObat:
        kodeObat,

      namaObat:
        namaObat,

      kandungan:
        kandungan,

      satuan:
        row[
          map.SATUAN
        ] || '',

      harga:
        Number(
          row[
            map.HARGA_JUAL
          ] || 0
        ),

      stok:
        stok

    });

  }


  result.sort(
    function(a, b) {

      return String(
        a.namaObat
      ).localeCompare(
        String(
          b.namaObat
        )
      );

    }
  );


  return {

    total:
      result.length,

    data:
      result

  };

}


/**
 * =====================================================
 * SIMPAN RESEP
 * =====================================================
 *
 * data:
 * {
 *   kunjunganId,
 *   pasienId,
 *   noRM,
 *   dokterBidan,
 *   catatan,
 *   details: [
 *     {
 *       obatId,
 *       jumlah,
 *       dosis,
 *       aturanPakai,
 *       catatan
 *     }
 *   ]
 * }
 *
 * Stok BELUM dikurangi di tahap ini.
 * Stok akan dikurangi saat farmasi
 * memproses resep.
 * =====================================================
 */

/* =====================================================
   SIMPAN RESEP
   ===================================================== */

function savePrescription(token, data) {

  requireSession_(token);

  data = data || {};

  const kunjunganId =
    String(data.kunjunganId || '').trim();

  const dokterBidan =
    String(data.dokterBidan || '').trim();

  const catatan =
    String(data.catatan || '').trim();

  const details =
    Array.isArray(data.details)
      ? data.details
      : [];


  /* -----------------------------------------------------
     VALIDASI DASAR
     ----------------------------------------------------- */

  if (!kunjunganId) {
    throw new Error(
      'Kunjungan belum dipilih.'
    );
  }

  if (!details.length) {
    throw new Error(
      'Minimal harus ada 1 obat dalam resep.'
    );
  }


  /* -----------------------------------------------------
     AMBIL SHEET
     ----------------------------------------------------- */

  const kunjunganSheet =
    getSheetByConfig('KUNJUNGAN');

  const resepSheet =
    getSheetByConfig('RESEP');

  const detailSheet =
    getSheetByConfig('RESEP_DETAIL');

  const obatSheet =
    getSheetByConfig('OBAT');

  const pasienSheet =
    getSheetByConfig('PASIEN');


  if (!kunjunganSheet) {
    throw new Error(
      'Sheet KUNJUNGAN tidak ditemukan.'
    );
  }

  if (!resepSheet) {
    throw new Error(
      'Sheet RESEP tidak ditemukan.'
    );
  }

  if (!detailSheet) {
    throw new Error(
      'Sheet RESEP_DETAIL tidak ditemukan.'
    );
  }

  if (!obatSheet) {
    throw new Error(
      'Sheet OBAT tidak ditemukan.'
    );
  }


  /* -----------------------------------------------------
     HEADER MAP
     ----------------------------------------------------- */

  const kunjunganMap =
    getHeaderMap_(kunjunganSheet);

  const resepMap =
    getHeaderMap_(resepSheet);

  const detailMap =
    getHeaderMap_(detailSheet);

  const obatMap =
    getHeaderMap_(obatSheet);

  const pasienMap =
    pasienSheet
      ? getHeaderMap_(pasienSheet)
      : {};


  /* -----------------------------------------------------
     BACA KUNJUNGAN
     ----------------------------------------------------- */

  const kunjunganValues =
    kunjunganSheet.getDataRange().getValues();

  if (kunjunganValues.length < 2) {
    throw new Error(
      'Data kunjungan belum tersedia.'
    );
  }

  let kunjungan = null;

  for (
    let i = 1;
    i < kunjunganValues.length;
    i++
  ) {

    const row =
      kunjunganValues[i];

    const id =
      String(
        row[kunjunganMap.KUNJUNGAN_ID] || ''
      ).trim();

    if (id === kunjunganId) {

      kunjungan = row;

      break;
    }
  }


  if (!kunjungan) {
    throw new Error(
      'Data kunjungan tidak ditemukan.'
    );
  }


  /* -----------------------------------------------------
     AMBIL IDENTITAS PASIEN DARI KUNJUNGAN
     ----------------------------------------------------- */

  const noRM =
    kunjunganMap.NO_RM !== undefined
      ? String(
          kunjungan[kunjunganMap.NO_RM] || ''
        ).trim()
      : '';

  const pasienId =
    kunjunganMap.PASIEN_ID !== undefined
      ? String(
          kunjungan[kunjunganMap.PASIEN_ID] || ''
        ).trim()
      : '';


  if (!noRM) {

    throw new Error(
      'NO_RM pada kunjungan tidak ditemukan.'
    );

  }


  /* -----------------------------------------------------
     CARI PASIEN
     ----------------------------------------------------- */

  let namaPasien = '';

  if (pasienSheet) {

    const pasienValues =
      pasienSheet
        .getDataRange()
        .getValues();

    for (
      let i = 1;
      i < pasienValues.length;
      i++
    ) {

      const row =
        pasienValues[i];

      const rowNoRM =
        pasienMap.NO_RM !== undefined
          ? String(
              row[pasienMap.NO_RM] || ''
            ).trim()
          : '';

      const rowPasienId =
        pasienMap.PASIEN_ID !== undefined
          ? String(
              row[pasienMap.PASIEN_ID] || ''
            ).trim()
          : '';

      if (
        (pasienId && rowPasienId === pasienId) ||
        (noRM && rowNoRM === noRM)
      ) {

        if (
          pasienMap.NAMA !== undefined
        ) {

          namaPasien =
            String(
              row[pasienMap.NAMA] || ''
            ).trim();

        }

        break;
      }
    }
  }


  /* -----------------------------------------------------
     CEK RESEP AKTIF SEBELUMNYA
     ----------------------------------------------------- */

  const resepValues =
    resepSheet.getDataRange().getValues();

  for (
    let i = 1;
    i < resepValues.length;
    i++
  ) {

    const row =
      resepValues[i];

    const rowKunjunganId =
      resepMap.KUNJUNGAN_ID !== undefined
        ? String(
            row[resepMap.KUNJUNGAN_ID] || ''
          ).trim()
        : '';

    const status =
      resepMap.STATUS !== undefined
        ? String(
            row[resepMap.STATUS] || ''
          ).trim()
        : '';

    if (
      rowKunjunganId === kunjunganId &&
      status !== 'BATAL'
    ) {

      throw new Error(
        'Kunjungan ini sudah memiliki resep aktif.'
      );

    }
  }


  /* -----------------------------------------------------
     BACA OBAT
     ----------------------------------------------------- */

  const obatValues =
    obatSheet.getDataRange().getValues();

  if (obatValues.length < 2) {

    throw new Error(
      'Data obat belum tersedia.'
    );

  }


  const obatIndex = {};


  for (
    let i = 1;
    i < obatValues.length;
    i++
  ) {

    const row =
      obatValues[i];

    const obatId =
      obatMap.OBAT_ID !== undefined
        ? String(
            row[obatMap.OBAT_ID] || ''
          ).trim()
        : '';

    if (obatId) {
      obatIndex[obatId] = row;
    }
  }


  /* -----------------------------------------------------
     VALIDASI DAN SIAPKAN DETAIL
     ----------------------------------------------------- */

  const detailRows = [];

  const obatTerpakai = {};

  let totalItem = 0;
  let total = 0;


  details.forEach(function(item, index) {

    item = item || {};

    const obatId =
      String(
        item.obatId || ''
      ).trim();

    const jumlah =
      Number(item.jumlah || 0);

    const dosis =
      String(
        item.dosis || ''
      ).trim();

    const aturanPakai =
      String(
        item.aturanPakai || ''
      ).trim();

    const detailCatatan =
      String(
        item.catatan || ''
      ).trim();


    if (!obatId) {

      throw new Error(
        'Obat pada baris ' +
        (index + 1) +
        ' belum dipilih.'
      );

    }


    if (
      !isFinite(jumlah) ||
      jumlah <= 0
    ) {

      throw new Error(
        'Jumlah obat pada baris ' +
        (index + 1) +
        ' tidak valid.'
      );

    }


    if (obatTerpakai[obatId]) {

      throw new Error(
        'Obat yang sama tidak boleh dimasukkan dua kali dalam satu resep.'
      );

    }

    obatTerpakai[obatId] = true;


    const obat =
      obatIndex[obatId];


    if (!obat) {

      throw new Error(
        'Obat tidak ditemukan: ' +
        obatId
      );

    }


    const status =
      obatMap.STATUS !== undefined
        ? String(
            obat[obatMap.STATUS] || ''
          ).trim()
        : 'AKTIF';


    if (
      status &&
      status !== 'AKTIF'
    ) {

      throw new Error(
        'Obat tidak aktif: ' +
        (
          obatMap.NAMA_OBAT !== undefined
            ? obat[obatMap.NAMA_OBAT]
            : obatId
        )
      );

    }


    const stok =
      obatMap.STOK !== undefined
        ? Number(
            obat[obatMap.STOK] || 0
          )
        : 0;


    if (jumlah > stok) {

      throw new Error(
        'Stok obat tidak mencukupi untuk ' +
        (
          obatMap.NAMA_OBAT !== undefined
            ? obat[obatMap.NAMA_OBAT]
            : obatId
        ) +
        '. Stok tersedia: ' +
        stok +
        ', diminta: ' +
        jumlah
      );

    }


    const kodeObat =
      obatMap.KODE_OBAT !== undefined
        ? String(
            obat[obatMap.KODE_OBAT] || ''
          ).trim()
        : '';

    const namaObat =
      obatMap.NAMA_OBAT !== undefined
        ? String(
            obat[obatMap.NAMA_OBAT] || ''
          ).trim()
        : '';

    const satuan =
      obatMap.SATUAN !== undefined
        ? String(
            obat[obatMap.SATUAN] || ''
          ).trim()
        : '';

    const harga =
      obatMap.HARGA_JUAL !== undefined
        ? Number(
            obat[obatMap.HARGA_JUAL] || 0
          )
        : (
            obatMap.HARGA !== undefined
              ? Number(
                  obat[obatMap.HARGA] || 0
                )
              : 0
          );


    const subtotal =
      jumlah * harga;


    const detailId =
      'RSD-' +
      Utilities.getUuid()
        .replace(/-/g, '')
        .substring(0, 8)
        .toUpperCase();


    /* ---------------------------------------------------
       SIAPKAN BARIS BERDASARKAN HEADER SHEET
       --------------------------------------------------- */

    const row =
      new Array(
        detailSheet.getLastColumn()
      ).fill('');


    if (
      detailMap.RESEP_DETAIL_ID !== undefined
    ) {
      row[
        detailMap.RESEP_DETAIL_ID
      ] = detailId;
    }

    if (
      detailMap.RESEP_ID !== undefined
    ) {
      row[
        detailMap.RESEP_ID
      ] = '__RESEP_ID__';
    }

    if (
      detailMap.OBAT_ID !== undefined
    ) {
      row[
        detailMap.OBAT_ID
      ] = obatId;
    }

    if (
      detailMap.KODE_OBAT !== undefined
    ) {
      row[
        detailMap.KODE_OBAT
      ] = kodeObat;
    }

    if (
      detailMap.NAMA_OBAT !== undefined
    ) {
      row[
        detailMap.NAMA_OBAT
      ] = namaObat;
    }

    if (
      detailMap.JUMLAH !== undefined
    ) {
      row[
        detailMap.JUMLAH
      ] = jumlah;
    }

    if (
      detailMap.SATUAN !== undefined
    ) {
      row[
        detailMap.SATUAN
      ] = satuan;
    }

    if (
      detailMap.DOSIS !== undefined
    ) {
      row[
        detailMap.DOSIS
      ] = dosis;
    }

    if (
      detailMap.ATURAN_PAKAI !== undefined
    ) {
      row[
        detailMap.ATURAN_PAKAI
      ] = aturanPakai;
    }

    if (
      detailMap.CATATAN !== undefined
    ) {
      row[
        detailMap.CATATAN
      ] = detailCatatan;
    }

    if (
      detailMap.HARGA !== undefined
    ) {
      row[
        detailMap.HARGA
      ] = harga;
    }

    if (
      detailMap.SUBTOTAL !== undefined
    ) {
      row[
        detailMap.SUBTOTAL
      ] = subtotal;
    }


    detailRows.push(row);

    totalItem += jumlah;
    total += subtotal;

  });


  /* -----------------------------------------------------
     VALIDASI HEADER RESEP_DETAIL
     ----------------------------------------------------- */

  const requiredDetailHeaders = [
    'RESEP_DETAIL_ID',
    'RESEP_ID',
    'OBAT_ID',
    'JUMLAH'
  ];


  requiredDetailHeaders.forEach(
    function(header) {

      if (
        detailMap[header] === undefined
      ) {

        throw new Error(
          'Kolom ' +
          header +
          ' tidak ditemukan pada sheet RESEP_DETAIL.'
        );

      }

    }
  );


  /* -----------------------------------------------------
     BUAT ID RESEP
     ----------------------------------------------------- */

  const resepId =
    'RSP-' +
    Utilities.getUuid()
      .replace(/-/g, '')
      .substring(0, 8)
      .toUpperCase();


  const now =
    new Date();


  /* -----------------------------------------------------
     ISI RESEP_ID KE DETAIL
     ----------------------------------------------------- */

  detailRows.forEach(
    function(row) {

      row[
        detailMap.RESEP_ID
      ] = resepId;

    }
  );


  /* -----------------------------------------------------
     SIMPAN RESEP_DETAIL TERLEBIH DAHULU
     ----------------------------------------------------- */

  if (detailRows.length > 0) {

    const startRow =
      detailSheet.getLastRow() + 1;

    detailSheet
      .getRange(
        startRow,
        1,
        detailRows.length,
        detailSheet.getLastColumn()
      )
      .setValues(detailRows);

  }


  /* -----------------------------------------------------
     SIMPAN HEADER RESEP
     ----------------------------------------------------- */

  const resepRow =
    new Array(
      resepSheet.getLastColumn()
    ).fill('');


  if (
    resepMap.RESEP_ID !== undefined
  ) {
    resepRow[
      resepMap.RESEP_ID
    ] = resepId;
  }

  if (
    resepMap.KUNJUNGAN_ID !== undefined
  ) {
    resepRow[
      resepMap.KUNJUNGAN_ID
    ] = kunjunganId;
  }

  if (
    resepMap.NO_RM !== undefined
  ) {
    resepRow[
      resepMap.NO_RM
    ] = noRM;
  }

  if (
    resepMap.TANGGAL !== undefined
  ) {
    resepRow[
      resepMap.TANGGAL
    ] = now;
  }

  if (
    resepMap.DOKTER_BIDAN !== undefined
  ) {
    resepRow[
      resepMap.DOKTER_BIDAN
    ] =
      dokterBidan ||
      (
        kunjunganMap.DOKTER_BIDAN !== undefined
          ? String(
              kunjungan[
                kunjunganMap.DOKTER_BIDAN
              ] || ''
            ).trim()
          : ''
      );
  }

  if (
    resepMap.STATUS !== undefined
  ) {
    resepRow[
      resepMap.STATUS
    ] = 'MENUNGGU';
  }

  if (
    resepMap.CATATAN !== undefined
  ) {
    resepRow[
      resepMap.CATATAN
    ] = catatan;
  }

  if (
    resepMap.CREATED_AT !== undefined
  ) {
    resepRow[
      resepMap.CREATED_AT
    ] = now;
  }

  if (
    resepMap.UPDATED_AT !== undefined
  ) {
    resepRow[
      resepMap.UPDATED_AT
    ] = now;
  }


  resepSheet
    .getRange(
      resepSheet.getLastRow() + 1,
      1,
      1,
      resepRow.length
    )
    .setValues([resepRow]);


  /* -----------------------------------------------------
     AUDIT LOG
     ----------------------------------------------------- */

  try {

    writeAuditLog_(
      token,
      'RESEP',
      resepId,
      'BUAT_RESEP',
      'Membuat resep untuk pasien ' +
      (
        namaPasien ||
        noRM
      )
    );

  } catch (auditError) {

    console.warn(
      'Audit resep gagal: ' +
      auditError.message
    );

  }


  /* -----------------------------------------------------
     HASIL
     ----------------------------------------------------- */

  return {

    success: true,

    resepId: resepId,

    kunjunganId: kunjunganId,

    pasienId: pasienId,

    noRM: noRM,

    namaPasien: namaPasien,

    totalItem: totalItem,

    total: total,

    status: 'MENUNGGU',

    message:
      'Resep berhasil disimpan.'

  };

}


/**
 * =====================================================
 * UBAH STATUS RESEP
 *
 * Tahap ini BELUM mengurangi stok.
 * Stok akan diproses khusus pada tahap
 * pelayanan farmasi.
 * =====================================================
 */
function updatePrescriptionStatus(
  token,
  resepId,
  newStatus
) {

  const session =
    requireSession_(token);


  resepId =
    String(
      resepId || ''
    ).trim();


  newStatus =
    String(
      newStatus || ''
    )
      .trim()
      .toUpperCase();


  const allowedStatus = [

    'MENUNGGU',
    'DIPROSES',
    'SELESAI',
    'BATAL'

  ];


  if (!resepId) {

    throw new Error(
      'ID resep tidak ditemukan.'
    );

  }


  if (
    allowedStatus.indexOf(
      newStatus
    ) === -1
  ) {

    throw new Error(
      'Status resep tidak valid.'
    );

  }


  const sheet =
    getSheetByConfig('RESEP');

  const map =
    getHeaderMap_(sheet);

  const values =
    sheet
      .getDataRange()
      .getValues();


  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];


    const id =
      String(
        row[
          map.RESEP_ID
        ] || ''
      ).trim();


    if (
      id !== resepId
    ) {

      continue;

    }


    const oldStatus =
      String(
        row[
          map.STATUS
        ] || ''
      )
        .trim()
        .toUpperCase();


    /*
     * Jangan izinkan resep yang sudah
     * SELESAI diubah kembali.
     */

    if (
      oldStatus ===
        'SELESAI' &&
      newStatus !==
        'SELESAI'
    ) {

      throw new Error(
        'Resep yang sudah selesai tidak dapat diubah kembali.'
      );

    }


    const rowNumber =
      i + 1;


    sheet
      .getRange(
        rowNumber,
        map.STATUS + 1
      )
      .setValue(
        newStatus
      );


    sheet
      .getRange(
        rowNumber,
        map.UPDATED_AT + 1
      )
      .setValue(
        new Date()
      );


    writeAuditLog_(
      session.userId,
      session.username,
      'UBAH_STATUS',
      'RESEP',
      resepId,
      'Status resep: ' +
        oldStatus +
        ' -> ' +
        newStatus
    );


    return {

      success:
        true,

      message:
        'Status resep berhasil diubah.'

    };

  }


  throw new Error(
    'Resep tidak ditemukan.'
  );

}

