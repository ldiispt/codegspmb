/* =====================================================
   GENERATE NOMOR ANTRIAN
   ===================================================== */

function generateQueueNumber_() {

  const sheet =
    getSheetByConfig('ANTRIAN');


  const lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {

    return (

      String(
        PMB_CONFIG.QUEUE_PREFIX ||
        'A'
      ) +

      '001'

    );

  }


  const map =
    getHeaderMap_(sheet);


  const dateColumn =
    map.TANGGAL + 1;


  const numberColumn =
    map.NOMOR_ANTRIAN + 1;


  const rowCount =
    lastRow - 1;


  const dateValues =
    sheet
      .getRange(
        2,
        dateColumn,
        rowCount,
        1
      )
      .getValues();


  const numberValues =
    sheet
      .getRange(
        2,
        numberColumn,
        rowCount,
        1
      )
      .getValues();


  const today =
    getTodayString_();


  let maxNumber = 0;


  for (
    let i = 0;
    i < rowCount;
    i++
  ) {

    const dateValue =
      formatDate_(
        dateValues[i][0]
      );


    if (
      !dateValue ||
      dateValue.substring(0, 10) !==
        today
    ) {

      continue;

    }


    const numberText =
      String(
        numberValues[i][0] || ''
      );


    const numeric =
      parseInt(
        numberText.replace(
          /\D/g,
          ''
        ),
        10
      );


    if (
      !isNaN(numeric) &&
      numeric > maxNumber
    ) {

      maxNumber =
        numeric;

    }

  }


  return (

    String(
      PMB_CONFIG.QUEUE_PREFIX ||
      'A'
    ) +

    String(
      maxNumber + 1
    ).padStart(
      3,
      '0'
    )

  );

}


