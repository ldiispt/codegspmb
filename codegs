   ===================================================== */

function findTodayVisitByPatient_(noRM) {

  const sheet = getSheetByConfig('KUNJUNGAN');

  const values = sheet.getDataRange().getValues();

  if (values.length < 2) {
    return null;
  }

  const map = getHeaderMap_(sheet);
  const today = getTodayString_();

  for (let i = 1; i < values.length; i++) {

    const dateValue = formatDate_(
      values[i][map.TANGGAL_KUNJUNGAN]
    );

    const patientRM = String(
      values[i][map.NO_RM] || ''
    ).trim();

    const status = String(
      values[i][map.STATUS_KUNJUNGAN] || ''
    ).toUpperCase();

    if (
      dateValue &&
      dateValue.substring(0, 10) === today &&
      patientRM === String(noRM).trim() &&
      status !== 'BATAL'
    ) {

      const kunjunganId =
        values[i][map.KUNJUNGAN_ID] || '';

      return {
        kunjunganId: kunjunganId,
        nomorAntrian:
          getQueueNumberByVisitId_(kunjunganId)
      };
    }
  }

  return null;
}


