/* =====================================================
   GET ANTRIAN HARI INI
   ===================================================== */

function getTodayQueue(token) {

  requireSession_(token);

  const antrianSheet = getSheetByConfig('ANTRIAN');
  const pasienSheet = getSheetByConfig('PASIEN');

  const antrianValues =
    antrianSheet.getDataRange().getValues();

  const pasienValues =
    pasienSheet.getDataRange().getValues();

  if (antrianValues.length < 2) {
    return [];
  }

  const antrianMap =
    getHeaderMap_(antrianSheet);

  const pasienMap =
    getHeaderMap_(pasienSheet);

  const today = getTodayString_();

  /* INDEX PASIEN BERDASARKAN NO RM */
  const pasienByRM = {};

  for (let i = 1; i < pasienValues.length; i++) {

    const noRM = String(
      pasienValues[i][pasienMap.NO_RM] || ''
    ).trim();

    if (!noRM) continue;

    pasienByRM[noRM] = {
      pasienId:
        pasienMap.PASIEN_ID !== undefined
          ? String(
              pasienValues[i][pasienMap.PASIEN_ID] || ''
            )
          : '',

      nama:
        pasienMap.NAMA_LENGKAP !== undefined
          ? String(
              pasienValues[i][pasienMap.NAMA_LENGKAP] || ''
            )
          : ''
    };
  }

  const result = [];

  for (let i = 1; i < antrianValues.length; i++) {

    const dateValue = formatDate_(
      antrianValues[i][antrianMap.TANGGAL]
    );

    if (
      !dateValue ||
      dateValue.substring(0, 10) !== today
    ) {
      continue;
    }

    const noRM = String(
      antrianValues[i][antrianMap.NO_RM] || ''
    ).trim();

    const pasien = pasienByRM[noRM] || {};

    result.push({

      antrianId:
