   ===================================================== */

function loadFinancialReport() {

  const startDate =
    document.getElementById(
      'financialReportStartDate'
    );

  const endDate =
    document.getElementById(
      'financialReportEndDate'
    );

  const type =
    document.getElementById(
      'financialReportType'
    );

  if (
    !startDate ||
    !endDate ||
    !type
  ) {

    return;

  }


  const tanggalMulai =
    startDate.value;

  const tanggalSelesai =
    endDate.value;

  const jenis =
    type.value;


  if (!tanggalMulai || !tanggalSelesai) {

    alert(
      'Tanggal laporan wajib diisi.'
    );

    return;

  }


  if (
    tanggalMulai >
    tanggalSelesai
  ) {

    alert(
      'Tanggal mulai tidak boleh lebih besar dari tanggal selesai.'
    );

    return;

  }


  const button =
    document.getElementById(
      'btnFinancialReport'
    );


  if (button) {

    button.disabled = true;

    button.innerHTML =
      '⏳ Memuat...';

  }


  const tableContainer =
    document.getElementById(
      'financialReportTableContainer'
    );


  if (tableContainer) {

    tableContainer.innerHTML = `
      <div class="financial-report-loading">
        Memuat laporan keuangan...
      </div>
    `;

  }


  /*
   * Gunakan token session aplikasi yang sudah ada.
   */

  const token = sessionToken;


  if (!token) {

    if (button) {

      button.disabled = false;

      button.innerHTML =
        '🔍 Tampilkan';

    }

    alert(
      'Session tidak ditemukan. Silakan login kembali.'
    );

    return;

  }


  google.script.run

    .withSuccessHandler(
      function(result) {

        if (button) {

          button.disabled = false;

          button.innerHTML =
            '🔍 Tampilkan';

        }


        if (
          !result ||
          result.success !== true
        ) {

          renderFinancialReportError(
            'Laporan keuangan gagal dimuat.'
          );

          return;

        }


        financialReportData =
          Array.isArray(result.data)
            ? result.data
            : [];


        renderFinancialReport(
          result
        );

      }
    )

    .withFailureHandler(
      function(error) {

        if (button) {

          button.disabled = false;

          button.innerHTML =
            '🔍 Tampilkan';

        }


        renderFinancialReportError(
          error &&
          error.message
            ? error.message
            : 'Terjadi kesalahan saat memuat laporan.'
        );

      }
    )

    .getFinancialReport(
      token,
      tanggalMulai,
      tanggalSelesai,
      jenis
    );

}


