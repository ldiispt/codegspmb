function printMedicalHistory() {
  if (!currentMedicalHistory) return;
  const p = currentMedicalHistory.patient || {};
  const h = currentMedicalHistory.history || [];
  const win = window.open('', '_blank');
  if (!win) { showToast('Popup diblokir browser. Izinkan popup untuk mencetak.', 'error'); return; }

  const rows = h.map(function(item) { return `
