  google.script.run

    .withSuccessHandler(
      function(result) {

        renderMedicineTable(
          result || {
            total: 0,
            data: []
          }
        );

      }
    )

    .withFailureHandler(
      handleServerError
    )

    .getMedicines(
      sessionToken,
      search,
      status
    );

