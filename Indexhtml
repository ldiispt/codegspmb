/**
 * ============================================================
 * AKTIF / NONAKTIF OBAT
 * ============================================================
 */
function toggleMedicineStatus(
  obatId,
  newStatus
) {

  const action =
    newStatus === 'AKTIF'
      ? 'mengaktifkan'
      : 'menonaktifkan';


  if (
    !confirm(
      'Apakah Anda yakin ingin ' +
      action +
      ' obat ini?'
    )
  ) {

    return;

  }


  showLoading(
    'Memperbarui status obat...'
  );


  google.script.run

    .withSuccessHandler(
      function(result) {

        hideLoading();

        showToast(
          result &&
          result.message
            ? result.message
            : 'Status obat berhasil diubah.'
        );

        loadMedicines();

      }
    )

    .withFailureHandler(
      function(error) {

        hideLoading();

        handleServerError(
          error
        );

      }
    )

    .updateMedicineStatus(
      sessionToken,
      obatId,
      newStatus
    );

}

