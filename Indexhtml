  const kunjungan =
    data.kunjungan || {};

  const antrian =
    data.antrian || {};

  document.getElementById(
    'examPatientName'
  ).textContent =
    pasien.nama || '-';

  document.getElementById(
    'examPatientRM'
  ).textContent =
    pasien.noRM || '-';

  document.getElementById(
    'examPatientNIK'
  ).textContent =
    pasien.nik || '-';

  document.getElementById(
    'examPatientGender'
  ).textContent =
    pasien.jenisKelamin || '-';

  document.getElementById(
    'examPatientBirth'
  ).textContent =
    pasien.tanggalLahir || '-';

  document.getElementById(
    'examQueueNumber'
  ).textContent =
    antrian.nomorAntrian || '-';

  document.getElementById(
    'examService'
  ).textContent =
    kunjungan.jenisPelayanan || '-';

  document.getElementById(
    'examComplaint'
  ).textContent =
