            ${
              (
                (
                  String(
                    resep.status ||
                    ''
                  ).toUpperCase() ===
                  'MENUNGGU'
                ) ||
                (
                  String(
                    resep.status ||
                    ''
                  ).toUpperCase() ===
                  'DIPROSES'
                )
              )

              && semuaStokCukup

                ? `

                  <button
                    class="btn btn-success"
                    onclick="processPharmacyPrescription(
                      '${escapeAttr(
                        resep.resepId
                      )}'
                    )"
                  >
                    💊 Proses & Keluarkan Obat
                  </button>

                `

                : ''
            }


            <button
              class="btn btn-secondary"
              onclick="closePharmacyDetail()"
            >
              Tutup
            </button>

          </div>


        </div>

      </div>

    `
  );

}


/* ============================================================
 * PROSES RESEP
 * ============================================================ */

function processPharmacyPrescription(
  resepId
) {

  if (!resepId) {

    showToast(
      'ID resep tidak ditemukan.'
    );

    return;

  }


  const yakin =
    confirm(
      'Proses resep ini sekarang?\n\n' +
      'Stok obat akan dikurangi sesuai jumlah resep dan status resep menjadi SELESAI.'
    );


  if (!yakin) {
    return;
  }


  showLoading(
    'Memproses resep dan mengeluarkan obat...'
  );


  google.script.run

    .withSuccessHandler(
      function(result) {

        hideLoading();


        if (result &&
            result.success === false) {

          showToast(
            result.message ||
            'Resep gagal diproses.'
          );

          return;

        }


        closePharmacyDetail();


        showToast(
          result &&
          result.message
            ? result.message
            : 'Resep berhasil diproses.'
        );


        loadPharmacyPrescriptions();

      }
    )

    .withFailureHandler(
      function(error) {

        hideLoading();

        handleServerError(
          error
        );

      }
    )

    .processPrescription(
      sessionToken,
      resepId
    );

}


/* ============================================================
 * TUTUP DETAIL FARMASI
 * ============================================================ */

function closePharmacyDetail() {

  const modal =
    document.getElementById(
      'pharmacyDetailModal'
    );


  if (modal) {
    modal.remove();
  }

}

</script>

