function filterPaymentVisits() {

  const input =
    document.getElementById(
      'paymentVisitSearch'
    );

  const keyword =
    input
      ? String(
          input.value || ''
        )
          .trim()
          .toLowerCase()
      : '';


  if (!keyword) {

    renderPaymentVisits(
      paymentVisitData
    );

    return;

  }


  const filtered =
    paymentVisitData.filter(
      function(row) {

        return (

          String(
            row.noRM || ''
          )
            .toLowerCase()
            .includes(keyword)

          ||

          String(
            row.kunjunganId || ''
          )
            .toLowerCase()
            .includes(keyword)

          ||

          String(
            row.jenisKunjungan || ''
          )
            .toLowerCase()
            .includes(keyword)

        );

      }
    );


  renderPaymentVisits(
    filtered
  );

}

function formatPaymentCurrency(value) {

  return 'Rp ' +
    Number(
      value || 0
    ).toLocaleString(
      'id-ID'
    );

}


function renderPaymentStatus(status) {

  const value =
    String(
      status || 'BELUM_BAYAR'
    )
      .toUpperCase();


  let background =
    '#fef3c7';

  let color =
    '#92400e';


  if (value === 'LUNAS') {

    background =
      '#dcfce7';

    color =
      '#166534';

  }
  else if (
    value === 'SEBAGIAN'
  ) {

    background =
      '#dbeafe';

    color =
      '#1d4ed8';

  }


  return `
    <span style="
      display:inline-block;
      padding:5px 9px;
      border-radius:999px;
      background:${background};
      color:${color};
      font-size:12px;
      font-weight:600;
    ">
      ${value}
    </span>
  `;

}

