<!DOCTYPE html>
<html lang="id">

<head>

  <base target="_top">

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>PMB SETIAWATI</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }


    /* =================================================
       LOGIN
       ================================================= */

    #loginPage {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;

      background:
        linear-gradient(
          135deg,
          #ecfdf5,
          #f8fafc
        );
    }

    .login-card {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border-radius: 24px;
      padding: 35px;
      box-shadow:
        0 20px 60px rgba(15, 23, 42, 0.12);
    }

    .login-logo {
      width: 70px;
      height: 70px;
      border-radius: 20px;
      background: #0f766e;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 34px;
      margin: 0 auto 20px;
    }

    .login-title {
      text-align: center;
      font-size: 25px;
      font-weight: 800;
      color: #134e4a;
    }

    .login-subtitle {
      text-align: center;
      color: #64748b;
      margin-top: 6px;
      margin-bottom: 28px;
    }

    .login-error {
      display: none;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      padding: 12px 14px;
      border-radius: 12px;
      margin-bottom: 15px;
      font-size: 14px;
    }


    /* =================================================
       FORM
       ================================================= */

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
      color: #334155;
    }

    .form-control {
      width: 100%;
      border: 1px solid #dbe3ea;
      border-radius: 12px;
      padding: 12px 14px;
      outline: none;
      background: #ffffff;
      transition: 0.2s;
    }

    .form-control:focus {
      border-color: #0f766e;
      box-shadow:
        0 0 0 3px rgba(15, 118, 110, 0.10);
    }

    textarea.form-control {
      min-height: 100px;
      resize: vertical;
    }

    .btn {
      border: 0;
      border-radius: 11px;
      padding: 11px 16px;
      font-weight: 700;
      transition: 0.2s;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: #0f766e;
      color: white;
    }

    .btn-primary:hover {
      background: #115e59;
    }

    .btn-secondary {
      background: #e2e8f0;
      color: #334155;
    }

    .btn-danger {
      background: #dc2626;
      color: white;
    }

    .btn-success {
      background: #16a34a;
      color: white;
    }

    .btn-full {
      width: 100%;
    }


    /* =================================================
       APP
       ================================================= */

    #app {
      display: none;
      min-height: 100vh;
    }

    .app-layout {
      display: flex;
      min-height: 100vh;
    }


    /* =================================================
       SIDEBAR
       ================================================= */

    .sidebar {
      width: 250px;
      background: #ffffff;
      border-right: 1px solid #e5e7eb;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      overflow-y: auto;
      z-index: 100;
    }

    .brand {
      padding: 22px 20px;
      border-bottom: 1px solid #eef2f7;
    }

    .brand-title {
      color: #115e59;
      font-weight: 800;
      font-size: 19px;
    }

    .brand-subtitle {
      font-size: 11px;
      color: #64748b;
      margin-top: 4px;
    }

    .menu-section {
      padding: 18px 12px 5px;
      color: #94a3b8;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .menu-item {
      margin: 3px 10px;
      padding: 11px 13px;
      border-radius: 11px;
      display: flex;
      align-items: center;
      gap: 11px;
      color: #475569;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }

    .menu-item:hover {
      background: #f0fdfa;
      color: #0f766e;
    }

    .menu-item.active {
      background: #ccfbf1;
      color: #0f766e;
    }

    .menu-icon {
      width: 22px;
      text-align: center;
      font-size: 17px;
    }


    /* =================================================
       MAIN
       ================================================= */

    .main {
      margin-left: 250px;
      width: calc(100% - 250px);
      min-height: 100vh;
    }

    .topbar {
      height: 72px;
      background: white;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-title {
      font-size: 19px;
      font-weight: 800;
      color: #1e293b;
    }

    .user-box {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #0f766e;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }

    .user-name {
      font-size: 13px;
      font-weight: 700;
    }

    .user-role {
      font-size: 10px;
      color: #64748b;
    }

    .logout-btn {
      border: 0;
      background: transparent;
      font-size: 20px;
      margin-left: 10px;
      cursor: pointer;
    }


    /* =================================================
       CONTENT
       ================================================= */

    .content {
      padding: 28px;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 24px;
    }

    .page-title {
      font-size: 24px;
      font-weight: 800;
      margin: 0;
      color: #0f172a;
    }

    .page-description {
      color: #64748b;
      margin-top: 5px;
      font-size: 13px;
    }


    /* =================================================
       DASHBOARD
       ================================================= */

    .welcome {
      background:
        linear-gradient(
          135deg,
          #0f766e,
          #115e59
        );
      color: white;
      border-radius: 20px;
      padding: 25px;
      margin-bottom: 22px;
    }

    .welcome h2 {
      margin: 0 0 6px;
      font-size: 22px;
    }

    .welcome p {
      margin: 0;
      opacity: 0.88;
    }

    .stats-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }

    .stat-card {
      background: white;
      border: 1px solid #e8edf2;
      border-radius: 18px;
      padding: 20px;
    }

    .stat-label {
      color: #64748b;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .stat-value {
      margin-top: 10px;
      font-size: 27px;
      font-weight: 800;
      color: #0f172a;
    }

    .stat-icon {
      font-size: 22px;
      margin-bottom: 8px;
    }


    /* =================================================
       CARD
       ================================================= */

    .card {
      background: white;
      border: 1px solid #e8edf2;
      border-radius: 18px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .card-title {
      font-size: 16px;
      font-weight: 800;
      margin-bottom: 16px;
    }


    /* =================================================
       PATIENT TOOLBAR
       ================================================= */

    .toolbar {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .search-box {
      flex: 1;
      min-width: 240px;
    }


    /* =================================================
       TABLE
       ================================================= */

    .table-wrap {
      overflow-x: auto;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    th {
      background: #f8fafc;
      color: #64748b;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 13px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
    }

    td {
      padding: 13px;
      border-bottom: 1px solid #eef2f7;
      font-size: 13px;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    .rm {
      font-weight: 800;
      color: #0f766e;
    }

    .patient-name {
      font-weight: 700;
    }

    .muted {
      color: #64748b;
    }


    /* =================================================
       BADGE
       ================================================= */

    .badge {
      display: inline-flex;
      padding: 5px 9px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 800;
    }

    .badge-active {
      background: #dcfce7;
      color: #166534;
    }

    .badge-inactive {
      background: #fee2e2;
      color: #991b1b;
    }


    /* =================================================
       ACTION
       ================================================= */

    .action-group {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .btn-small {
      padding: 7px 9px;
      font-size: 11px;
      border-radius: 8px;
    }


    /* =================================================
       MODAL
       ================================================= */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal.show {
      display: flex;
    }

    .modal-box {
      width: 100%;
      max-width: 760px;
      max-height: 90vh;
      overflow-y: auto;
      background: white;
      border-radius: 20px;
      box-shadow:
        0 25px 80px rgba(15, 23, 42, 0.25);
    }

    .modal-header {
      padding: 20px 22px;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-title {
      font-size: 18px;
      font-weight: 800;
    }

    .modal-close {
      border: 0;
      background: transparent;
      font-size: 25px;
      color: #64748b;
    }

    .modal-body {
      padding: 22px;
    }

    .modal-footer {
      padding: 16px 22px;
      border-top: 1px solid #e5e7eb;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 15px;
    }

    .form-full {
      grid-column: 1 / -1;
    }


    /* =================================================
       DETAIL
       ================================================= */

    .patient-profile {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 20px;
      margin-bottom: 25px;
    }

    .patient-avatar {
      width: 90px;
      height: 90px;
      border-radius: 20px;
      background: #ccfbf1;
      color: #0f766e;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
    }

    .profile-name {
      font-size: 23px;
      font-weight: 800;
    }

    .profile-rm {
      color: #0f766e;
      font-weight: 800;
      margin-top: 5px;
    }

    .detail-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .detail-item {
      background: #f8fafc;
      border-radius: 11px;
      padding: 12px;
    }

    .detail-label {
      color: #64748b;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .detail-value {
      margin-top: 5px;
      font-size: 13px;
      font-weight: 600;
    }


    /* =================================================
       EMPTY
       ================================================= */

    .empty {
      padding: 45px 20px;
      text-align: center;
      color: #94a3b8;
    }

    .empty-icon {
      font-size: 40px;
      margin-bottom: 10px;
    }


    /* =================================================
       LOADING
       ================================================= */

    .loading {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(255,255,255,0.72);
      z-index: 5000;
      align-items: center;
      justify-content: center;
    }

    .loading.show {
      display: flex;
    }

    .loading-box {
      background: white;
      padding: 20px 25px;
      border-radius: 15px;
      box-shadow:
        0 15px 40px rgba(15,23,42,.15);
      text-align: center;
    }

    .spinner {
      width: 35px;
      height: 35px;
      border: 4px solid #d1fae5;
      border-top-color: #0f766e;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 10px;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }


    /* =================================================
       TOAST
       ================================================= */

    .toast {
      position: fixed;
      right: 25px;
      bottom: 25px;
      background: #0f172a;
      color: white;
      padding: 13px 18px;
      border-radius: 12px;
      box-shadow:
        0 15px 40px rgba(0,0,0,.2);
      display: none;
      z-index: 6000;
      font-size: 13px;
    }

    .toast.show {
      display: block;
    }


    /* =================================================
       MOBILE
       ================================================= */

    @media (max-width: 900px) {

      .sidebar {
        width: 220px;
      }

      .main {
        margin-left: 220px;
        width: calc(100% - 220px);
      }

      .stats-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }


    @media (max-width: 700px) {

      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
      }

      .app-layout {
        display: block;
      }

      .main {
        margin-left: 0;
        width: 100%;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .content {
        padding: 16px;
      }

      .topbar {
        padding: 0 16px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-full {
        grid-column: auto;
      }

      .patient-profile {
        grid-template-columns: 1fr;
      }

      .detail-grid {
        grid-template-columns: 1fr;
      }

    }

/* ============================================================
   PEMERIKSAAN
   ============================================================ */

.examination-modal-box {
  width: min(1100px, 95vw);
  max-height: 92vh;
  overflow-y: auto;
}

.examination-patient-card {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 20px;
  border-radius: 18px;
  background: #f0fdf4;
  border: 1px solid #dcfce7;
  margin-bottom: 18px;
}

.patient-avatar-large {
  width: 62px;
  height: 62px;
  min-width: 62px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dcfce7;
  font-size: 28px;
}

.patient-main-info {
  flex: 1;
}

.patient-main-info h3 {
  margin: 0 0 8px;
  font-size: 20px;
}

.patient-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  color: #64748b;
  font-size: 13px;
  margin-top: 5px;
}

.patient-meta strong {
  color: #334155;
}

.exam-queue-number {
  text-align: center;
  min-width: 90px;
  padding: 12px;
  border-radius: 15px;
  background: #fff;
  border: 1px solid #bbf7d0;
}

.exam-queue-number small {
  display: block;
  color: #64748b;
  font-size: 11px;
}

.exam-queue-number strong {
  display: block;
  font-size: 28px;
  color: #166534;
  margin-top: 4px;
}

.exam-visit-info {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 15px;
  padding: 16px;
  margin-bottom: 22px;
  background: #f8fafc;
  border-radius: 15px;
}

.exam-visit-info label {
  display: block;
  font-size: 12px;
  color: #64748b;
  margin-bottom: 5px;
}

.exam-visit-info strong {
  display: block;
  color: #334155;
}

.form-section-title {
  font-weight: 700;
  font-size: 15px;
  margin: 24px 0 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e2e8f0;
}

.vital-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.vital-grid .form-group {
  position: relative;
}

.vital-grid small {
  display: block;
  margin-top: 4px;
  color: #94a3b8;
  font-size: 11px;
}

.required {
  color: #dc2626;
}

@media (max-width: 700px) {

  .examination-patient-card {
    flex-wrap: wrap;
  }

  .patient-main-info {
    min-width: calc(100% - 85px);
  }

  .exam-queue-number {
    width: 100%;
  }

  .exam-visit-info {
    grid-template-columns: 1fr;
  }

  .vital-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 450px) {

  .vital-grid {
    grid-template-columns: 1fr;
  }
}
  

/* =================================================
   V1 TAHAP 6 - REKAM MEDIS
   ================================================= */
.medical-history-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
.medical-patient-card{display:flex;align-items:center;justify-content:space-between;gap:18px;background:#f0fdfa;border:1px solid #ccfbf1;border-radius:16px;padding:18px;margin-bottom:18px}
.medical-patient-main{display:flex;align-items:center;gap:15px}
.medical-patient-avatar{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#ccfbf1;font-size:25px}
.medical-history-list{display:grid;gap:12px}
.medical-history-item{border:1px solid #e5e7eb;border-radius:15px;padding:16px;background:#fff}
.medical-history-item:hover{border-color:#99f6e4;box-shadow:0 8px 22px rgba(15,118,110,.06)}
.medical-history-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}
.medical-history-date{font-weight:800;color:#0f766e}
.medical-history-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.medical-field{background:#f8fafc;border-radius:10px;padding:10px}
.medical-field-label{font-size:10px;color:#64748b;font-weight:800;text-transform:uppercase}
.medical-field-value{margin-top:4px;font-size:13px;white-space:pre-wrap;line-height:1.55}
.medical-detail-section{margin-top:18px}
.medical-detail-section h4{margin:0 0 10px;font-size:14px;color:#115e59}
.medical-detail-box{background:#f8fafc;border-radius:12px;padding:13px;white-space:pre-wrap;line-height:1.6;font-size:13px}
.medical-print-header{display:none}
@media(max-width:700px){
 .medical-patient-card{align-items:flex-start;flex-direction:column}
 .medical-history-grid{grid-template-columns:1fr}
}

  </style>

</head>


<body>


<!-- =====================================================
     LOGIN
     ===================================================== -->

<div id="loginPage">

  <div class="login-card">

    <div class="login-logo">
      🩺
    </div>

    <div class="login-title">
      PMB SETIAWATI
    </div>

    <div class="login-subtitle">
      Sistem Informasi Praktik Mandiri Bidan
    </div>

    <div
      id="loginError"
      class="login-error"
    ></div>

    <form
      onsubmit="handleLogin(event)"
    >

      <div class="form-group">

        <label class="form-label">
          Username
        </label>

        <input
          id="loginUsername"
          class="form-control"
          autocomplete="username"
          required
        >

      </div>


      <div class="form-group">

        <label class="form-label">
          Password
        </label>

        <input
          id="loginPassword"
          class="form-control"
          type="password"
          autocomplete="current-password"
          required
        >

      </div>


      <button
        type="submit"
        class="btn btn-primary btn-full"
      >
        🔐 Masuk
      </button>

    </form>

  </div>

</div>


<!-- =====================================================
     APP
     ===================================================== -->

<div id="app">

  <div class="app-layout">


    <!-- SIDEBAR -->

    <aside class="sidebar">

      <div class="brand">

        <div class="brand-title">
          🩺 PMB SETIAWATI
        </div>

        <div class="brand-subtitle">
          Sistem Informasi Praktik Mandiri Bidan
        </div>

      </div>


      <div class="menu-section">
        Utama
      </div>

      <div
        class="menu-item active"
        onclick="showPage('dashboard', this)"
      >
        <span class="menu-icon">🏠</span>
        Dashboard
      </div>


      <div class="menu-section">
        Pelayanan
      </div>

      <div
        class="menu-item"
        onclick="showPage('pasien', this)"
      >
        <span class="menu-icon">👥</span>
        Data Pasien
      </div>

      <div
        class="menu-item"
        onclick="showPage('pendaftaran', this)"
      >
        <span class="menu-icon">📝</span>
        Pendaftaran
      </div>

 

      <div
        class="menu-item"
        onclick="showPage('antrian', this)"
      >
