function queueStatusBadge(
  status
) {

  const value =
    String(status || '')
      .toUpperCase();

  const styles = {

    MENUNGGU:
      'background:#fef3c7;color:#92400e',

    DIPANGGIL:
      'background:#dbeafe;color:#1d4ed8',

    DILAYANI:
      'background:#dcfce7;color:#166534',

    SELESAI:
      'background:#e2e8f0;color:#475569',

    BATAL:
      'background:#fee2e2;color:#991b1b'

  };

  return `

    <span
      class="badge"
      style="${styles[value] || ''}"
    >
      ${escapeHTML(value)}
