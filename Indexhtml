                <label class="form-label">
                  Nama Item *
                </label>

                <input
                  class="form-control"
                  value="${escapeAttr(
                    item.namaItem
                  )}"
                  oninput="updateTransactionItem(
                    ${index},
                    'namaItem',
                    this.value
                  )"
                  placeholder="Contoh: Pemeriksaan ANC"
                >

              </div>


              <div class="form-group">

                <label class="form-label">
                  Jenis Item
                </label>

                <input
                  class="form-control"
                  value="${escapeAttr(
                    item.jenisItem
                  )}"
