      transaksiId =
        transaksiIdElement.textContent
          .trim();

    }

  }


  /* =====================================================
     DATA PEMBAYARAN
     ===================================================== */

  const pembayaranId =
    String(
      payment.pembayaranId ||
      '-'
    );


  const tanggal =
    payment.tanggal ||
    payment.createdAt ||
    '-';


  const metodeBayar =
    String(
      payment.metodeBayar ||
      '-'
    );


  const jumlahBayar =
    Number(
      payment.jumlahBayar ||
      0
    );


  const kembalian =
    Number(
      payment.kembalian ||
      0
    );


  let jumlahEfektif =
    payment.jumlahEfektif;


  if (
    jumlahEfektif === undefined ||
    jumlahEfektif === null ||
    jumlahEfektif === ''
  ) {

    jumlahEfektif =
      jumlahBayar -
      kembalian;

  }


  jumlahEfektif =
    Number(
      jumlahEfektif || 0
    );


  const referensi =
    String(
      payment.referensi ||
      '-'
    );


  const dibayarOleh =
    String(
      payment.dibayarOleh ||
      '-'
    );


  const status =
    String(
      payment.status ||
