      .trim()
      .toUpperCase();


  if (
    value === 'MENUNGGU'
  ) {

    return `

      <span
        class="badge badge-warning"
      >
        MENUNGGU
      </span>

    `;

  }


  if (
    value === 'DIPROSES'
  ) {

    return `

      <span
        class="badge badge-info"
      >
        DIPROSES
      </span>

    `;

  }


  if (
    value === 'SELESAI'
  ) {

    return `

      <span
        class="badge badge-active"
      >
        SELESAI
      </span>

    `;

  }


  if (
    value === 'BATAL'
  ) {

    return `

      <span
        class="badge badge-inactive"
      >
        BATAL
      </span>

    `;

  }


  return `

    <span class="badge">
      ${escapeHTML(
        value || '-'
      )}
    </span>

  `;

}


