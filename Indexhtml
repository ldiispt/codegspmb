/* =====================================================
   ERROR
   ===================================================== */

function renderFinancialReportError(
  message
) {

  const container =
    document.getElementById(
      'financialReportTableContainer'
    );


  if (!container) {

    return;

  }


  container.innerHTML = `

    <div class="financial-report-error">

      ⚠️
      ${escapeFinancialHtml(
        message
      )}

    </div>

  `;

}


/* =====================================================
   FORMAT RUPIAH
   ===================================================== */

function formatFinancialCurrency(
  value
) {

  return (
    'Rp' +
    Number(
      value || 0
    ).toLocaleString(
      'id-ID'
    )
  );

}


/* =====================================================
   FORMAT TANGGAL
   ===================================================== */

function formatFinancialDate(
  value
) {

  if (!value) {

    return '-';

  }


  const text =
    String(value);


  const match =
    text.match(
      /^(\d{4})-(\d{2})-(\d{2})/
    );


  if (match) {

    return (
      match[3] +
      '/' +
      match[2] +
      '/' +
      match[1]
    );

  }


  return escapeFinancialHtml(
    text
  );

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeFinancialHtml(
  value
) {

  return String(
    value == null
      ? ''
      : value
  )
    .replace(
      /&/g,
      '&amp;'
    )
    .replace(
      /</g,
      '&lt;'
    )
    .replace(
      />/g,
      '&gt;'
    )
    .replace(
      /"/g,
      '&quot;'
    )
    .replace(
      /'/g,
      '&#039;'
    );

}

