function calculatePaymentChange() {

  const method =
    document.getElementById(
      'paymentMethod'
    );

  const amount =
    document.getElementById(
      'paymentAmount'
    );

  const change =
    document.getElementById(
      'paymentChange'
    );

  if (!method || !amount || !change) {
    return;
  }


  const metode =
    String(
      method.value || ''
    ).trim()
    .toUpperCase();


  const jumlah =
    Number(
      amount.value || 0
    );


  const sisaText =
    document.querySelector(
      '#paymentChangeBox strong'
    );


  let sisa = 0;

  if (sisaText) {

    const text =
      sisaText.textContent
        .replace(/[^\d]/g, '');

    sisa =
      Number(text || 0);
  }


  let kembalian = 0;


  if (
    metode === 'TUNAI' &&
    jumlah > sisa
  ) {

    kembalian =
      jumlah - sisa;

  }


  change.textContent =
    formatPaymentCurrency(
      kembalian
    );

}

