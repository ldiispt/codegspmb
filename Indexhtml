    'examTemperature'
  ).value =
    rm ? rm.suhu || '' : '';

  document.getElementById(
    'examRespiration'
  ).value =
    rm ? rm.respirasi || '' : '';

  document.getElementById(
    'examWeight'
  ).value =
    rm ? rm.beratBadan || '' : '';

  document.getElementById(
    'examHeight'
  ).value =
    rm ? rm.tinggiBadan || '' : '';

  document.getElementById(
    'examPhysical'
  ).value =
    rm ? rm.pemeriksaanFisik || '' : '';

  document.getElementById(
    'examDiagnosis'
  ).value =
    rm ? rm.diagnosis || '' : '';

  document.getElementById(
    'examAction'
  ).value =
    rm ? rm.tindakan || '' : '';

