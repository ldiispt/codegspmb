                    ${index},
                    'jenisItem',
                    this.value
                  )"
                  placeholder="Pemeriksaan / Obat / ATK..."
                >

              </div>


              <div class="form-group">

                <label class="form-label">
                  Qty
                </label>

                <input
                  class="form-control"
                  type="number"
                  min="1"
                  value="${item.qty}"
                  oninput="updateTransactionItem(
                    ${index},
                    'qty',
                    this.value
                  )"
                >

              </div>


              <div class="form-group">

                <label class="form-label">
                  Harga
                </label>

                <input
                  class="form-control"
                  type="number"
                  min="0"
                  value="${item.harga}"
                  oninput="updateTransactionItem(
                    ${index},
                    'harga',
                    this.value
                  )"
                >

              </div>


              <div class="form-group">

                <label class="form-label">
                  Diskon Item
                </label>

                <input
                  class="form-control"
                  type="number"
                  min="0"
                  value="${item.diskon}"
                  oninput="updateTransactionItem(
                    ${index},
                    'diskon',
                    this.value
                  )"
                >

              </div>


              <div
                class="form-group"
                style="
                  display:flex;
                  align-items:flex-end;
                "
              >

                <button
                  class="btn btn-danger"
                  onclick="removeTransactionItem(
                    ${index}
                  )"
                  ${
                    transactionItems.length === 1
                      ? 'disabled'
                      : ''
                  }
                >
                  🗑️ Hapus
                </button>

              </div>

            </div>


            <div
              style="
                text-align:right;
                font-weight:700;
                margin-top:10px;
              "
            >

              Subtotal:
              ${formatRupiah(
                Math.max(
                  0,
                  Number(item.qty || 0) *
                  Number(item.harga || 0) -
                  Number(item.diskon || 0)
                )
              )}

            </div>

          </div>

        `;

      }
    ).join('');


  calculateTransactionTotal();

}


/* ============================================================
 * UPDATE ITEM
 * ============================================================ */
function updateTransactionItem(
  index,
  field,
  value
) {

  if (
    !transactionItems[index]
  ) {
    return;
  }


  if (
    field === 'qty' ||
    field === 'harga' ||
    field === 'diskon'
  ) {

    transactionItems[index][field] =
      Number(value || 0);

  } else {

    transactionItems[index][field] =
      value;

  }


  renderTransactionItems();

}


/* ============================================================
 * REMOVE ITEM
 * ============================================================ */
function removeTransactionItem(
  index
) {

  if (
    transactionItems.length <= 1
  ) {
    return;
  }


  transactionItems.splice(
    index,
    1
  );


  renderTransactionItems();

}


/* ============================================================
 * CALCULATE TOTAL
 * ============================================================ */
function calculateTransactionTotal() {

  let total = 0;


  transactionItems.forEach(
    function(item) {

      total += Math.max(
        0,
        Number(item.qty || 0) *
        Number(item.harga || 0) -
        Number(item.diskon || 0)
      );

    }
  );


  const diskon =
    Number(
      document.getElementById(
        'transactionFormDiskon'
      )?.value || 0
    );


  const grandTotal =
    Math.max(
      0,
      total - diskon
    );


  const totalEl =
    document.getElementById(
      'transactionFormTotal'
    );

  const grandTotalEl =
    document.getElementById(
      'transactionFormGrandTotal'
    );


  if (totalEl) {

    totalEl.textContent =
      formatRupiah(
        total
      );

  }


  if (grandTotalEl) {

    grandTotalEl.textContent =
      formatRupiah(
        grandTotal
      );

  }

}


