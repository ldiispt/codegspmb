/* =====================================================
   SECURITY / HTML ESCAPE
   ===================================================== */

function escapeHTML(
  value
) {

  return String(
    value === undefined ||
    value === null
      ? ''
      : value
  )
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}


function escapeAttr(
  value
) {

  return escapeHTML(value);
}

