  error
) {

  console.error(error);

  const message =
    error &&
    error.message
      ? error.message
      : 'Terjadi kesalahan pada server.';

  if (
    message.toLowerCase()
      .includes('session')
  ) {

    clearSession();

    showLogin();

    showLoginError(
      'Session telah berakhir. Silakan login kembali.'
    );

    return;
  }

  showToast(message);
