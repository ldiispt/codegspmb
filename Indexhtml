   ===================================================== */

function savePatient() {

  const nama =
    document.getElementById(
      'patientNama'
    ).value.trim();

  const nik =
    document.getElementById(
      'patientNik'
    ).value
      .replace(/\D/g, '');

  if (!nama) {

    showToast(
      'Nama lengkap wajib diisi.'
    );

