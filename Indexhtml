function selectRegistrationPatientByIndex(
  index
) {

  const patient =
    registrationPatientsCache[
      Number(index)
    ];

  if (!patient) {
    showToast('Data pasien tidak ditemukan.');
    return;
  }

  const pasienId =
    getRegistrationPatientId(patient);

  console.log(
    'Pasien dipilih:',
    patient,
    'ID:',
    pasienId
  );

  if (!pasienId) {
    showToast(
      'ID Pasien tidak tersedia pada data pasien. Silakan periksa data pasien.'
    );
    return;
  }

  selectedRegistrationPatientId =
    pasienId;

  document.getElementById(
    'registrationPatientId'
  ).value =
    pasienId;

  showLoading(
    'Memuat data pasien...'
  );

  google.script.run

    .withSuccessHandler(function(result) {

      hideLoading();

      const selectedPatient =
        result || patient;

      const confirmedId =
        getRegistrationPatientId(
          selectedPatient
        ) || pasienId;

      selectedRegistrationPatientId =
        confirmedId;

      document.getElementById(
        'registrationPatientId'
      ).value =
        confirmedId;

      document.getElementById(
        'selectedPatientName'
      ).textContent =
        selectedPatient.nama ||
        patient.nama ||
        '';

      document.getElementById(
        'selectedPatientInfo'
      ).textContent =
        (selectedPatient.noRM ||
          patient.noRM || '-') +
        ' · ' +
        (
          selectedPatient.nik ||
          patient.nik ||
          'NIK belum diisi'
        ) +
        ' · ' +
        (
          selectedPatient.noHP ||
          patient.noHP ||
          'HP belum diisi'
        );

      document.getElementById(
        'selectedPatientBox'
      ).style.display =
        'block';

      document.getElementById(
        'selectedPatientBox'
      ).setAttribute(
        'data-pasien-id',
        confirmedId
      );

      document.getElementById(
        'registrationPatientResults'
      ).innerHTML = '';

      document.getElementById(
        'registrationSearch'
      ).value =
        selectedPatient.nama ||
        patient.nama ||
        '';

    })

    .withFailureHandler(function(error) {

      hideLoading();

      /*
       * Jangan menghapus ID yang sudah dipilih hanya karena
       * pemanggilan detail pasien gagal. Data hasil pencarian
       * tetap valid dan dapat dipakai saat submit.
       */
      selectedRegistrationPatientId =
        pasienId;

      document.getElementById(
        'registrationPatientId'
      ).value =
        pasienId;

      document.getElementById(
        'selectedPatientName'
      ).textContent =
        patient.nama || '';

      document.getElementById(
        'selectedPatientInfo'
      ).textContent =
        (patient.noRM || '-') +
        ' · ' +
        (patient.nik || 'NIK belum diisi') +
        ' · ' +
        (patient.noHP || 'HP belum diisi');

      document.getElementById(
        'selectedPatientBox'
      ).style.display =
        'block';

      document.getElementById(
        'selectedPatientBox'
      ).setAttribute(
        'data-pasien-id',
        pasienId
      );

      document.getElementById(
        'registrationPatientResults'
      ).innerHTML = '';

      document.getElementById(
        'registrationSearch'
      ).value =
        patient.nama || '';

      console.error(error);

    })

    .getPatientForRegistration(
      sessionToken,
      pasienId
    );
}


