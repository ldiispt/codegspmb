);


/**
 * Simpan pemeriksaan
 */
function submitExamination() {

  if (
    !currentExaminationVisit ||
    !currentExaminationVisit.kunjunganId
  ) {
    showToast(
      'Kunjungan tidak ditemukan.',
      'error'
    );

    return;
  }


  const anamnesis =
    document.getElementById(
      'examAnamnesis'
    ).value.trim();

  const diagnosis =
    document.getElementById(
      'examDiagnosis'
    ).value.trim();


  if (!anamnesis) {

    showToast(
      'Anamnesis wajib diisi.',
      'error'
    );

    document.getElementById(
      'examAnamnesis'
    ).focus();

    return;
  }


  if (!diagnosis) {

    showToast(
      'Diagnosis wajib diisi.',
      'error'
    );

    document.getElementById(
      'examDiagnosis'
    ).focus();

    return;
  }


  const button =
    document.getElementById(
      'saveExaminationButton'
    );

  if (button) {

    button.disabled = true;

    button.innerHTML =
      '⏳ Menyimpan...';
  }


  const data = {

    kunjunganId:
      currentExaminationVisit.kunjunganId,

    anamnesis:
      anamnesis,

    tekananDarah:
      document.getElementById(
        'examBloodPressure'
      ).value.trim(),

    nadi:
      document.getElementById(
        'examPulse'
      ).value.trim(),

    suhu:
      document.getElementById(
        'examTemperature'
      ).value.trim(),

    respirasi:
      document.getElementById(
        'examRespiration'
      ).value.trim(),

    beratBadan:
      document.getElementById(
        'examWeight'
      ).value.trim(),

    tinggiBadan:
      document.getElementById(
        'examHeight'
      ).value.trim(),

    pemeriksaanFisik:
      document.getElementById(
        'examPhysical'
      ).value.trim(),

    diagnosis:
      diagnosis,

    tindakan:
      document.getElementById(
        'examAction'
      ).value.trim(),

    catatanBidan:
      document.getElementById(
        'examMidwifeNotes'
      ).value.trim()
  };


  google.script.run

    .withSuccessHandler(function(result) {

      if (button) {

        button.disabled = false;

        button.innerHTML =
          '💾 Simpan Rekam Medis';
      }

      closeExaminationModal();

      showToast(
        'Rekam medis berhasil disimpan. Kunjungan selesai.',
        'success'
      );

      loadExaminationPage();

      /*
       * Dashboard juga diperbarui.
       */
      if (
        typeof loadDashboard ===
        'function'
      ) {
        loadDashboard();
      }

    })

    .withFailureHandler(function(error) {

      if (button) {

        button.disabled = false;

        button.innerHTML =
          '💾 Simpan Rekam Medis';
      }

      handleServerError(error);

    })

    .saveMedicalRecord(
      sessionToken,
      data
    );
}


