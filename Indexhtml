function selectPrescriptionVisit(
  kunjunganId
) {

  google.script.run

    .withSuccessHandler(
      function(result) {

        /*
         * Backend mengembalikan daftar.
         * Cari KUNJUNGAN_ID yang dipilih.
         */

        const data =
          result &&
          Array.isArray(result.data)
            ? result.data
            : [];


        const selected =
          data.find(
            function(item) {

              return (
                String(
                  item.kunjunganId
                ) ===
                String(
                  kunjunganId
                )
              );

            }
          );


        if (!selected) {

          showToast(
            'Kunjungan tidak ditemukan.'
          );

          return;

        }


        setPrescriptionVisit(
          selected
        );

      }
    )

    .withFailureHandler(
      handleServerError
    )

    .getPatientsForPrescription(
      sessionToken
    );

}


