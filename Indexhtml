      .trim()
      .toUpperCase();


  let label =
    value || '-';


  if (
    value === 'MENUNGGU'
  ) {

    return `
      <span
        class="badge badge-warning"
      >
        MENUNGGU
      </span>
    `;

  }


  if (
    value === 'DIPROSES'
  ) {

    return `
      <span
        class="badge badge-info"
      >
        DIPROSES
      </span>
    `;

  }


  if (
    value === 'SELESAI'
  ) {

    return `
      <span
        class="badge badge-success"
      >
        SELESAI
      </span>
    `;

  }


  if (
    value === 'BATAL'
  ) {

    return `
      <span
        class="badge badge-danger"
      >
        BATAL
      </span>
    `;

  }


  return `
    <span class="badge">
      ${escapeHTML(label)}
    </span>
  `;

}


