 * ============================================================ */

function changePrescriptionStatus(
  resepId,
  newStatus
) {

  let message =
    'Apakah Anda yakin ingin mengubah status resep menjadi ' +
    newStatus +
    '?';


  if (
    newStatus === 'BATAL'
  ) {

    message =
      'Batalkan resep ini?';

  }


  if (
    !confirm(
      message
    )
  ) {

    return;

  }


  showLoading(
    'Memperbarui status resep...'
  );


  google.script.run

    .withSuccessHandler(
      function(result) {

        hideLoading();


        showToast(
          result &&
          result.message
            ? result.message
            : 'Status resep berhasil diubah.'
        );


        closePrescriptionDetail();


        loadPrescriptions();

      }
    )

    .withFailureHandler(
      function(error) {

        hideLoading();

        handleServerError(
          error
        );

      }
    )

    .updatePrescriptionStatus(
      sessionToken,
      resepId,
      newStatus
    );

}


