function loadPatientStatistics() {

  google.script.run

    .withSuccessHandler(function(data) {

      document.getElementById(
        'patientStatTotal'
      ).textContent =
        formatNumber(
          data.total || 0
        );


      document.getElementById(
        'patientStatActive'
      ).textContent =
        formatNumber(
          data.aktif || 0
        );


      document.getElementById(
        'patientStatMale'
      ).textContent =
        formatNumber(
          data.lakiLaki || 0
        );


      document.getElementById(
        'patientStatFemale'
      ).textContent =
        formatNumber(
          data.perempuan || 0
        );


      document.getElementById(
        'patientStatNew'
      ).textContent =
        formatNumber(
          data.baruBulanIni || 0
        );

    })

    .withFailureHandler(function(error) {

      console.error(
        'Gagal memuat statistik pasien:',
        error
      );

    })

    .getPatientStatistics(
      sessionToken
    );

}


/* =====================================================
   LOAD PATIENTS
   ===================================================== */

function loadPatients() {

  const search =
    document.getElementById(
      'patientSearch'
    )?.value || '';

  const status =
    document.getElementById(
      'patientStatusFilter'
    )?.value || '';

  document.getElementById(
    'patientTable'
  ).innerHTML = `

    <div class="empty">

      <div class="spinner"></div>

      Memuat data pasien...

    </div>

  `;

  google.script.run

    .withSuccessHandler(function(result) {

      renderPatients(
        result.data || []
      );

    })

    .withFailureHandler(function(error) {

      handleServerError(error);

    })

    .getPatients(
      sessionToken,
      search,
      status
    );
}


function searchPatientsDelayed() {

  clearTimeout(
    patientSearchTimer
  );

  patientSearchTimer =
    setTimeout(
      loadPatients,
      350
    );
}


/* =====================================================
   RENDER PATIENTS
   ===================================================== */

function renderPatients(
  patients
) {

  if (!patients.length) {

    document.getElementById(
      'patientTable'
    ).innerHTML = `

      <div class="empty">

        <div class="empty-icon">
          👥
        </div>

        <div>
          Data pasien tidak ditemukan.
        </div>

      </div>

    `;

    return;
  }


  document.getElementById(
    'patientTable'
  ).innerHTML = `

    <div class="table-wrap">

      <table>

        <thead>

          <tr>

            <th>No. RM</th>
            <th>NIK</th>
            <th>Nama Pasien</th>
            <th>Jenis Kelamin</th>
            <th>No. HP</th>
            <th>Status</th>
            <th>Aksi</th>

          </tr>

        </thead>


        <tbody>

          ${patients.map(function(patient) {

            return `

              <tr>

                <td class="rm">
                  ${escapeHTML(patient.noRM)}
                </td>

                <td>
                  ${escapeHTML(patient.nik || '-')}
                </td>

                <td>

                  <div class="patient-name">
                    ${escapeHTML(patient.nama)}
                  </div>

                  <div class="muted">
                    ${escapeHTML(
                      patient.tempatLahir || ''
                    )}
                    ${patient.tanggalLahir
                      ? ', ' +
                        escapeHTML(
                          patient.tanggalLahir
                        )
                      : ''}
                  </div>

                </td>

                <td>
                  ${escapeHTML(
                    patient.jenisKelamin || '-'
                  )}
                </td>

                <td>
                  ${escapeHTML(
                    patient.noHP || '-'
                  )}
                </td>

                <td>
                  ${statusBadge(
                    patient.status
                  )}
                </td>

                <td>

                  <div class="action-group">

                    <button
                      class="btn btn-primary btn-small"
                      onclick="viewPatient('${escapeAttr(patient.pasienId)}')"
                    >
                      Detail
                    </button>

                    <button
                      class="btn btn-secondary btn-small"
                      onclick="editPatient('${escapeAttr(patient.pasienId)}')"
                    >
                      Edit
                    </button>

                    <button
                      class="btn ${patient.status === 'AKTIF'
                        ? 'btn-danger'
                        : 'btn-success'} btn-small"
                      onclick="togglePatientStatus(
                        '${escapeAttr(patient.pasienId)}',
                        '${escapeAttr(patient.status)}'
                      )"
                    >
                      ${patient.status === 'AKTIF'
                        ? 'Nonaktifkan'
                        : 'Aktifkan'}
                    </button>

                  </div>

                </td>

              </tr>

            `;

          }).join('')}

        </tbody>

      </table>

    </div>

  `;
}


