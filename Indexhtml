/* ============================================================
 * PILIH OBAT
 * ============================================================ */

function selectPrescriptionMedicine(
  itemId,
  obatId
) {

  const item =
    prescriptionItems.find(
      function(row) {
        return row.itemId === itemId;
      }
    );


  if (!item) {
    return;
  }


  if (!obatId) {

    item.obatId = '';
    item.kodeObat = '';
    item.namaObat = '';
    item.satuan = '';
    item.harga = 0;
    item.stok = 0;

    renderPrescriptionMedicineList();

    return;

  }


  google.script.run

    .withSuccessHandler(
      function(result) {

        const data =
          result &&
          Array.isArray(result.data)
            ? result.data
            : [];


        const obat =
          data.find(
            function(row) {

              return (
                String(
                  row.obatId
                ) ===
                String(
                  obatId
                )
              );

            }
          );


        if (!obat) {

          showToast(
            'Data obat tidak ditemukan.'
          );

          return;

        }


        item.obatId =
          obat.obatId;

        item.kodeObat =
          obat.kodeObat;

        item.namaObat =
          obat.namaObat;

        item.satuan =
          obat.satuan;

        item.harga =
          Number(
            obat.harga || 0
          );

        item.stok =
          Number(
            obat.stok || 0
          );


        /*
         * Jangan render seluruh form.
         *
         * Cukup perbarui informasi stok.
         */

        const stockElement =
          document.getElementById(
            'medicineStock_' +
            item.itemId
          );


        if (stockElement) {

          stockElement.innerHTML = `

            Stok tersedia:
            <strong>
              ${formatNumber(
                item.stok
              )}
            </strong>
            ${escapeHTML(
              item.satuan || ''
            )}

            &nbsp; | &nbsp;

            Harga:
            <strong>
              ${formatRupiah(
                item.harga
              )}
            </strong>

          `;

        }


        /*
         * Perbarui subtotal
         */

        const quantityElement =
          document.getElementById(
            'medicineQty_' +
            item.itemId
          );


        if (quantityElement) {

          quantityElement.value =
            item.jumlah || 1;

        }

      }
    )

    .withFailureHandler(
      handleServerError
    )

    .getMedicinesForPrescription(
      sessionToken,
      ''
    );

}


/* ============================================================
 * UPDATE FIELD OBAT
 * ============================================================ */

function updatePrescriptionItemField(
  itemId,
  field,
  value
) {

  const item =
    prescriptionItems.find(
      function(row) {

        return (
          row.itemId ===
          itemId
        );

      }
    );


  if (!item) {
    return;
  }


  if (
    field === 'jumlah'
  ) {

    item.jumlah =
      Math.max(
        1,
        Number(
          value || 1
        )
      );

  } else {

    item[field] =
      String(
        value || ''
      );

  }


  /*
   * Jangan render ulang di sini.
   * Agar fokus input tidak hilang.
   */

}


/* ============================================================
 * HAPUS OBAT
 * ============================================================ */

function removePrescriptionMedicine(
  itemId
) {

  prescriptionItems =
    prescriptionItems.filter(
      function(item) {

        return (
          item.itemId !==
          itemId
        );

      }
    );


  renderPrescriptionMedicineList();

}


/* ============================================================
 * SIMPAN RESEP
 * ============================================================ */

function savePrescriptionForm() {

  const kunjunganId =
    document.getElementById(
      'prescriptionVisitId'
    );


  const noRM =
    document.getElementById(
      'prescriptionNoRM'
    );


  const doctor =
    document.getElementById(
      'prescriptionDoctor'
    );


  const note =
    document.getElementById(
      'prescriptionNote'
    );


  if (
    !kunjunganId ||
    !kunjunganId.value
  ) {

    showToast(
      'Silakan pilih kunjungan terlebih dahulu.'
    );

    return;

  }


  if (
    prescriptionItems.length === 0
  ) {

    showToast(
      'Silakan tambahkan minimal satu obat.'
    );

    return;

  }


  /*
   * Pastikan semua item memiliki obat.
   */

  for (
    let i = 0;
    i < prescriptionItems.length;
    i++
  ) {

    const item =
      prescriptionItems[i];


    if (!item.obatId) {

      showToast(
        'Obat pada baris ' +
        (i + 1) +
        ' belum dipilih.'
      );

      return;

    }


    const jumlah =
      Number(
        item.jumlah || 0
      );


    if (
      jumlah <= 0
    ) {

      showToast(
        'Jumlah obat pada baris ' +
        (i + 1) +
        ' tidak valid.'
      );

      return;

    }


    if (
      item.stok &&
      jumlah > item.stok
    ) {

      showToast(
        'Jumlah ' +
        item.namaObat +
        ' melebihi stok tersedia.'
      );

      return;

    }

  }


  const data = {

    kunjunganId:
      kunjunganId.value,

    pasienId:
      '',

    noRM:
      noRM
        ? noRM.value
        : '',

    dokterBidan:
      doctor
        ? doctor.value
        : '',

    catatan:
      note
        ? note.value
        : '',

    details:
      prescriptionItems.map(
