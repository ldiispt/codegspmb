              <th>No</th>
              <th>No. RM</th>
              <th>Pasien</th>
              <th>Status</th>
            </tr>

          </thead>

          <tbody>

            ${data.queue.map(function(item) {

              return `

                <tr>

                  <td>
                    <strong>
                      ${escapeHTML(item.nomor)}
                    </strong>
                  </td>

                  <td>
                    ${escapeHTML(item.noRM)}
                  </td>

                  <td>
                    ${escapeHTML(item.nama)}
                  </td>

                  <td>
                    ${escapeHTML(item.status)}
                  </td>

                </tr>

              `;

            }).join('')}

          </tbody>

        </table>

      </div>

    `;
  }


  let latestHTML = '';

  if (
    !data.latestPatients ||
    data.latestPatients.length === 0
  ) {

    latestHTML = `

      <div class="empty">

        <div class="empty-icon">
          👥
        </div>

        <div>
          Belum ada data pasien.
        </div>

      </div>

    `;

  } else {

    latestHTML = `

      <div class="table-wrap">

        <table>

          <thead>

            <tr>
              <th>No. RM</th>
              <th>Nama</th>
              <th>Jenis Kelamin</th>
              <th>Status</th>
            </tr>

          </thead>

          <tbody>

            ${data.latestPatients.map(function(item) {

              return `

                <tr>

                  <td class="rm">
                    ${escapeHTML(item.noRM)}
                  </td>

                  <td class="patient-name">
                    ${escapeHTML(item.nama)}
                  </td>

                  <td>
                    ${escapeHTML(item.jenisKelamin || '-')}
                  </td>

                  <td>
                    ${statusBadge(item.status)}
                  </td>

                </tr>

              `;

            }).join('')}

          </tbody>

        </table>

      </div>

    `;
  }


  document.getElementById(
    'content'
  ).innerHTML = `

    <div class="welcome">

      <h2>
        Selamat datang,
        ${escapeHTML(
          currentUser.name ||
          currentUser.username
        )}
      </h2>

      <p>
        ${dateText}
        ·
        ${escapeHTML(
          currentUser.role || ''
        )}
      </p>

    </div>


    <div class="stats-grid">

      <div class="stat-card">

        <div class="stat-icon">
          👥
        </div>

        <div class="stat-label">
          Total Pasien
        </div>

        <div class="stat-value">
          ${formatNumber(
            stats.totalPatients || 0
          )}
        </div>

      </div>


      <div class="stat-card">

        <div class="stat-icon">
          🆕
        </div>

        <div class="stat-label">
          Pasien Baru Hari Ini
        </div>

        <div class="stat-value">
          ${formatNumber(
            stats.newPatientsToday || 0
          )}
        </div>

      </div>


      <div class="stat-card">

        <div class="stat-icon">
          🩺
        </div>

        <div class="stat-label">
          Kunjungan Hari Ini
        </div>

        <div class="stat-value">
          ${formatNumber(
            stats.todayVisits || 0
          )}
        </div>

      </div>


      <div class="stat-card">

        <div class="stat-icon">
          💰
        </div>

        <div class="stat-label">
          Pendapatan Hari Ini
        </div>

        <div class="stat-value">
          ${formatRupiah(
            stats.revenueToday || 0
          )}
        </div>

      </div>

    </div>


    <div class="card">

      <div class="card-title">
        🔢 Antrian Hari Ini
      </div>

      ${queueHTML}

    </div>


    <div class="card">

      <div class="card-title">
        👥 Pasien Terbaru
      </div>

      ${latestHTML}

    </div>

  `;
}


