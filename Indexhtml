}


/* =====================================================
   DASHBOARD
   ===================================================== */

function loadDashboard() {

  showLoading(
    'Memuat dashboard...'
  );

  google.script.run

    .withSuccessHandler(function(data) {

      hideLoading();

      renderDashboard(data);

    })

    .withFailureHandler(function(error) {

      hideLoading();

      handleServerError(error);

    })

    .getDashboardData(
      sessionToken
    );
}


function renderDashboard(data) {

  const stats =
    data.stats || {};

  const today =
    new Date();

  const dateText =
    today.toLocaleDateString(
      'id-ID',
      {
        weekday: 'long',
        day: '2-digit',
        month: 'long',
        year: 'numeric'
