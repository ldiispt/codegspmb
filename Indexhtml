const originalShowPage =
  showPage;

showPage = function(
  page,
  element
) {

  currentPage = page;

  document
    .querySelectorAll('.menu-item')
    .forEach(function(item) {
      item.classList.remove(
        'active'
      );
    });

  if (element) {
    element.classList.add(
      'active'
    );
  }


  if (page === 'dashboard') {

    document.getElementById(
      'topbarTitle'
    ).textContent =
      'Dashboard';

    loadDashboard();

    return;
  }


  if (page === 'pasien') {

    document.getElementById(
      'topbarTitle'
    ).textContent =
      'Data Pasien';

    loadPatientPage();

    return;
  }


  if (page === 'pendaftaran') {

    loadRegistrationPage();

    return;
  }


  if (page === 'antrian') {

    loadQueuePage();

    return;
  }

  if (page === 'pemeriksaan') {
  loadExaminationPage();
   }

};

