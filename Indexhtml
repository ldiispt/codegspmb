function renderFinancialTransactionDetailError(
  message
) {

  const container =
    document.getElementById(
      'financialTransactionDetailContent'
    );


  if (!container) {

    return;

  }


  container.innerHTML = `

    <div
      class="financial-report-error"
    >

      ⚠️
      ${escapeFinancialHtml(
        message
      )}

    </div>

  `;

/* =====================================================
   EVENT TOMBOL KWITANSI
   ===================================================== */

const receiptButtons =
  container.querySelectorAll(
    '.financial-payment-receipt-button'
  );


receiptButtons.forEach(
  function(button) {

    button.addEventListener(
      'click',
      function() {

        const index =
          Number(
            button.getAttribute(
              'data-payment-index'
            )
          );


        if (
          !isFinite(index) ||
          !window.financialPaymentHistoryRows ||
          !window.financialPaymentHistoryRows[index]
        ) {

          alert(
            'Data pembayaran tidak ditemukan.'
          );

          return;

        }


        printFinancialPaymentReceipt(
          window.financialPaymentHistoryRows[index]
        );

      }
    );

  }
);

}


