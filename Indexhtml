/* =====================================================
   UPDATE QUEUE
   ===================================================== */

function updateQueue(
  antrianId,
  status
) {

  let message =
    'Ubah status antrian?';

  if (status === 'BATAL') {
    message =
      'Batalkan antrian ini?';
  }

  if (status === 'DIPANGGIL') {
    message =
      'Panggil pasien ini?';
  }

  if (status === 'DILAYANI') {
    message =
      'Mulai pelayanan pasien ini?';
  }

  if (status === 'SELESAI') {
    message =
      'Tandai pelayanan selesai?';
  }

  if (!confirm(message)) {
    return;
  }

  showLoading(
    'Memperbarui antrian...'
  );

  google.script.run

    .withSuccessHandler(function() {

      hideLoading();

      showToast(
        'Status antrian berhasil diperbarui.'
      );

      loadQueuePage();

    })

    .withFailureHandler(function(error) {

      hideLoading();

      handleServerError(error);

    })

    .updateQueueStatus(
      sessionToken,
      antrianId,
      status
    );
}


/* =====================================================
   CALL NEXT
   ===================================================== */

function callNextPatient() {

  showLoading(
    'Mencari pasien berikutnya...'
  );

  google.script.run

    .withSuccessHandler(function(result) {

      hideLoading();

      if (!result.success) {

        showToast(
          result.message
        );

        return;
      }

      showToast(
        'Nomor ' +
        result.nomorAntrian +
        ' dipanggil.'
      );

      loadQueuePage();

    })

    .withFailureHandler(function(error) {

      hideLoading();

      handleServerError(error);

    })

    .callNextQueue(
      sessionToken
    );
}


