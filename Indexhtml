function filterMedicalPatients() {
  const q = String(document.getElementById('medicalPatientSearch')?.value || '').trim().toLowerCase();
  const data = window.medicalPatientData || [];
  if (!q) return renderMedicalPatientTable(data);
  renderMedicalPatientTable(data.filter(function(p) {
    return [p.noRM, p.nik, p.nama, p.noHP].join(' ').toLowerCase().indexOf(q) !== -1;
  }));
}

function renderMedicalPatientTable(data) {
  const box = document.getElementById('medicalPatientTable');
  if (!box) return;

  if (!data.length) {
    box.innerHTML = `<div class="empty"><div class="empty-icon">🔎</div>Pasien tidak ditemukan.</div>`;
    return;
  }

  box.innerHTML = `
