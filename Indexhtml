function savePaymentUI(
  kunjunganId,
  sisaTagihan
) {

  kunjunganId =
    String(
      kunjunganId || ''
    ).trim();


  if (!kunjunganId) {

    alert(
      'Kunjungan tidak ditemukan.'
    );

    return;

  }


  const methodElement =
    document.getElementById(
      'paymentMethod'
    );


  const amountElement =
    document.getElementById(
      'paymentAmount'
    );


  const messageElement =
    document.getElementById(
      'paymentFormMessage'
    );


  const metodeBayar =
    methodElement
      ? String(
          methodElement.value || ''
        ).trim().toUpperCase()
      : '';


  const jumlahBayar =
    amountElement
      ? Number(
          amountElement.value || 0
        )
      : 0;


  const sisa =
    Number(
      sisaTagihan || 0
    );


  if (!metodeBayar) {

    if (messageElement) {

      messageElement.innerHTML = `
        <div style="
          padding:10px;
          margin-top:10px;
          border-radius:8px;
          background:#fef2f2;
          color:#b91c1c;
        ">
          Silakan pilih metode pembayaran.
        </div>
      `;

    }

    return;

  }


  if (
    !isFinite(jumlahBayar) ||
    jumlahBayar <= 0
  ) {

    if (messageElement) {

      messageElement.innerHTML = `
        <div style="
          padding:10px;
          margin-top:10px;
          border-radius:8px;
          background:#fef2f2;
          color:#b91c1c;
        ">
          Jumlah pembayaran harus lebih dari 0.
        </div>
      `;

    }

    return;

  }


  /*
   * Hitung kembalian di frontend.
   */
  let kembalian = 0;


  if (
    metodeBayar === 'TUNAI' &&
    jumlahBayar > sisa
  ) {

    kembalian =
      jumlahBayar -
      sisa;

  }


  /*
   * Non-tunai tidak boleh
   * melebihi sisa tagihan.
   */
  if (
    metodeBayar !== 'TUNAI' &&
    jumlahBayar > sisa
  ) {

    if (messageElement) {

      messageElement.innerHTML = `
        <div style="
          padding:10px;
          margin-top:10px;
          border-radius:8px;
          background:#fef2f2;
          color:#b91c1c;
        ">
          Pembayaran non-tunai tidak boleh
          melebihi sisa tagihan.
        </div>
      `;

    }

    return;

  }


  /*
   * Tampilkan proses.
   */
  if (messageElement) {

    messageElement.innerHTML = `
      <div style="
        padding:10px;
        margin-top:10px;
        border-radius:8px;
        background:#f8fafc;
        color:#475569;
      ">
        Menyimpan pembayaran...
      </div>
    `;

  }


  const buttons =
    document.querySelectorAll(
      '#paymentFormContent button'
    );


  buttons.forEach(
    function(button) {

      if (
        button.textContent
          .includes(
            'Simpan Pembayaran'
          )
      ) {

        button.disabled = true;

        button.style.opacity =
          '0.6';

        button.style.cursor =
          'not-allowed';

      }

    }
  );


  const payload = {

    kunjunganId:
      kunjunganId,

    metodeBayar:
      metodeBayar,

    jumlahBayar:
      jumlahBayar,

    kembalian:
      kembalian,

    tanggal:
      new Date().toISOString(),

    referensi:
      '',

    catatan:
      ''

  };


  google.script.run

    .withSuccessHandler(
      function(result) {

        if (
          !result ||
          result.success !== true
        ) {

          if (messageElement) {

            messageElement.innerHTML = `
              <div style="
                padding:10px;
                margin-top:10px;
                border-radius:8px;
                background:#fef2f2;
                color:#b91c1c;
              ">
                Pembayaran gagal disimpan.
              </div>
            `;

          }

          return;

        }


        /*
         * Pembayaran berhasil.
         */
        if (messageElement) {

          messageElement.innerHTML = `
            <div style="
              padding:10px;
              margin-top:10px;
              border-radius:8px;
              background:#f0fdf4;
              color:#166534;
            ">
              Pembayaran berhasil disimpan.
            </div>
          `;

        }


        /*
         * Kembali ke halaman pembayaran
         * setelah sebentar.
         */
        setTimeout(
          function() {

            loadPaymentPage();

          },
          800
        );

      }
    )

    .withFailureHandler(
      function(error) {

        const message =
          error &&
          error.message
            ? error.message
            : 'Terjadi kesalahan saat menyimpan pembayaran.';


        if (messageElement) {

          messageElement.innerHTML = `
            <div style="
              padding:10px;
              margin-top:10px;
              border-radius:8px;
              background:#fef2f2;
              color:#b91c1c;
            ">
              ${escapePaymentValue(
                message
              )}
            </div>
          `;

        }


        /*
         * Aktifkan kembali tombol.
         */
        buttons.forEach(
          function(button) {

            if (
              button.textContent
                .includes(
                  'Simpan Pembayaran'
                )
            ) {

              button.disabled =
                false;

              button.style.opacity =
                '';

              button.style.cursor =
                'pointer';

            }

          }
        );

      }
