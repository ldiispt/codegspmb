   ===================================================== */

function savePatient() {

  const nama =
    document.getElementById(
      'patientNama'
    ).value.trim();

  const nik =
    document.getElementById(
      'patientNik'
    ).value
      .replace(/\D/g, '');

  if (!nama) {

    showToast(
      'Nama lengkap wajib diisi.'
    );

    return;
  }

  if (
    nik &&
    nik.length !== 16
  ) {

    showToast(
      'NIK harus terdiri dari 16 digit.'
    );

    return;
  }


  const data = {

    nama: nama,

    nik: nik,

    tempatLahir:
      document.getElementById(
        'patientTempatLahir'
      ).value.trim(),

    tanggalLahir:
      document.getElementById(
        'patientTanggalLahir'
      ).value,

    jenisKelamin:
      document.getElementById(
        'patientJenisKelamin'
      ).value,

    noHP:
      document.getElementById(
        'patientNoHP'
      ).value.trim(),

    namaSuami:
      document.getElementById(
        'patientNamaSuami'
      ).value.trim(),

    golonganDarah:
      document.getElementById(
        'patientGolonganDarah'
      ).value,

    alamat:
      document.getElementById(
        'patientAlamat'
      ).value.trim(),

    catatan:
      document.getElementById(
        'patientCatatan'
      ).value.trim()

  };


  const pasienId =
    document.getElementById(
      'patientId'
    ).value;


  showLoading(
    pasienId
      ? 'Menyimpan perubahan...'
      : 'Mendaftarkan pasien...'
  );


  const runner =
    google.script.run

      .withSuccessHandler(function(result) {

        hideLoading();

        closePatientModal();

        showToast(
          result.message ||
          'Data pasien berhasil disimpan.'
        );

        loadPatientPage();

      })

      .withFailureHandler(function(error) {

        hideLoading();

        handleServerError(error);

      });


  if (pasienId) {

    runner.updatePatient(
      sessionToken,
      pasienId,
      data
    );

  } else {

    runner.addPatient(
      sessionToken,
      data
    );
  }
}


