/* =====================================================
   UPDATE QUEUE
   ===================================================== */

function updateQueue(
  antrianId,
  status
) {

  let message =
    'Ubah status antrian?';

  if (status === 'BATAL') {
    message =
      'Batalkan antrian ini?';
  }

  if (status === 'DIPANGGIL') {
    message =
      'Panggil pasien ini?';
  }

  if (status === 'DILAYANI') {
    message =
      'Mulai pelayanan pasien ini?';
  }

  if (status === 'SELESAI') {
    message =
      'Tandai pelayanan selesai?';
  }

  if (!confirm(message)) {
    return;
  }

  showLoading(
    'Memperbarui antrian...'
  );

  google.script.run

    .withSuccessHandler(function() {

      hideLoading();

      showToast(
        'Status antrian berhasil diperbarui.'
      );

      loadQueuePage();

    })

    .withFailureHandler(function(error) {

      hideLoading();

      handleServerError(error);

    })

    .updateQueueStatus(
      sessionToken,
      antrianId,
      status
    );
}


