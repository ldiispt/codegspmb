function selectRegistrationPatient(
  pasienId
) {

  const normalizedId =
    String(pasienId || '').trim();

  if (!normalizedId) {
    showToast('ID Pasien tidak valid.');
    return;
  }

  selectedRegistrationPatientId =
    normalizedId;

  document.getElementById(
    'registrationPatientId'
  ).value =
    normalizedId;

  google.script.run
    .withSuccessHandler(function(patient) {
      const selected = patient || {};
      const confirmedId =
        getRegistrationPatientId(selected) ||
        normalizedId;

      selectedRegistrationPatientId = confirmedId;
      document.getElementById(
        'registrationPatientId'
      ).value = confirmedId;

      document.getElementById(
        'selectedPatientName'
      ).textContent = selected.nama || '';

      document.getElementById(
        'selectedPatientInfo'
      ).textContent =
        (selected.noRM || '-') + ' · ' +
        (selected.nik || 'NIK belum diisi') + ' · ' +
        (selected.noHP || 'HP belum diisi');

      document.getElementById(
        'selectedPatientBox'
      ).style.display = 'block';

      document.getElementById(
        'selectedPatientBox'
      ).setAttribute('data-pasien-id', confirmedId);

      document.getElementById(
        'registrationPatientResults'
      ).innerHTML = '';

      document.getElementById(
        'registrationSearch'
      ).value = selected.nama || '';
    })
    .withFailureHandler(function(error) {
      console.error(error);
      handleServerError(error);
    })
    .getPatientForRegistration(
      sessionToken,
      normalizedId
    );
}


/* =====================================================
   SUBMIT PENDAFTARAN
   ===================================================== */

function submitRegistration() {

  console.log(
    'submitRegistration dipanggil'
  );

  // Sumber utama: state JavaScript.
  // Fallback: hidden input dan data pada kotak pasien.
  let pasienId =
    String(
      selectedRegistrationPatientId ||
      document.getElementById(
        'registrationPatientId'
      ).value ||
      ''
    ).trim();

  if (!pasienId) {

    const selectedBox =
      document.getElementById(
        'selectedPatientBox'
      );

    if (selectedBox) {
      pasienId =
        String(
          selectedBox.getAttribute(
            'data-pasien-id'
          ) || ''
        ).trim();
    }
  }

  const jenisPelayanan =
    document.getElementById(
      'registrationService'
    ).value;

  const keluhan =
    document.getElementById(
      'registrationComplaint'
    ).value.trim();

  console.log(
    'pasienId yang akan dikirim:',
    pasienId
  );

  if (!pasienId) {

    showToast(
      'Silakan pilih pasien terlebih dahulu.'
    );

    return;
  }

  // Sinkronkan kembali ID pasien.
  selectedRegistrationPatientId =
    pasienId;

  document.getElementById(
    'registrationPatientId'
  ).value =
    pasienId;

  if (!jenisPelayanan) {

    showToast(
      'Silakan pilih jenis pelayanan.'
    );

    return;
  }

  const submitButton =
    document.querySelector(
      '#registrationModal .modal-footer .btn-primary'
    );

  if (submitButton) {
    submitButton.disabled = true;
    submitButton.textContent =
      '⏳ Mendaftarkan...';
  }

  showLoading(
    'Mendaftarkan pasien...'
  );

  google.script.run

    .withSuccessHandler(function(result) {

      hideLoading();

      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent =
          '📝 Daftarkan Kunjungan';
      }

      closeRegistrationModal();

      selectedRegistrationPatientId = '';

      const patientIdInput =
        document.getElementById(
          'registrationPatientId'
        );

      if (patientIdInput) {
        patientIdInput.value = '';
      }

      showQueueSuccess(
        result
      );

      if (
        currentPage === 'pendaftaran'
      ) {
        loadRegistrationPage();
      }

    })

    .withFailureHandler(function(error) {

      hideLoading();

      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent =
          '📝 Daftarkan Kunjungan';
      }

      handleServerError(error);

    })

    .registerVisit(
      sessionToken,
      {
        pasienId:
          pasienId,

        jenisPelayanan:
          jenisPelayanan,

        keluhan:
          keluhan
      }
    );
}


