/* ============================================================
 * RENDER ITEMS
 * ============================================================ */
function renderTransactionItems() {

  const container =
    document.getElementById(
      'transactionItemsContainer'
    );


  if (!container) {
    return;
  }


  container.innerHTML =
    transactionItems.map(
      function(item, index) {

        return `

          <div
