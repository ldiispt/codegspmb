/**
 * ============================================================
 * SIMPAN FORM OBAT
 * ============================================================
 */
function saveMedicineForm(
  event
) {

  event.preventDefault();


  const data = {

    obatId:
      document.getElementById(
        'medicineId'
      ).value,

    kodeObat:
      document.getElementById(
        'medicineCode'
      ).value,

    namaObat:
      document.getElementById(
        'medicineName'
      ).value,

    kandungan:
      document.getElementById(
        'medicineContent'
      ).value,

    satuan:
      document.getElementById(
        'medicineUnit'
      ).value,

    hargaBeli:
      document.getElementById(
        'medicinePurchasePrice'
      ).value,

    hargaJual:
      document.getElementById(
        'medicineSellingPrice'
      ).value,

    stok:
      document.getElementById(
        'medicineStock'
      ).value,

    stokMinimum:
      document.getElementById(
        'medicineMinimumStock'
      ).value,

    lokasi:
      document.getElementById(
        'medicineLocation'
      ).value,

    status:
      document.getElementById(
        'medicineStatus'
      ).value,

    keterangan:
      document.getElementById(
        'medicineNote'
      ).value

  };


  showLoading(
    'Menyimpan data obat...'
  );


  google.script.run

    .withSuccessHandler(
      function(result) {

        hideLoading();

        closeMedicineModal();

        showToast(
          result &&
          result.message
            ? result.message
            : 'Data obat berhasil disimpan.'
        );

        loadMedicines();

      }
    )

    .withFailureHandler(
      function(error) {

        hideLoading();

        handleServerError(
          error
        );

      }
    )

    .saveMedicine(
      sessionToken,
      data
    );

}


