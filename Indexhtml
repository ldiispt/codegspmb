function printFinancialPaymentReceipt(payment) {

  if (!payment) {

    alert(
      'Data pembayaran tidak ditemukan.'
    );

    return;

  }


  /* =====================================================
     AMBIL DATA TRANSAKSI DARI MODAL DETAIL
