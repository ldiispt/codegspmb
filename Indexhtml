  );
}


function handleServerError(
  error
) {

  console.error(error);

  const message =
    error &&
    error.message
      ? error.message
      : 'Terjadi kesalahan pada server.';

  if (
    message.toLowerCase()
      .includes('session')
  ) {

    clearSession();

    showLogin();

    showLoginError(
      'Session telah berakhir. Silakan login kembali.'
    );

    return;
  }

  showToast(message);
}


function formatNumber(
  number
) {

  return Number(
    number || 0
  ).toLocaleString(
    'id-ID'
  );
}


function formatRupiah(
  number
) {

  return 'Rp ' +
    Number(
      number || 0
    ).toLocaleString(
      'id-ID'
    );
}


function statusBadge(
  status
) {

  const value =
    String(status || '')
      .toUpperCase();

  if (value === 'AKTIF') {

    return `
      <span class="badge badge-active">
        AKTIF
      </span>
    `;

  }

  return `
    <span class="badge badge-inactive">
      NONAKTIF
    </span>
  `;
}


function detailItem(
  label,
  value
) {

  return `

    <div class="detail-item">

      <div class="detail-label">
        ${escapeHTML(label)}
      </div>

      <div class="detail-value">
        ${escapeHTML(value)}
      </div>

    </div>

  `;
}


/* =====================================================
   SECURITY / HTML ESCAPE
   ===================================================== */

function escapeHTML(
  value
) {

  return String(
    value === undefined ||
    value === null
      ? ''
      : value
  )
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}


function escapeAttr(
  value
) {

  return escapeHTML(value);
}

