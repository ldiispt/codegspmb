function loadMedicines() {

  const searchElement =
    document.getElementById(
      'medicineSearch'
    );

  const statusElement =
    document.getElementById(
      'medicineStatusFilter'
    );

  const search =
    searchElement
      ? searchElement.value
      : '';

  const status =
    statusElement
      ? statusElement.value
      : '';


  const container =
    document.getElementById(
      'medicineTableContainer'
    );

  if (!container) {
    return;
  }


  container.innerHTML = `

    <div class="loading-state">
      Memuat data obat...
    </div>

