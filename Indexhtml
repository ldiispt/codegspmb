function printFinancialPaymentReceipt(
  payment
) {

  if (!payment) {

    alert(
      'Data pembayaran tidak ditemukan.'
    );

    return;

  }


  function safeValue(value) {

    return escapeFinancialHtml(
      String(
        value === undefined ||
        value === null ||
        value === ''
          ? '-'
          : value
      )
    );

  }


  function currency(value) {

    const number =
      Number(value || 0);

    return (
      'Rp ' +
      number.toLocaleString(
        'id-ID'
      )
    );

  }


  let tanggal = '-';


  if (
    payment.tanggal
  ) {

    const d =
      new Date(
        payment.tanggal
      );


    if (
      !isNaN(
        d.getTime()
      )
    ) {

      tanggal =
        d.toLocaleDateString(
          'id-ID'
        ) +
        ' ' +
        d.toLocaleTimeString(
          'id-ID',
          {
            hour: '2-digit',
            minute: '2-digit'
          }
        );

    }

  }


  const jumlahBayar =
    Number(
      payment.jumlahBayar || 0
    );


  const kembalian =
    Number(
      payment.kembalian || 0
    );


  const jumlahEfektif =
    Number(
      payment.jumlahEfektif ||
      Math.max(
        0,
        jumlahBayar -
          kembalian
      )
    );


  /*
   * Ambil informasi transaksi dari
   * modal Detail Transaksi yang sedang terbuka.
   */

  const modal =
    document.getElementById(
      'financialTransactionDetailModal'
    );


  let transaksiId = '-';
  let noRM = '-';
  let kunjunganId = '-';


  if (modal) {

    const transactionIdElement =
      modal.querySelector(
        '.financial-transaction-modal-id'
      );


    if (
      transactionIdElement
    ) {

      transaksiId =
        transactionIdElement
          .textContent
          .trim() || '-';

    }


    const infoItems =
      modal.querySelectorAll(
        '.financial-transaction-info-grid > div'
      );


    infoItems.forEach(
      function(item) {

        const label =
          item.querySelector(
            'span'
          );

        const value =
          item.querySelector(
            'strong'
          );


        if (
          !label ||
          !value
        ) {
          return;
        }


        const labelText =
          label.textContent
            .trim()
            .toLowerCase();


        const valueText =
          value.textContent
            .trim();


        if (
          labelText ===
          'no. rm'
        ) {

          noRM =
            valueText || '-';

        }


        if (
          labelText ===
          'kunjungan'
        ) {

          kunjunganId =
            valueText || '-';

        }

      }
    );

  }


  /*
   * Gunakan ID pembayaran sebagai
   * nomor kwitansi.
   */

  const nomorKwitansi =
    payment.pembayaranId ||
    '-';


  const printWindow =
    window.open(
      '',
      '_blank',
      'width=800,height=900'
    );


  if (!printWindow) {

    alert(
      'Jendela cetak diblokir browser. Silakan izinkan pop-up untuk aplikasi ini.'
    );

    return;

  }


  printWindow.document.open();


