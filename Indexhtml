    );


  const catatan =
    String(
      payment.catatan ||
      '-'
    );


  /* =====================================================
     FORMAT
     ===================================================== */

  const rupiah =
    function(value) {

      return (
        'Rp ' +
        Number(
          value || 0
        ).toLocaleString(
          'id-ID'
        )
      );

    };


  const tanggalFormat =
    function(value) {

      if (!value) {

        return '-';

      }


      const date =
        new Date(value);


      if (
        isNaN(
          date.getTime()
        )
      ) {

        return String(value);

      }


      return date.toLocaleString(
        'id-ID',
        {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        }
      );

    };


  /* =====================================================
     ESCAPE HTML
     ===================================================== */

  const safe =
    function(value) {

      return String(
        value == null
          ? ''
          : value
      )
        .replace(
          /&/g,
          '&amp;'
        )
        .replace(
          /</g,
          '&lt;'
        )
        .replace(
          />/g,
          '&gt;'
        )
        .replace(
          /"/g,
          '&quot;'
        )
        .replace(
          /'/g,
          '&#039;'
        );

    };


  /* =====================================================
