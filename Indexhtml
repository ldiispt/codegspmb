    );

  let queueHTML = '';

  if (
    !data.queue ||
    data.queue.length === 0
  ) {

    queueHTML = `

      <div class="empty">

        <div class="empty-icon">
          🔢
        </div>

        <div>
          Belum ada antrian hari ini.
        </div>

      </div>

    `;

  } else {

    queueHTML = `

