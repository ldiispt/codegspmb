function printFinancialPaymentReceiptByIndex(
  index
) {

  index =
    Number(index);


  if (
    !isFinite(index)
  ) {

    alert(
      'Data pembayaran tidak valid.'
    );

    return;

  }


  const rows =
    window.financialPaymentHistoryRows;


  if (
    !Array.isArray(rows) ||
    !rows[index]
  ) {

    alert(
      'Data pembayaran tidak ditemukan.'
    );

    return;

  }


  printFinancialPaymentReceipt(
    rows[index]
  );

}

