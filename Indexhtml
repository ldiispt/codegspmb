function getRegistrationPatientId(patient) {

  if (!patient || typeof patient !== 'object') {
    return '';
  }

  const candidates = [
    patient.pasienId,
    patient.id,
    patient.ID,
    patient.patientId,
    patient.patientID,
    patient.PASIEN_ID
  ];

  for (let i = 0; i < candidates.length; i++) {
    if (
      candidates[i] !== undefined &&
      candidates[i] !== null &&
      String(candidates[i]).trim() !== ''
    ) {
      return String(candidates[i]).trim();
    }
  }

  return '';
}


