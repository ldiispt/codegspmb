      <p><b>Diagnosis:</b><br>${escapeHTML(item.diagnosis || '-')}</p>
      <p><b>Tindakan:</b><br>${escapeHTML(item.tindakan || '-')}</p>
      <p><b>Catatan Bidan:</b><br>${escapeHTML(item.catatanBidan || '-')}</p>
    </div>`; }).join('');

  win.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Rekam Medis - ${escapeHTML(p.nama || '')}</title><style>body{font-family:Arial,sans-serif;color:#111;padding:30px;line-height:1.5}h1{font-size:20px;margin-bottom:4px}h2{font-size:15px;margin-top:25px}.meta{border:1px solid #ddd;padding:12px;border-radius:8px;margin:15px 0}.record{border:1px solid #ddd;padding:15px;margin:15px 0;border-radius:8px;page-break-inside:avoid}.record h3{font-size:14px;margin-top:0;color:#0f766e}p{font-size:12px;margin:7px 0}@media print{body{padding:10px}}</style></head><body><h1>PMB SETIAWATI</h1><div>Sistem Informasi Praktik Mandiri Bidan</div><h2>RIWAYAT REKAM MEDIS PASIEN</h2><div class="meta"><b>Nama:</b> ${escapeHTML(p.nama || '-')}<br><b>No. RM:</b> ${escapeHTML(p.noRM || '-')}<br><b>NIK:</b> ${escapeHTML(p.nik || '-')}<br><b>Tanggal Lahir:</b> ${escapeHTML(p.tanggalLahir || '-')}<br><b>Jenis Kelamin:</b> ${escapeHTML(p.jenisKelamin || '-')}</div>${rows || '<p>Belum ada rekam medis.</p>'}</body></html>`);
  win.document.close();
  win.focus();
  setTimeout(function(){ win.print(); }, 400);
}

/* Final navigation layer: mengaktifkan Pemeriksaan dan Rekam Medis. */
(function installFinalNavigation(){
  const old = window.showPage;
  window.showPage = function(page, element) {
    currentPage = page;
    document.querySelectorAll('.menu-item').forEach(function(item){ item.classList.remove('active'); });
    if (element) element.classList.add('active');

    if (page === 'dashboard') { document.getElementById('topbarTitle').textContent='Dashboard'; loadDashboard(); return; }
    if (page === 'pasien') { document.getElementById('topbarTitle').textContent='Data Pasien'; loadPatientPage(); return; }
    if (page === 'pendaftaran') { document.getElementById('topbarTitle').textContent='Pendaftaran'; loadRegistrationPage(); return; }
    if (page === 'antrian') { document.getElementById('topbarTitle').textContent='Antrian'; loadQueuePage(); return; }
    if (page === 'pemeriksaan') { document.getElementById('topbarTitle').textContent='Pemeriksaan'; loadExaminationPage(); return; }
    if (page === 'rekam-medis') { document.getElementById('topbarTitle').textContent='Rekam Medis'; loadMedicalRecordPage(); return; }
    placeholderPage(page);
  };
})();

