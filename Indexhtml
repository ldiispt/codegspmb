.financial-transaction-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 24px;

  box-sizing: border-box;
}


.financial-transaction-modal-overlay {
  position: absolute;
  inset: 0;

  background: rgba(15, 23, 42, 0.45);

  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
}


/* KONTTAINER UTAMA */

.financial-transaction-modal-box {
  position: relative;
  z-index: 2;

  width: min(900px, calc(100vw - 48px));

  max-width: 900px;

  max-height: calc(100vh - 48px);

  margin: auto;

  background: #ffffff;

  border-radius: 18px;

  box-shadow:
    0 20px 60px rgba(15, 23, 42, 0.25);

  overflow: hidden;

  display: flex;
  flex-direction: column;

  box-sizing: border-box;
}


/* HEADER */

.financial-transaction-modal-header {
  position: sticky;
  top: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 18px 22px;

  background: #ffffff;

  border-bottom: 1px solid #e5e7eb;

  flex-shrink: 0;
}


.financial-transaction-modal-id {
  margin-top: 4px;

  font-size: 12px;

  color: #64748b;
}


.financial-transaction-modal-close {
  width: 38px;
  height: 38px;

  border: none;
  border-radius: 10px;

  background: #f1f5f9;

  color: #475569;

  font-size: 18px;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;
}


.financial-transaction-modal-close:hover {
  background: #e2e8f0;
}


/* ISI KONTAINER */

.financial-transaction-modal-content {
  padding: 22px;

  overflow-y: auto;

  overflow-x: hidden;

  box-sizing: border-box;

  width: 100%;
}


/* INFORMASI TRANSAKSI */

.financial-transaction-info-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 12px;

  width: 100%;

  box-sizing: border-box;
}


.financial-transaction-info-grid > div {
  padding: 14px;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  border-radius: 10px;

  min-width: 0;

  box-sizing: border-box;
}


.financial-transaction-info-grid span {
  display: block;

  margin-bottom: 5px;

  font-size: 11px;

  color: #64748b;
}


.financial-transaction-info-grid strong {
  display: block;

  font-size: 14px;

  color: #0f172a;

  word-break: break-word;
}


/* KETERANGAN */

.financial-transaction-note {
  margin-top: 14px;

  padding: 14px;

  background: #fffbeb;

  border: 1px solid #fde68a;

  border-radius: 10px;

  color: #78350f;

  word-break: break-word;
}


/* DETAIL ITEM */

.financial-transaction-items {
  width: 100%;

  margin-top: 20px;

  min-width: 0;
}


.financial-transaction-items h3 {
  margin: 0 0 10px;

  font-size: 15px;

  color: #0f172a;
}


.financial-transaction-items-scroll {
  width: 100%;

  overflow-x: auto;

  border: 1px solid #e2e8f0;

  border-radius: 10px;

  box-sizing: border-box;
}


.financial-transaction-items table {
  width: 100%;

  min-width: 650px;

  border-collapse: collapse;
}


.financial-transaction-items th {
  padding: 10px;

  background: #f8fafc;

  border-bottom: 1px solid #e2e8f0;

  font-size: 12px;

  text-align: left;

  white-space: nowrap;
}


.financial-transaction-items td {
  padding: 10px;

  border-bottom: 1px solid #f1f5f9;

  font-size: 12px;

  color: #334155;
}


.financial-transaction-items tbody tr:last-child td {
  border-bottom: none;
}


/* TOTAL */

.financial-transaction-total {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-top: 18px;

  padding: 16px 18px;

  background: #f0fdf4;

  border: 1px solid #bbf7d0;

  border-radius: 12px;

