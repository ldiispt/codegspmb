/**
 * ============================================================
 * MENGAMBIL DATABASE
 * ============================================================
 */

function getDatabase() {

  /*
   * Jika ID sudah diisi, gunakan ID tersebut.
   */

  const spreadsheetId =
    String(
      PMB_CONFIG.DATABASE_SPREADSHEET_ID || ''
    ).trim();


  if (
    spreadsheetId &&
    spreadsheetId !==
      'MASUKKAN_ID_SPREADSHEET_DI_SINI'
  ) {

    try {

      return SpreadsheetApp
        .openById(spreadsheetId);

    } catch (error) {

      throw new Error(
        'Google Spreadsheet database tidak dapat dibuka.\n\n' +
        'Pastikan DATABASE_SPREADSHEET_ID benar dan ' +
        'akun Apps Script memiliki akses ke Spreadsheet tersebut.\n\n' +
        'Detail: ' +
        error.message
      );

    }

  }


  /*
   * Fallback:
   * jika Apps Script memang terikat langsung
   * dengan Google Spreadsheet.
   */

  const active =
    SpreadsheetApp.getActiveSpreadsheet();


  if (active) {

    return active;

  }


  throw new Error(
    'Spreadsheet database belum ditentukan.\n\n' +
    'Silakan isi DATABASE_SPREADSHEET_ID di Config.gs ' +
    'dengan ID Google Spreadsheet database PMB SETIAWATI.'
  );

}


/**
 * ============================================================
 * TIMEZONE
 * ============================================================
 */

function getAppTimezone() {

  return PMB_CONFIG.TIMEZONE;

}


/**
 * ============================================================
 * FORMAT TANGGAL DAN WAKTU
 * ============================================================
 */

function formatDateTime(date) {

  if (!date) {

    date = new Date();

  }


  return Utilities.formatDate(

    date,

    PMB_CONFIG.TIMEZONE,

    'dd/MM/yyyy HH:mm:ss'

  );

}


/**
 * ============================================================
 * FORMAT TANGGAL
 * ============================================================
 */

function formatDate(date) {

  if (!date) {

    date = new Date();

  }


  return Utilities.formatDate(

    date,

    PMB_CONFIG.TIMEZONE,

    'dd/MM/yyyy'

  );

}


/**
